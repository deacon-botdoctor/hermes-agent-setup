@@ -0,0 +1,130 @@
+"""Native approval lifecycle behavior; no SDK login or live gateway is required."""
+import ast
+import logging
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+import pytest
+
+ROOT=Path(__file__).resolve().parents[2]
+
+
+def native_method(path,owner,name,**namespace):
+    """Execute the exact native method when an optional SDK is unavailable."""
+    tree=ast.parse((ROOT/path).read_text())
+    cls=next(n for n in ast.walk(tree) if isinstance(n,ast.ClassDef) and n.name==owner)
+    method=next(n for n in cls.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)) and n.name==name)
+    module=ast.Module(body=[ast.ImportFrom(module='__future__',names=[ast.alias(name='annotations')],level=0),method],type_ignores=[])
+    ns={'logger':logging.getLogger(__name__),**namespace}
+    exec(compile(ast.fix_missing_locations(module),str(ROOT/path),'exec'),ns)
+    return ns[name]
+
+
+@pytest.mark.asyncio
+async def test_matrix_expiry_removes_state_and_controls_without_notice():
+    method=native_method('plugins/platforms/matrix/adapter.py','MatrixAdapter','_expire_matrix_approval_prompt')
+    prompt=SimpleNamespace(session_key='session',resolved=False)
+    adapter=SimpleNamespace(_approval_prompts_by_event={'event':prompt},_approval_prompt_by_session={'session':prompt},
+        _redact_bot_approval_reactions=AsyncMock(),_send_invalid_reaction_feedback=AsyncMock())
+    await method(adapter,'room','event',prompt)
+    assert prompt.resolved
+    assert not adapter._approval_prompts_by_event and not adapter._approval_prompt_by_session
+    adapter._redact_bot_approval_reactions.assert_awaited_once_with('room',prompt)
+    adapter._send_invalid_reaction_feedback.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_teams_stale_callback_keeps_authorization_and_resolver_boundary(monkeypatch):
+    import tools.approval as approval
+    method=native_method('plugins/platforms/teams/adapter.py','TeamsAdapter','_on_card_action',_APPROVAL_CHOICES={'approve':'once'})
+    resolve=MagicMock();monkeypatch.setattr(approval,'resolve_gateway_approval',resolve)
+    monkeypatch.setattr(approval,'has_blocking_approval',lambda key:False)
+    adapter=SimpleNamespace(_card_action_denied=MagicMock(return_value=None),_invoke_message=lambda value:dict(status=200,value=value),_invoke_card=MagicMock())
+    ctx=SimpleNamespace(activity=SimpleNamespace(value=SimpleNamespace(action=SimpleNamespace(data={'hermes_action':'approve','session_key':'session'})),from_=SimpleNamespace()))
+    assert await method(adapter,ctx)=={'status':200,'value':''}
+    adapter._card_action_denied.assert_called_once();resolve.assert_not_called();adapter._invoke_card.assert_not_called()
+    adapter._card_action_denied.return_value='denied'
+    assert (await method(adapter,ctx))['value']=='denied'
+
+
+@pytest.mark.asyncio
+async def test_stale_slash_approval_is_consumed_without_resolving(monkeypatch):
+    import tools.approval as approval
+    from gateway.slash_commands import GatewaySlashCommandsMixin
+    adapter=GatewaySlashCommandsMixin()
+    adapter._pending_approvals={'session':object()}
+    adapter._session_key_for_source=lambda source:'session'
+    monkeypatch.setattr(approval,'has_blocking_approval',lambda key:False)
