+    d=s._RunDelivery(job={'id':'job','name':'Report','deliver':'local'},success=False,error=op._CronOperatorFailure('bad','script'))
+    s._save_compose_deliver(d,fence,'','receipt',adapters=None,loop=None,verbose=False,execution_token=None)
+    repair.assert_not_called();assert not sent
