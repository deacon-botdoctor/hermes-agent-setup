+def test_repair_circuit_and_cancellation_identity(tmp_path,monkeypatch):
+    monkeypatch.setenv('HERMES_HOME',str(tmp_path))
+    receipt=tmp_path/'receipt';receipt.write_text('private original receipt')
+    cancel=threading.Event();agents=[];calls=[]
+    def execute(job,**kw):
+        calls.append((job,kw));return False,'repair receipt','', 'failed'
+    monkeypatch.setattr(op,'run_job',execute)
+    job={'id':'job','name':'Report','script':'x.py','provider':'original','enabled_toolsets':['terminal']}
+    for attempt in range(2):op._attempt_cron_failure_remediation(job,failure_kind='script',output_file=receipt,deferred_agents=agents,cancel_event=cancel,execution_id='execution',failure_detail=f'request id={attempt}')
+    assert len(calls)==1
+    repair,kw=calls[0]
+    assert repair['_cron_repair_attempt'] and repair['max_iterations']==10
+    assert not repair['script'] and repair['deliver']=='local'
+    assert repair['enabled_toolsets']==['terminal']
+    assert kw['cancel_event'] is cancel and kw['execution_id']=='execution'
+    assert kw['defer_agent_teardown'] is agents
+    assert 'private original receipt' in receipt.read_text() and 'repair receipt' in receipt.read_text()
+    assert job['script']=='x.py' and job['provider']=='original'
