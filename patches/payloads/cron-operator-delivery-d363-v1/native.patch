+
+def test_claim_loss_during_repair_prevents_delivery(delivery,monkeypatch):
+    receipt,sent,fence=delivery
+    def repair(*a,**kw):
+        fence.lost=lambda:True
+        return 'Report cron — repaired and verified: done.',True
+    monkeypatch.setattr(s,'_attempt_cron_failure_remediation',repair)
+    d=s._RunDelivery(job={'id':'job','name':'Report'},success=False,error=op._CronOperatorFailure('bad','script'))
+    with pytest.raises(s._FireClaimLostDuringSideEffect):
+        s._save_compose_deliver(d,fence,'','receipt',adapters=None,loop=None,verbose=False,execution_token=None)
+    assert not sent
