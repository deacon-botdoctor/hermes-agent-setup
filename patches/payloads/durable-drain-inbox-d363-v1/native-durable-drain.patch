index 0000000..d515ab70f45eb8a8178f398b97985042cd13027e
--- /dev/null
+++ b/gateway/run_durable_drain.py
@@ -0,0 +1,289 @@
+"""Durable admission and replay around the native gateway lifecycle phases.
+
+Only a claimed event may enter a potentially side-effecting hook or agent. A
+crash while claimed is ambiguous and requires resend; it is never re-executed.
+"""
+from __future__ import annotations
+
+import asyncio
+import dataclasses
+import logging
+import threading
+import uuid
+import functools
+from pathlib import Path
+
+from gateway import drain_inbox as inbox
+
+logger = logging.getLogger(__name__)
+
+
+class DurableAdmissionError(RuntimeError):
+    """The transport must retry: durable acceptance could not be confirmed."""
+
+
+class GatewayDurableDrainMixin:
+    def _init_durable_drain(self):
+        self._durable_producer_token = uuid.uuid4().hex
+        self._durable_inbox_path = inbox.inbox_path()
+        self._durable_admission_lock = asyncio.Lock()
+        self._durable_replay_task = None
+        self._durable_replay_pending = False
+        self._durable_retry_handle = None
+        self._durable_retry_needed = False
+
+    def _durable_setup(self):
+        # Native unit fixtures construct runners without __init__.
+        if not isinstance(getattr(self, "_durable_producer_token", None), str):
+            self._init_durable_drain()
+
+    async def _claim_durable_producer(self):
+        self._durable_setup()
+        cancelled = threading.Event()
+        task = asyncio.get_running_loop().run_in_executor(None, functools.partial(
+            inbox.acquire_producer_replay_lease, self._durable_producer_token,
+            cancellation_event=cancelled, path=self._durable_inbox_path,
+        ))
+        try:
+            lease = await asyncio.shield(task)
+        except asyncio.CancelledError:
+            cancelled.set()
+            try:
+                lease = await task
+            except InterruptedError:
+                pass
+            else:
+                await asyncio.to_thread(inbox.cancel_producer_replay_lease, lease)
+            raise
+        await asyncio.to_thread(inbox.release_replay_lease, lease)
+
+    def _durable_control_event(self, event, session_key):
+        if event.internal and not event.durable_ingress:
+            return True
+        if not event.allow_gateway_control:
+            return False
+        if event.prompt_response:
+            return True
+        if event.get_command():
+            from hermes_cli.commands import resolve_command
+            if resolve_command(event.get_command()) is not None:
+                return True
+        from tools.approval import has_blocking_approval
+        from tools import clarify_gateway, slash_confirm
+        approval_pending = has_blocking_approval(session_key)
+        reply = (event.text or "").strip().lower()
+        if approval_pending and reply in self._PLAINTEXT_APPROVAL_WORDS:
+            return True
+        # Match inbound slash-confirm resolution, including tool-approval precedence.
+        if not approval_pending and slash_confirm.get_pending(session_key):
+            if (self._SLASH_CONFIRM_CMD_CHOICES.get(event.get_command())
+                    or self._SLASH_CONFIRM_TEXT_CHOICES.get(reply.lstrip("!/"))):
+                return True
+        return bool(clarify_gateway.get_pending_for_session(session_key, include_choice_prompts=True))
+
+    def _durable_gate_active(self):
+        return bool(
+            getattr(self, "_startup_restore_in_progress", False)
+            or getattr(self, "_draining", False)
+            or getattr(self, "_external_drain_active", False)
+            or getattr(self, "_durable_replay_pending", False)
+        )
+
+    def _make_durable_admission_handler(self, adapter):
+        from gateway.run import _async_profile_runtime_scope
+        from hermes_constants import get_hermes_home
+        default_home = Path(get_hermes_home())
+        async def admission(event, session_key):
+            if event.durable_replay or self._durable_control_event(event, session_key):
+                return False
+            if not self._durable_gate_active():
+                return False
+            self._durable_setup()
+            async with self._durable_admission_lock:
+                if not self._durable_gate_active():
+                    return False
+                # Match the native message-handler profile scope before hooks/auth.
+                owner = getattr(adapter, "_owner_profile", None)
+                profile_home = None
+                if isinstance(owner, str) and owner:
+                    profile_home = self._profile_home_or_none(owner)
+                elif getattr(self.config, "multiplex_profiles", False):
+                    event.source._authorization_profile_home = default_home
+                    if not event.source.profile:
+                        self._stamp_routed_profile(event.source)
+                    profile_home = self._resolve_profile_home_for_source(event.source)
+                async with self._scope_or_null(_async_profile_runtime_scope, profile_home):
+                    await self._hm_admit_event(event, durable_admission=True)
+            return True
+        return admission
+
+    async def _durable_admit_event(self, event):
+        key = self._session_key_for_source(event.source)
+        identity = inbox.event_queue_id(event, key)
+        if await asyncio.to_thread(self.session_store.replay_marker_status_for_session_key, key, f"drain:{identity}"):
+            return None
+        queue_id, state, claimed = await asyncio.to_thread(
+            inbox.claim_pre_dispatch_event_result, event, key,
+            reason="startup-or-drain", path=self._durable_inbox_path, producer_token=self._durable_producer_token,
+        )
+        if not queue_id:
+            raise DurableAdmissionError("Durable inbox admission failed")
+        if not claimed:
+            # A retry of claimed/completed/handled ingress must never repeat hooks.
+            return None
+        original = event
+        event = self._hm_pre_gateway_dispatch_hook(event, event.source) if not event.internal else event
+        plugin_handled = event is None
+        handled = plugin_handled
+        event = dataclasses.replace(event or original, pre_dispatch_attempted=True)
+        # Persist rewrite + hook receipt BEFORE auth/pairing can have side effects.
+        receipt, state = await asyncio.to_thread(
+            inbox.record_pre_dispatch_attempt_result, event, key,
+            path=self._durable_inbox_path, producer_token=self._durable_producer_token,
+        )
+        if not receipt or state != "claimed":
+            raise DurableAdmissionError("Durable hook receipt failed")
+        admitted = None if handled else await self._hm_admit_event(event, durable_finalize=True)
+        handled = handled or admitted is None
+        receipt, state = await asyncio.to_thread(
+            inbox.finalize_pre_dispatch_event_result, event, key, handled=handled,
+            reason=("startup-restore-plugin-handled" if plugin_handled else
+                    "startup-restore-unauthorized-rejected" if handled else "startup-or-drain"),
+            path=self._durable_inbox_path, producer_token=self._durable_producer_token,
+        )
+        if not receipt or state not in {"queued", "handled"}:
+            raise DurableAdmissionError("Durable admission finalization failed")
+        return None
+
+    async def _persist_pending_followup_for_drain(self, event, session_key):
+        self._durable_setup()
+        async with self._durable_admission_lock:
+            await self._hm_admit_event(event, durable_admission=True)
+
+    def _schedule_durable_replay(self):
+        self._durable_setup()
+        if not getattr(self, "_running", False) or self._draining or self._external_drain_active:
+            return
+        if self._durable_retry_handle is not None:
+            self._durable_retry_handle.cancel()
+            self._durable_retry_handle = None
+        task = self._durable_replay_task
+        if task is not None and not task.done():
+            return
+        self._durable_replay_pending = True
+        self._durable_retry_needed = False
+        self._durable_replay_task = asyncio.create_task(self._drain_durable_inbox())
+        self._durable_replay_task.add_done_callback(self._durable_replay_finished)
+
+    def _durable_replay_finished(self, task):
+        if task.cancelled():
+            return
+        if task.exception():
+            logger.error("Durable inbox replay retained pending work: %s", task.exception())
+            self._durable_retry_needed = True
+        if self._durable_retry_needed and getattr(self, "_running", False):
+            self._durable_retry_handle = asyncio.get_running_loop().call_later(5, self._schedule_durable_replay)
+
+    async def _drain_durable_inbox(self):
+        cancelled = threading.Event()
+        acquire = asyncio.get_running_loop().run_in_executor(None, functools.partial(
+            inbox.acquire_replay_lease, cancellation_event=cancelled, path=self._durable_inbox_path,
+        ))
+        try:
+            lease = await asyncio.shield(acquire)
+        except asyncio.CancelledError:
+            cancelled.set()
+            try:
+                lease = await acquire
+            except InterruptedError:
+                pass
+            else:
+                await asyncio.to_thread(inbox.release_replay_lease, lease)
+            raise
+        seen = set()
+        try:
+            while not (getattr(self, "_draining", False) or getattr(self, "_external_drain_active", False)):
+                async with self._durable_admission_lock:
+                    records = await asyncio.to_thread(inbox.pending_records, self._durable_inbox_path)
+                    remaining = [r for r in records if r["queue_id"] not in seen]
+                    if not remaining:
+                        self._durable_retry_needed = any(
+                            r.get("state") in {"queued", "completed", "handled"}
+                            or (r.get("state") in {"claimed", "ambiguous"} and r.get("ambiguity_notice_sent") is not True)
+                            for r in records
+                        )
+                        self._durable_replay_pending = False
+                        return
+                for record in remaining:
+                    if getattr(self, "_draining", False) or getattr(self, "_external_drain_active", False):
+                        return
+                    seen.add(record["queue_id"])
+                    try:
+                        await self._replay_durable_record(record)
+                    except Exception:
+                        logger.exception("Durable inbox retained record %s", record["queue_id"])
+        finally:
+            self._durable_replay_pending = False
+            await asyncio.to_thread(inbox.release_replay_lease, lease)
+
+    async def _replay_durable_record(self, record):
+        queue_id, state = record["queue_id"], record.get("state", "queued")
+        key = record["session_key"]
+        marker = f"drain:{queue_id}"
+        token = self._durable_producer_token
+        if state == "handled" and record.get("recovery_disposition") == "unauthorized-rejected":
+            await asyncio.to_thread(inbox.acknowledge, queue_id, expected_state=state, path=self._durable_inbox_path, producer_token=token)
+            return
+        event = inbox.event_from_record(record)
+        adapter = self._adapter_for_source(event.source)
+        if adapter is None:
+            return  # Offline profile/platform: retain, never drop accepted work.
+        # Strict canonical DB lookup must succeed before any replay side effect.
+        marked = await asyncio.to_thread(self.session_store.replay_marker_status_for_session_key, key, marker)
+        if marked:
+            await asyncio.to_thread(inbox.acknowledge, queue_id, expected_state=state, path=self._durable_inbox_path, producer_token=token)
+            return
+        if state in {"claimed", "ambiguous"}:
+            if record.get("ambiguity_notice_sent") is not True:
+                result = await adapter.send(
+                    chat_id=event.source.chat_id,
+                    content="A message was interrupted during restart and may have partially run. Please resend it if you still need it.",
+                )
+                if result and result.success:
+                    await asyncio.to_thread(inbox.record_ambiguity_notice, queue_id, path=self._durable_inbox_path, producer_token=token)
+            return
+        if state in {"completed", "handled"}:
+            await self._complete_durable_marker(event, key, queue_id, marker, expected_state=state)
+            return
+        if state != "queued":
+            return
+        # Resume owns the native adapter task and runner slot before startup releases.
+        task = getattr(adapter, "_session_tasks", {}).get(key)
+        if task is not None:
+            await asyncio.shield(task)
+        if key in getattr(adapter, "_active_sessions", {}) or self._is_session_running(key):
+            return
+        if not await asyncio.to_thread(inbox.claim_event, queue_id, path=self._durable_inbox_path, producer_token=token):
+            return
+        event = dataclasses.replace(event, durable_replay=True, admission_checked=True)
+        replay = getattr(adapter, "replay_durable_event", None)
+        await (replay(event) if replay is not None else adapter.handle_message(event))
+        task = getattr(adapter, "_session_tasks", {}).get(key)
+        if task is not None:
+            await asyncio.shield(task)
+        if event.durable_deferred:
+            await asyncio.to_thread(inbox.defer_event, queue_id, path=self._durable_inbox_path, producer_token=token)
+            return
+        if not event.handler_succeeded:
+            return  # Adapter errors are caught by native processing; claim stays ambiguous.
+        if not await asyncio.to_thread(inbox.complete_event, queue_id, path=self._durable_inbox_path, producer_token=token):
+            return
+        await self._complete_durable_marker(event, key, queue_id, marker)
+
+    async def _complete_durable_marker(self, event, key, queue_id, marker, *, expected_state="completed"):
+        session = await asyncio.to_thread(self.session_store.get_or_create_session, event.source, touch_activity=False)
+        if session.session_key != key:
+            raise RuntimeError("Durable replay session scope changed")
+        if not await asyncio.to_thread(self.session_store.persist_replay_marker, session.session_id, marker):
+            raise RuntimeError("Durable replay completion marker failed")
+        await asyncio.to_thread(inbox.acknowledge, queue_id, expected_state=expected_state, path=self._durable_inbox_path, producer_token=self._durable_producer_token)
