+def test_old_process_ack_cannot_erase_new_process_append(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    path = inbox_path()
+    first = _event("first instruction")
+    second = MessageEvent(
+        text="second instruction",
