+    runner, _adapter = make_restart_runner()
+    runner._startup_restore_in_progress = True
+    runner._startup_restore_tasks = []
+    runner._schedule_resume_pending_sessions = lambda: 0  # ty:ignore[invalid-assignment]
+    runner._schedule_post_startup_drain = MagicMock()
+    final_started = asyncio.Event()
+    release_final = asyncio.Event()
+    calls = 0
+
+    async def drain(_attempted):
+        nonlocal calls
+        calls += 1
+        if calls == 1:
+            return 0
+        final_started.set()
+        await release_final.wait()
+        return 1
+
+    runner._drain_persisted_drain_inbox = drain  # ty:ignore[invalid-assignment]
+    monkeypatch.setenv("HERMES_STARTUP_RESTORE_DRAIN_TIMEOUT", "0.01")
+
+    await asyncio.wait_for(runner._finish_startup_restore(), timeout=1)
+
+    assert final_started.is_set()
+    assert runner._startup_restore_in_progress is False
+    release_final.set()
+    await asyncio.sleep(0)
+    await asyncio.sleep(0)
+    runner._schedule_post_startup_drain.assert_called_once_with()
