+@pytest.mark.parametrize("outcome", ["accepted", "failed", "cancelled"])
+async def test_webhook_concurrent_retry_waits_for_durable_admission(outcome):
+    from unittest.mock import AsyncMock
+    from tests.gateway.test_webhook_adapter import _make_adapter, _mock_request, _INSECURE_NO_AUTH
+    adapter = _make_adapter(routes={"test": {"secret": _INSECURE_NO_AUTH, "prompt": "work"}})
+    entered, release = asyncio.Event(), asyncio.Event()
+
+    async def admit(event):
+        entered.set()
+        await release.wait()
+        if outcome == "failed":
+            raise OSError("disk full")
+        return True
+
+    adapter._preflight_startup_gate = AsyncMock(side_effect=admit)
+    request = _mock_request(headers={"X-Request-ID": "concurrent-1"}, body=b"{}", match_info={"route_name": "test"})
+    first = asyncio.create_task(adapter._handle_webhook(request))
+    await asyncio.wait_for(entered.wait(), timeout=1)
+    try:
+        retry = await adapter._handle_webhook(request)
+        assert retry.status == 503
+        assert adapter._preflight_startup_gate.await_count == 1
+    finally:
+        if outcome == "cancelled":
+            first.cancel()
+        release.set()
+        if outcome == "cancelled":
+            with pytest.raises(asyncio.CancelledError):
+                await first
+        else:
+            response = await first
+    assert adapter._pending_admissions == set()
+    if outcome == "accepted":
+        assert response.status == 202
+        assert (await adapter._handle_webhook(request)).status == 200
+        assert adapter._preflight_startup_gate.await_count == 1
+    else:
+        if outcome == "failed":
+            assert response.status == 503
+        assert "concurrent-1" not in adapter._seen_deliveries
+        adapter._preflight_startup_gate = AsyncMock(return_value=True)
+        assert (await adapter._handle_webhook(request)).status == 202
+        assert (await adapter._handle_webhook(request)).status == 200
+        assert adapter._preflight_startup_gate.await_count == 1
