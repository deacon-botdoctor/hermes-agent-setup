+def test_segmented_web_search_batch_stops_before_later_calls():
+    agent = _make_agent(
+        "web_search", "terminal", max_iterations=10, config=_hard_stop_config()
+    )
+    empty = json.dumps({"success": True, "data": {"web": []}})
+    for index in range(7):
+        agent._tool_guardrails.after_call(
+            "web_search",
+            {"query": f"prior-{index}"},
+            empty,
+            failed=False,
+        )
+    calls = [
+        _mock_tool_call("web_search", json.dumps({"query": "eighth"}), "c-eight"),
+        _mock_tool_call("web_search", json.dumps({"query": "must-not-run"}), "c-nine"),
+        _mock_tool_call("terminal", json.dumps({"command": "echo no"}), "c-terminal"),
+    ]
+    assistant_message = SimpleNamespace(content="", tool_calls=calls)
+    messages = []
+
+    def dispatch(name, args, task_id, **kwargs):
+        del args, task_id, kwargs
+        return empty if name == "web_search" else "must-not-run"
+
+    with patch("run_agent.handle_function_call", side_effect=dispatch) as execute:
+        agent._execute_tool_calls(assistant_message, messages, "task-1")
+
+    assert execute.call_count == 1
+    assert execute.call_args.args[0] == "web_search"
+    assert [message["tool_call_id"] for message in messages] == [
+        "c-eight",
+        "c-nine",
+        "c-terminal",
+    ]
+    assert all(
+        "repeated_empty_web_search_halt" in message["content"]
+        for message in messages[1:]
+    )
