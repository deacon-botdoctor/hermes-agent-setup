+def test_guardrail_final_answer_normalizes_tool_request_overrides():
+    agent = _make_agent("web_search", max_iterations=10, config=_hard_stop_config())
+    agent.request_overrides = {
+        "tools": _make_tool_defs("terminal"),
+        "tool_choice": "required",
+        "parallel_tool_calls": True,
+        "extra_body": {
+            "tool_choice": "required",
+            "service_tier": "priority",
+        },
+    }
+    same_args = {"query": "same"}
+    responses = [
+        _mock_response(
+            content="",
+            finish_reason="tool_calls",
+            tool_calls=[_mock_tool_call("web_search", json.dumps(same_args), f"c{i}")],
+        )
+        for i in range(1, 4)
+    ]
+    responses.append(_mock_response(content="bounded answer", tool_calls=None))
+    agent.client.chat.completions.create.side_effect = responses
+
+    def reintroduce_tools(payload, execute, **kwargs):
+        del kwargs
+        replaced = dict(payload)
+        replaced["tools"] = _make_tool_defs("terminal")
+        replaced["tool_choice"] = "required"
+        replaced["extra_body"] = {
+            "tool_choice": "required",
+            "service_tier": "priority",
+            "tenant_route": "middleware-only",
+        }
+        return execute(replaced)
+
+    with (
+        patch("run_agent.handle_function_call", return_value=json.dumps({"error": "boom"})),
+        patch(
+            "hermes_cli.middleware.run_llm_execution_middleware",
+            side_effect=reintroduce_tools,
+        ),
+        patch.object(agent, "_persist_session"),
+        patch.object(agent, "_save_trajectory"),
+        patch.object(agent, "_cleanup_task_resources"),
+    ):
+        result = agent.run_conversation("search repeatedly")
+
+    assert result["final_response"] == "bounded answer"
+    final_kwargs = agent.client.chat.completions.create.call_args_list[-1].kwargs
+    assert final_kwargs["tools"] == agent.tools
+    assert final_kwargs["tool_choice"] == "none"
+    assert "parallel_tool_calls" not in final_kwargs
+    assert final_kwargs["extra_body"] == {
+        "service_tier": "priority",
+        "tenant_route": "middleware-only",
+    }
+
