@@ -0,0 +1,112 @@
+"""workers/memory/anamnesis/change_detect.py — document fingerprint + staleness detection.
+
+Advisory change detection: compares source_uri → content_hash in the
+document_fingerprints table (created by migration 0004). Does NOT block
+ingestion, auto-delete old memories, or auto-reingest changed documents.
+
+Public API:
+    check_staleness(conn, source_uri, current_hash)
+        -> {stale: bool, old_hash: str|None, last_ingested: str|None}
+
+    record_ingestion(conn, source_uri, content_hash, chunk_count, metadata)
+        -> None  (upserts fingerprint row; idempotent)
+
+Both functions accept an open sqlite3.Connection on memory.db and are safe
+to call within or outside an explicit transaction. If migration 0004 has not
+been run (table absent), both log a warning and return safe defaults without
+raising.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import sqlite3
+import time
+from typing import Any, Dict, Optional
+
+logger = logging.getLogger(__name__)
+
+
+def _table_exists(conn: sqlite3.Connection) -> bool:
+    row = conn.execute(
+        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='document_fingerprints'"
+    ).fetchone()
+    return row is not None
+
+
+def check_staleness(
+    conn: sqlite3.Connection,
+    source_uri: str,
+    current_hash: str,
+) -> Dict[str, Any]:
+    """Compare current_hash against the stored fingerprint for source_uri.
+
+    Returns:
+        {
+            "stale": bool,               # True when hash differs from stored value
+            "old_hash": str | None,       # stored hash if row exists, else None
+            "last_ingested": str | None,  # ISO-8601 timestamp if row exists, else None
+        }
+
+    If the document_fingerprints table does not exist (migration 0004 not run),
+    returns {stale: False, old_hash: None, last_ingested: None} with a warning.
+    """
+    if not _table_exists(conn):
+        logger.warning(
+            "change_detect: document_fingerprints table missing; "
+            "run migration 0004 to enable change detection"
+        )
+        return {"stale": False, "old_hash": None, "last_ingested": None}
+
+    row = conn.execute(
+        "SELECT content_hash, last_ingested_at "
+        "FROM document_fingerprints WHERE source_uri = ?",
+        (source_uri,),
+    ).fetchone()
+
+    if row is None:
+        return {"stale": False, "old_hash": None, "last_ingested": None}
+
+    old_hash, last_ingested = row
+    return {
+        "stale": old_hash != current_hash,
+        "old_hash": old_hash,
+        "last_ingested": last_ingested,
+    }
+
+
+def record_ingestion(
+    conn: sqlite3.Connection,
+    source_uri: str,
+    content_hash: str,
+    chunk_count: int,
+    metadata: Optional[Dict[str, Any]] = None,
+) -> None:
+    """Upsert a fingerprint row after successful ingestion.
+
+    Idempotent: repeated calls with the same source_uri update the existing
+    row rather than inserting a duplicate.
+    """
+    if not _table_exists(conn):
+        logger.warning(
+            "change_detect: document_fingerprints table missing; "
+            "skipping record_ingestion for %s", source_uri
+        )
+        return
+
+    now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+    metadata_json = json.dumps(metadata or {}, separators=(",", ":"))
+
+    conn.execute(
+        """
+        INSERT INTO document_fingerprints
+            (source_uri, content_hash, chunk_count, last_ingested_at, metadata)
+        VALUES (?, ?, ?, ?, ?)
+        ON CONFLICT(source_uri) DO UPDATE SET
+            content_hash     = excluded.content_hash,
+            chunk_count      = excluded.chunk_count,
+            last_ingested_at = excluded.last_ingested_at,
+            metadata         = excluded.metadata
+        """,
+        (source_uri, content_hash, chunk_count, now, metadata_json),
+    )
diff --git a/workers/memory/anamnesis/external.py b/workers/memory/anamnesis/external.py
