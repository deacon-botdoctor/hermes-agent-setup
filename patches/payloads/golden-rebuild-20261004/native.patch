+"""workers/memory/anamnesis/read_tools.py — extended read-tool handlers (v8).
+
+Phase 5.3e-1 adds 6 anamnesis read tools + 1 filesystem tool to retire
+the v7 stubs in anamnesis_compat_mcp.
+
+Implemented as subclass of AnamnesisRecallWorker to keep the base class
+focused on FTS5/Qdrant search while still sharing the read-only sqlite
+connection and scope/lock infrastructure.
+
+Tools added:
+  handle_recall          (anamnesis_recall — last-N memories from container)
+  handle_transcript_search (anamnesis_transcript_search — chunks_fts FTS5)
+  handle_temporal_query  (anamnesis_temporal_query — subject/object lookup)
+  handle_timeline        (anamnesis_timeline — chronological view)
+  handle_profile         (anamnesis_profile — user attributes)
+  handle_stats           (anamnesis_stats — counts)
+  handle_vault_search    (vault_search — filesystem search over ~/Documents/Brain)
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+import os
+import re
+import sqlite3
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+from ..._ipc.envelope import Envelope, ErrorCode
+from ..._ipc.server import HandlerError
+from .recall import AnamnesisRecallWorker, LEGACY_SENTINEL
+
+
+logger = logging.getLogger(__name__)
+
+
+VALID_DIRECTIONS = {"outgoing", "incoming", "both"}
+VAULT_DEFAULT_PATH = os.path.expanduser("~/Documents/Brain")
+
+
+class ExtendedAnamnesisRecallWorker(AnamnesisRecallWorker):
+    """AnamnesisRecallWorker + 6 additional read-tool handlers + vault search.
+
+    Constructor adds an optional `vault_root` for vault_search; defaults to
+    ~/Documents/Brain (matches anamnesis/server.py BRAIN_VAULT default).
+    """
+
+    def __init__(
+        self,
+        memory_db_path: str,
+        *,
+        qdrant_client: Any = None,
+        ollama_client: Any = None,
+        vault_root: str = VAULT_DEFAULT_PATH,
+    ):
+        super().__init__(
+            memory_db_path,
+            qdrant_client=qdrant_client,
+            ollama_client=ollama_client,
+        )
+        self.vault_root = vault_root
+
+    # ─── anamnesis_recall — last-N memories ────────────────────────────
+
+    async def handle_recall_recent(self, env: Envelope) -> Dict[str, Any]:
+        """anamnesis_recall — recent memories from container, no query.
+
+        Renamed from handle_recall to avoid colliding with parent class's
+        handle_recall (which is search-with-query).
+        """
+        args = env.args
+        container = args.get("container")
+        limit = args.get("limit", 20)
+        include_legacy = bool(args.get("include_legacy", False))
+
+        try:
+            limit = int(limit)
+        except (TypeError, ValueError):
+            raise HandlerError(ErrorCode.INVALID_INPUT, "args.limit must be int", retryable=False)
+        limit = max(1, min(100, limit))
+
+        client_id = env.scope.client_id
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._recall_recent_sync, container, limit, client_id, include_legacy,
+            )
+
+    def _recall_recent_sync(
+        self, container: Optional[str], limit: int, client_id: str, include_legacy: bool,
+    ) -> Dict[str, Any]:
+        assert self._conn is not None
+        clauses = ["m.superseded_by IS NULL", "m.forgotten_at IS NULL"]
+        params: List[Any] = []
+        if include_legacy:
+            clauses.append("(m.client_id = ? OR m.client_id = ?)")
+            params.extend([client_id, LEGACY_SENTINEL])
+        else:
+            clauses.append("m.client_id = ?")
+            params.append(client_id)
+        if container:
+            clauses.append("m.container_id = ?")
+            params.append(container)
+        where = " AND ".join(clauses)
+        rows = self._conn.execute(
+            f"""SELECT m.id, m.content, m.container_id, m.document_date,
+                       m.event_date, m.confidence, m.client_id, m.memory_type,
+                       m.priority, m.vector_status
+                  FROM memories m
+                 WHERE {where}
+                 ORDER BY m.document_date DESC
+                 LIMIT ?""",
+            [*params, limit],
+        ).fetchall()
+        hits = [{
+            "memory_id": r[0], "content": r[1], "container_id": r[2],
+            "document_date": r[3], "event_date": r[4], "confidence": r[5],
+            "client_id": r[6], "memory_type": r[7], "priority": r[8],
+            "vector_status": r[9],
+        } for r in rows]
+        return {"ok": True, "data": {"hits": hits, "count": len(hits)}}
+
+    # ─── anamnesis_transcript_search — chunks_fts ──────────────────────
+
+    async def handle_transcript_search(self, env: Envelope) -> Dict[str, Any]:
+        args = env.args
+        query = args.get("query")
+        container = args.get("container")
+        role = args.get("role")
+        session_id = args.get("session_id")
+        limit = args.get("limit", 10)
+
+        if not isinstance(query, str) or not query.strip():
+            raise HandlerError(ErrorCode.INVALID_INPUT, "args.query is required", retryable=False)
+        try:
+            limit = int(limit)
+        except (TypeError, ValueError):
+            raise HandlerError(ErrorCode.INVALID_INPUT, "args.limit must be int", retryable=False)
+        limit = max(1, min(100, limit))
+
+        client_id = env.scope.client_id
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._transcript_search_sync,
+                query, container, role, session_id, limit, client_id,
+            )
+
+    def _transcript_search_sync(
+        self, query: str, container: Optional[str], role: Optional[str],
+        session_id: Optional[str], limit: int, client_id: str,
+    ) -> Dict[str, Any]:
+        assert self._conn is not None
+        from .recall import build_fts_query
+        fts_query = build_fts_query(query)
+        clauses = ["c.client_id IN (?, ?)"]
+        params: List[Any] = [client_id, LEGACY_SENTINEL]
+        if container:
+            clauses.append("c.container_id = ?")
+            params.append(container)
+        if role:
+            clauses.append("c.role = ?")
+            params.append(role)
+        if session_id:
+            clauses.append("c.session_id = ?")
+            params.append(session_id)
+        where = " AND ".join(clauses)
+        sql = f"""
+            SELECT c.id, c.session_id, c.container_id, c.document_date,
+                   c.role, c.content, chunks_fts.rank
+              FROM chunks_fts
+              JOIN chunks c ON chunks_fts.chunk_id = c.id
+             WHERE chunks_fts MATCH ? AND {where}
+             ORDER BY chunks_fts.rank, c.document_date DESC
+             LIMIT ?
+        """
+        try:
+            rows = self._conn.execute(sql, [fts_query, *params, limit]).fetchall()
+        except sqlite3.OperationalError as exc:
+            # chunks_fts may not exist on minimal test fixtures; fall through cleanly.
+            logger.warning("transcript_search FTS query failed: %s", exc)
+            return {"ok": True, "data": {"hits": [], "count": 0}}
+
+        hits = [{
+            "chunk_id": r[0], "session_id": r[1], "container_id": r[2],
+            "document_date": r[3], "role": r[4], "content": r[5],
+            "rank": r[6],
+        } for r in rows]
+        return {"ok": True, "data": {"hits": hits, "count": len(hits)}}
+
+    # ─── anamnesis_temporal_query ──────────────────────────────────────
+
+    async def handle_temporal_query(self, env: Envelope) -> Dict[str, Any]:
+        args = env.args
+        entity = args.get("entity")
+        as_of = args.get("as_of")
+        direction = args.get("direction", "both")
+        container = args.get("container")
+        limit = args.get("limit", 20)
+
+        if not isinstance(entity, str) or not entity:
+            raise HandlerError(ErrorCode.INVALID_INPUT, "args.entity is required", retryable=False)
+        if direction not in VALID_DIRECTIONS:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               f"args.direction must be in {sorted(VALID_DIRECTIONS)}",
+                               retryable=False)
+        try:
+            limit = int(limit)
+        except (TypeError, ValueError):
+            raise HandlerError(ErrorCode.INVALID_INPUT, "args.limit must be int", retryable=False)
+
+        client_id = env.scope.client_id
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._temporal_query_sync,
+                entity, as_of, direction, container, limit, client_id,
+            )
+
+    def _temporal_query_sync(
+        self, entity: str, as_of: Optional[str], direction: str,
+        container: Optional[str], limit: int, client_id: str,
+    ) -> Dict[str, Any]:
+        assert self._conn is not None
+        results = []
+        base_clauses = ["client_id IN (?, ?)"]
+        base_params: List[Any] = [client_id, LEGACY_SENTINEL]
+        if container:
+            base_clauses.append("container_id = ?")
+            base_params.append(container)
+        if as_of:
+            base_clauses.append("(valid_from IS NULL OR valid_from <= ?)")
+            base_clauses.append("(valid_to IS NULL OR valid_to >= ?)")
+            base_params.extend([as_of, as_of])
+        base_where = " AND ".join(base_clauses)
+
+        try:
+            if direction in ("outgoing", "both"):
+                rows = self._conn.execute(
+                    f"""SELECT subject, predicate, object, container_id,
+                              valid_from, valid_to, confidence,
+                              source_memory_id, source_chunk_id
+                         FROM temporal_facts
+                        WHERE subject = ? AND {base_where}
+                        ORDER BY COALESCE(valid_from, created_at) DESC
+                        LIMIT ?""",
+                    [entity, *base_params, limit],
+                ).fetchall()
+                for r in rows:
+                    results.append({
+                        "direction": "outgoing", "subject": r[0], "predicate": r[1],
+                        "object": r[2], "container_id": r[3],
+                        "valid_from": r[4], "valid_to": r[5], "confidence": r[6],
+                        "source_memory_id": r[7], "source_chunk_id": r[8],
+                        "current": r[5] is None,
+                    })
+            if direction in ("incoming", "both"):
+                rows = self._conn.execute(
+                    f"""SELECT subject, predicate, object, container_id,
+                              valid_from, valid_to, confidence,
+                              source_memory_id, source_chunk_id
+                         FROM temporal_facts
+                        WHERE object = ? AND {base_where}
+                        ORDER BY COALESCE(valid_from, created_at) DESC
+                        LIMIT ?""",
+                    [entity, *base_params, limit],
+                ).fetchall()
+                for r in rows:
+                    results.append({
+                        "direction": "incoming", "subject": r[0], "predicate": r[1],
+                        "object": r[2], "container_id": r[3],
+                        "valid_from": r[4], "valid_to": r[5], "confidence": r[6],
+                        "source_memory_id": r[7], "source_chunk_id": r[8],
+                        "current": r[5] is None,
+                    })
+        except sqlite3.OperationalError as exc:
+            # temporal_facts may have schema drift on legacy installs
+            logger.warning("temporal_query failed: %s", exc)
+            return {"ok": True, "data": {"facts": [], "count": 0}}
+
+        results.sort(key=lambda x: (x["valid_from"] or "", x["predicate"]), reverse=True)
+        return {"ok": True, "data": {"facts": results[:limit], "count": len(results[:limit])}}
+
+    # ─── anamnesis_timeline ────────────────────────────────────────────
+
+    async def handle_timeline(self, env: Envelope) -> Dict[str, Any]:
+        args = env.args
+        entity = args.get("entity")
+        container = args.get("container")
+        limit = args.get("limit", 50)
+
+        try:
+            limit = int(limit)
+        except (TypeError, ValueError):
+            raise HandlerError(ErrorCode.INVALID_INPUT, "args.limit must be int", retryable=False)
+        limit = max(1, min(500, limit))
+
+        client_id = env.scope.client_id
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._timeline_sync, entity, container, limit, client_id,
+            )
+
+    def _timeline_sync(
+        self, entity: Optional[str], container: Optional[str],
+        limit: int, client_id: str,
+    ) -> Dict[str, Any]:
+        assert self._conn is not None
+        clauses = ["client_id IN (?, ?)"]
+        params: List[Any] = [client_id, LEGACY_SENTINEL]
+        if entity:
+            clauses.append("(subject = ? OR object = ?)")
+            params.extend([entity, entity])
+        if container:
+            clauses.append("container_id = ?")
+            params.append(container)
+        where = " AND ".join(clauses)
+        try:
+            rows = self._conn.execute(
+                f"""SELECT subject, predicate, object, container_id,
+                          valid_from, valid_to, confidence, created_at
+                     FROM temporal_facts
+                    WHERE {where}
+                    ORDER BY COALESCE(valid_from, created_at) DESC, created_at DESC
+                    LIMIT ?""",
+                [*params, limit],
+            ).fetchall()
+        except sqlite3.OperationalError:
+            return {"ok": True, "data": {"timeline": [], "count": 0}}
+
+        timeline = [{
+            "subject": r[0], "predicate": r[1], "object": r[2],
+            "container_id": r[3], "valid_from": r[4], "valid_to": r[5],
+            "confidence": r[6], "created_at": r[7],
+        } for r in rows]
+        return {"ok": True, "data": {"timeline": timeline, "count": len(timeline)}}
+
+    # ─── anamnesis_profile ─────────────────────────────────────────────
+
+    async def handle_profile(self, env: Envelope) -> Dict[str, Any]:
+        args = env.args
+        category = args.get("category")
+        limit = args.get("limit", 30)
+
+        try:
+            limit = int(limit)
+        except (TypeError, ValueError):
+            raise HandlerError(ErrorCode.INVALID_INPUT, "args.limit must be int", retryable=False)
+        limit = max(1, min(200, limit))
+
+        client_id = env.scope.client_id
+        # NOTE: profiles.user_id was historically separate from client_id.
+        # v8 maps client_id -> user_id (1:1). If clients want their own
+        # profile facets, the migration backfill in 5.3e-2 will populate
+        # client_id from user_id on existing rows.
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._profile_sync, category, limit, client_id,
+            )
+
+    def _profile_sync(
+        self, category: Optional[str], limit: int, client_id: str,
+    ) -> Dict[str, Any]:
+        assert self._conn is not None
+        clauses = ["client_id IN (?, ?)", "superseded_at IS NULL"]
+        params: List[Any] = [client_id, LEGACY_SENTINEL]
+        if category:
+            clauses.append("attribute LIKE ?")
+            params.append(f"{category}%")
+        where = " AND ".join(clauses)
+        try:
+            rows = self._conn.execute(
+                f"""SELECT attribute, value, container_id, document_date
+                      FROM profiles
+                     WHERE {where}
+                     ORDER BY document_date DESC
+                     LIMIT ?""",
+                [*params, limit],
+            ).fetchall()
+        except sqlite3.OperationalError:
+            return {"ok": True, "data": {"attributes": [], "count": 0}}
+
+        attrs = [{
+            "attribute": r[0], "value": r[1],
+            "container_id": r[2], "document_date": r[3],
+        } for r in rows]
+        return {"ok": True, "data": {"attributes": attrs, "count": len(attrs)}}
+
+    # ─── anamnesis_stats ───────────────────────────────────────────────
+
+    async def handle_stats(self, env: Envelope) -> Dict[str, Any]:
+        client_id = env.scope.client_id
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._stats_sync, client_id,
+            )
+
+    def _stats_sync(self, client_id: str) -> Dict[str, Any]:
+        assert self._conn is not None
+        scoped = "(client_id = ? OR client_id = ?)"
+        scope_params = [client_id, LEGACY_SENTINEL]
+        memories_total = self._conn.execute(
+            f"SELECT COUNT(*) FROM memories WHERE {scoped} "
+            "AND superseded_by IS NULL AND forgotten_at IS NULL",
+            scope_params,
+        ).fetchone()[0]
+        chunks_total = 0
+        try:
+            chunks_total = self._conn.execute(
+                f"SELECT COUNT(*) FROM chunks WHERE {scoped}",
+                scope_params,
+            ).fetchone()[0]
+        except sqlite3.OperationalError:
+            pass
+        temporal_total = 0
+        try:
+            temporal_total = self._conn.execute(
+                f"SELECT COUNT(*) FROM temporal_facts WHERE {scoped}",
+                scope_params,
+            ).fetchone()[0]
+        except sqlite3.OperationalError:
+            pass
+        # Vector pipeline health
+        pending_total = self._conn.execute(
+            f"SELECT COUNT(*) FROM memories WHERE {scoped} "
+            "AND vector_status = 'pending'",
+            scope_params,
+        ).fetchone()[0]
+        dead_letter_total = self._conn.execute(
+            f"SELECT COUNT(*) FROM memories WHERE {scoped} "
+            "AND vector_status = 'dead-letter'",
+            scope_params,
+        ).fetchone()[0]
+        # Container breakdown
+        container_rows = self._conn.execute(
+            f"SELECT container_id, COUNT(*) FROM memories WHERE {scoped} "
+            "AND superseded_by IS NULL AND forgotten_at IS NULL "
+            "GROUP BY container_id",
+            scope_params,
+        ).fetchall()
+        return {"ok": True, "data": {
+            "client_id": client_id,
+            "memories_total": memories_total,
+            "chunks_total": chunks_total,
+            "temporal_facts_total": temporal_total,
+            "vector_pending": pending_total,
+            "vector_dead_letter": dead_letter_total,
+            "by_container": [{"container_id": r[0], "count": r[1]} for r in container_rows],
+        }}
+
+    # ─── vault_search ──────────────────────────────────────────────────
+
+    async def handle_vault_search(self, env: Envelope) -> Dict[str, Any]:
+        """Filesystem search over Obsidian Brain vault.
+
+        Read-only, machine-scoped (not client-scoped — vault is global).
+        Returns matched files and snippet of matching line.
+        """
+        args = env.args
+        query = args.get("query")
+        path_arg = args.get("path")
+        limit = args.get("limit", 10)
+
+        if not isinstance(query, str) or not query.strip():
+            raise HandlerError(ErrorCode.INVALID_INPUT, "args.query is required", retryable=False)
+        try:
+            limit = int(limit)
+        except (TypeError, ValueError):
+            raise HandlerError(ErrorCode.INVALID_INPUT, "args.limit must be int", retryable=False)
+        limit = max(1, min(100, limit))
+
+        return await asyncio.get_running_loop().run_in_executor(
+            None, self._vault_search_sync, query, path_arg, limit,
+        )
+
+    def _vault_search_sync(
+        self, query: str, path_arg: Optional[str], limit: int,
+    ) -> Dict[str, Any]:
+        root = Path(self.vault_root)
+        if path_arg:
+            target = (root / path_arg).resolve()
+            # Prevent path-traversal escapes from vault root
+            try:
+                target.relative_to(root.resolve())
+            except ValueError:
+                raise HandlerError(ErrorCode.INVALID_INPUT,
+                                   f"path {path_arg!r} escapes vault root",
+                                   retryable=False)
+        else:
+            target = root.resolve()
+
+        if not target.exists():
+            return {"ok": True, "data": {"matches": [], "count": 0,
+                                          "vault_root": str(root)}}
+
+        query_lower = query.lower()
+        matches: List[Dict[str, Any]] = []
+        for fp in target.rglob("*.md"):
+            if len(matches) >= limit:
+                break
+            try:
+                content = fp.read_text(encoding="utf-8", errors="ignore")
+            except OSError:
+                continue
+            content_lower = content.lower()
+            if query_lower not in content_lower:
+                continue
+            snippet = ""
+            for line in content.splitlines():
+                if query_lower in line.lower():
+                    snippet = line.strip()[:200]
+                    break
+            try:
+                rel = fp.relative_to(root)
+            except ValueError:
+                rel = fp
+            matches.append({
+                "path": str(rel),
+                "size_bytes": fp.stat().st_size,
+                "snippet": snippet,
+            })
+
+        return {"ok": True, "data": {
+            "matches": matches,
+            "count": len(matches),
+            "vault_root": str(root),
+        }}
