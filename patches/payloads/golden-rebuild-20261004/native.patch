+"""workers/memory/compress.py — memory-compress worker.
+
+Per docs/specs/hermes-worker-decomposition-v4.md §5.2:
+  Function: memory::compress
+  Stateless. Takes raw text, returns priority-tagged extraction.
+  Provider chain: MiniMax → gemma4 → Codex (no Anthropic on primary).
+  Phase 1 batch 2 ships with a heuristic placeholder; real LLM provider
+  chain integration lands in Phase 1 batch 3 alongside gateway integration.
+
+Function: memory::compress
+Args:
+    text: str (the source content to compress)
+    target_priority: 'critical' | 'notable' | 'background' | 'auto' (default 'auto')
+                     If 'auto', the worker decides via heuristic (or LLM in batch 3).
+Returns:
+    {"ok": True, "data": {
+        "summary": str,                    # the compressed/extracted observation
+        "priority": "critical|notable|background",
+        "evidence": str,                    # one phrase from input that drove priority
+        "provider": "heuristic-v1",        # batch 3 will report 'minimax'/'gemma4'/'codex'
+        "tokens_in": int,                   # rough estimate
+        "tokens_out": int,
+    }}
+
+Heuristic v1 (placeholder until real LLM):
+  🔴 critical: contains "decision", "MUST", "SHALL", "blocked", "incident", "outage"
+  🟡 notable:  contains "consider", "should", "recommend", "pattern", "lesson"
+  🟢 background: anything else
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+import re
+from typing import Any, Dict, Optional
+
+from .._ipc.envelope import Envelope, ErrorCode
+from .._ipc.server import HandlerError
+
+
+logger = logging.getLogger(__name__)
+
+
+# ───────────────────────────────────────────────────────────────────
+# Heuristic priority extraction (placeholder)
+# ───────────────────────────────────────────────────────────────────
+
+CRITICAL_PATTERNS = (
+    r"\bdecision\b", r"\bMUST\b", r"\bSHALL\b", r"\bblock(?:ed|er)\b",
+    r"\bincident\b", r"\boutage\b", r"\bfail(?:ure|ed)\b",
+    r"\bship(?:ped|ping)?\b", r"\bdeadline\b", r"\burgent\b",
+)
+
+NOTABLE_PATTERNS = (
+    r"\bconsider\b", r"\bshould\b", r"\brecommend\b", r"\bpattern\b",
+    r"\blesson\b", r"\bobservation\b", r"\binsight\b", r"\bpreferred?\b",
+    r"\binteresting\b",
+)
+
+
+def _heuristic_priority(text: str) -> tuple:
+    """Return (priority, evidence_phrase). Walk patterns in order."""
+    for pat in CRITICAL_PATTERNS:
+        m = re.search(pat, text, re.IGNORECASE)
+        if m:
+            return ("critical", m.group(0))
+    for pat in NOTABLE_PATTERNS:
+        m = re.search(pat, text, re.IGNORECASE)
+        if m:
+            return ("notable", m.group(0))
+    return ("background", "")
+
+
+def _placeholder_compress(text: str, target_priority: str) -> Dict[str, Any]:
+    """Stand-in for the LLM call. Returns first sentence as 'summary'."""
+    text = text.strip()
+    if not text:
+        return {"summary": "", "priority": "background", "evidence": "",
+                "provider": "heuristic-v1", "tokens_in": 0, "tokens_out": 0}
+
+    # First sentence-ish (split on . ! ? \n)
+    first = re.split(r"[.!?\n]", text, maxsplit=1)[0].strip()
+    if len(first) > 200:
+        first = first[:197] + "..."
+
+    if target_priority == "auto" or target_priority not in {"critical", "notable", "background"}:
+        priority, evidence = _heuristic_priority(text)
+    else:
+        priority, evidence = target_priority, ""
+
+    return {
+        "summary": first,
+        "priority": priority,
+        "evidence": evidence,
+        "provider": "heuristic-v1",
+        "tokens_in": len(text) // 4,        # rough char-to-token estimate
+        "tokens_out": len(first) // 4,
+    }
+
+
+# ───────────────────────────────────────────────────────────────────
+# Worker
+# ───────────────────────────────────────────────────────────────────
+
+class MemoryCompressWorker:
+    """Stateless memory::compress handler.
+
+    Phase 1 batch 2: heuristic placeholder.
+    Phase 1 batch 3: switches to provider-chain LLM call (MiniMax → gemma4 → Codex)
+                     by importing workers._providers and wrapping the LLM SDK.
+    Contract is stable; impl swaps under it.
+    """
+
+    def __init__(self) -> None:
+        # No state — stateless per spec.
+        self._lock = asyncio.Lock()  # to serialize logging during batch-2 stub
+
+    def open(self) -> None:
+        pass
+
+    def close(self) -> None:
+        pass
+
+    async def handle_compress(self, env: Envelope) -> Dict[str, Any]:
+        text = env.args.get("text")
+        target_priority = str(env.args.get("target_priority", "auto"))
+
+        if not isinstance(text, str):
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                "args.text is required and must be a string",
+                retryable=False,
+            )
+        if target_priority not in {"auto", "critical", "notable", "background"}:
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                f"args.target_priority must be auto|critical|notable|background; got {target_priority!r}",
+                retryable=False,
+            )
+
+        # Placeholder compression. Will swap to provider-chain LLM in batch 3.
+        result = _placeholder_compress(text, target_priority)
+        return {"ok": True, "data": result}
