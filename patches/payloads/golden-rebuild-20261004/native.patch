@@ -0,0 +1,411 @@
+"""workers/memory/anamnesis/store.py — anamnesis_store handler (v8).
+
+Per docs/specs/hermes-worker-decomposition-v8.md §5.2 + §5.1.10.
+
+Implements:
+  Function: memory::store / anamnesis_store
+  Substrate: ~/.anamnesis/memory.db memories table + Qdrant + Ollama
+  Cross-process coordination: SQLite native (BEGIN IMMEDIATE +
+    busy_timeout=5000); NO application file lock (v8 simplification).
+  Idempotency: optional request_id + payload hash; collision returns
+    IDEMPOTENCY_CONFLICT.
+  Vector lifecycle: memory inserted with vector_status='pending';
+    embedding+upsert happens off the critical path; reindex worker
+    handles failures and retries.
+
+Args (anamnesis_store / memory::store):
+    content (str, required) — the memory fact
+    container (str, default 'default') — namespace ('default','work',
+        'personal','research','clients','archive')
+    memory_type (str, default 'general') — typed category
+    priority (str, default 'normal') — critical|notable|background|normal
+    confidence (float, default 0.9)
+    event_date (str, optional ISO date)
+    metadata (dict, optional) — JSON-serialized into memories.metadata
+    entity_refs (list, optional) — for temporal_facts (handled by
+        memory::temporal_add separately; not here)
+    request_id (str, optional) — v8 idempotency key
+
+Returns:
+    {ok: True, data: {memory_id, qdrant_id, vector_status='pending',
+                       is_duplicate (bool), is_idempotent_replay (bool)}}
+
+Errors:
+    INVALID_INPUT — content empty, memory_type/priority invalid, container unknown
+    SCOPE_REQUIRED / INVALID_SCOPE — scope.client_id missing or '_legacy'
+    IDEMPOTENCY_CONFLICT — request_id reused with different payload hash
+    RESOURCE_EXHAUSTED — sqlite busy_timeout exhausted; caller retries
+"""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import logging
+import sqlite3
+import time
+import uuid
+from typing import Any, Dict, Optional
+
+from ..._ipc.envelope import Envelope, ErrorCode
+from ..._ipc.server import HandlerError
+from ..._ipc.suppressions import attach_capability_db, suppress_in_txn
+from .change_detect import check_staleness as _check_staleness
+
+
+logger = logging.getLogger(__name__)
+
+
+VALID_TYPES = {
+    "decision", "person", "lesson", "project",
+    "commitment", "preference", "handoff", "general",
+}
+VALID_PRIORITIES = {"critical", "notable", "background", "normal"}
+VALID_CONTAINERS = {"default", "work", "personal", "research", "clients", "archive"}
+LEGACY_SENTINEL = "_legacy"
+
+
+def _payload_hash(
+    *, client_id: str, container: str, memory_type: str, priority: str,
+    content: str, metadata: Optional[Dict[str, Any]],
+) -> str:
+    """SHA-256 hash over a normalized JSON payload for idempotency dedup.
+
+    Sorted keys, deterministic separators. Trivially-different
+    representations produce identical hashes.
+    """
+    canonical = json.dumps({
+        "client_id": client_id,
+        "container": container,
+        "memory_type": memory_type,
+        "priority": priority,
+        "content": content,
+        "metadata": metadata or {},
+    }, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
+
+class AnamnesisStoreWorker:
+    """memory::store handler. Single-writer-per-table via SQLite native locking."""
+
+    def __init__(self, memory_db_path: str, capability_db_path: str):
+        self.memory_db_path = memory_db_path
+        self.capability_db_path = capability_db_path
+        self._conn: Optional[sqlite3.Connection] = None
+        self._lock = asyncio.Lock()
+
+    def open(self) -> None:
+        """Open sqlite connection. Per-process serialization via asyncio.Lock;
+        cross-process via SQLite BEGIN IMMEDIATE + busy_timeout=5000."""
+        self._conn = sqlite3.connect(
+            self.memory_db_path,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        self._conn.execute("PRAGMA journal_mode=WAL")
+        self._conn.execute("PRAGMA busy_timeout=5000")
+        self._conn.execute("PRAGMA synchronous=NORMAL")
+        self._conn.execute("PRAGMA foreign_keys=ON")
+        # Attach capability-router-usage.db for cross-db suppression writes.
+        attach_capability_db(self._conn, self.capability_db_path)
+
+    def close(self) -> None:
+        if self._conn is not None:
+            self._conn.close()
+            self._conn = None
+
+    async def handle_store(self, env: Envelope) -> Dict[str, Any]:
+        args = env.args
+        content = args.get("content")
+        container = str(args.get("container", "default"))
+        memory_type = str(args.get("memory_type", "general"))
+        priority = str(args.get("priority", "normal"))
+        confidence = float(args.get("confidence", 0.9))
+        event_date = args.get("event_date")
+        metadata = args.get("metadata")
+        request_id = args.get("request_id")
+
+        # Validation
+        if not isinstance(content, str) or not content.strip():
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               "args.content is required (non-empty string)",
+                               retryable=False)
+        if container not in VALID_CONTAINERS:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               f"args.container must be in {sorted(VALID_CONTAINERS)}; got {container!r}",
+                               retryable=False)
+        if memory_type not in VALID_TYPES:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               f"args.memory_type must be in {sorted(VALID_TYPES)}",
+                               retryable=False)
+        if priority not in VALID_PRIORITIES:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               f"args.priority must be in {sorted(VALID_PRIORITIES)}",
+                               retryable=False)
+        if metadata is not None and not isinstance(metadata, dict):
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               "args.metadata must be a dict",
+                               retryable=False)
+
+        # v8 §5.1.9 — _legacy reserved for migration only
+        client_id = env.scope.client_id
+        if client_id == LEGACY_SENTINEL:
+            raise HandlerError(
+                ErrorCode.INVALID_SCOPE,
+                f"client_id={LEGACY_SENTINEL!r} is reserved for migrated rows; "
+                f"new writes require a real client_id",
+                retryable=False,
+            )
+
+        # Build payload hash for idempotency (v8 §5.1.10)
+        request_hash = _payload_hash(
+            client_id=client_id, container=container,
+            memory_type=memory_type, priority=priority,
+            content=content, metadata=metadata,
+        ) if request_id else None
+
+        # Single-writer serialization within this process
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._do_store_sync,
+                client_id, content, container, memory_type, priority,
+                confidence, event_date, metadata, request_id, request_hash,
+            )
+
+    def _do_store_sync(
+        self,
+        client_id: str,
+        content: str,
+        container: str,
+        memory_type: str,
+        priority: str,
+        confidence: float,
+        event_date: Optional[str],
+        metadata: Optional[Dict[str, Any]],
+        request_id: Optional[str],
+        request_hash: Optional[str],
+    ) -> Dict[str, Any]:
+        assert self._conn is not None
+
+        # Prepare row data
+        memory_id = str(uuid.uuid4())
+        qdrant_id = str(uuid.uuid4())  # pre-allocate Qdrant point ID
+        document_date = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+        meta_dict = dict(metadata or {})
+        meta_dict["embedding_model"] = "nomic-embed-text"  # v8: per-row drift detection
+        meta_dict["embedding_dim"] = 768
+        metadata_json = json.dumps(meta_dict, separators=(",", ":"))
+
+        try:
+            # SQLite native locking — BEGIN IMMEDIATE acquires write lock,
+            # busy_timeout=5000 absorbs contention.
+            self._conn.execute("BEGIN IMMEDIATE")
+
+            # 1. v8 §5.1.10 idempotency check (inside txn for serializable read)
+            if request_id is not None:
+                existing = self._conn.execute(
+                    "SELECT memory_id, request_hash FROM memory_request_dedup "
+                    "WHERE client_id = ? AND request_id = ?",
+                    (client_id, request_id),
+                ).fetchone()
+                if existing is not None:
+                    stored_memory_id, stored_hash = existing
+                    self._conn.execute("COMMIT")  # release lock
+                    if stored_hash == request_hash:
+                        # True idempotent retry — return original memory_id
+                        return {"ok": True, "data": {
+                            "memory_id": stored_memory_id,
+                            "is_duplicate": False,
+                            "is_idempotent_replay": True,
+                        }}
+                    else:
+                        # Same request_id, DIFFERENT payload — caller bug
+                        raise HandlerError(
+                            ErrorCode.IDEMPOTENCY_CONFLICT,
+                            f"request_id {request_id!r} reused with different payload hash",
+                            retryable=False,
+                        )
+
+            # 2. Suppression INSERT (cross-db via attached capability db)
+            suppress_in_txn(
+                self._conn,
+                scope="anamnesis.memories",
+                key=memory_id,
+                op="create",
+                issued_by="anamnesis-store",
+                ttl_seconds=5,
+            )
+
+            # 3. INSERT memory row
+            self._conn.execute(
+                """
+                INSERT INTO memories (
+                    id, container_id, content, document_date, event_date,
+                    confidence, qdrant_id, metadata,
+                    client_id, priority, memory_type,
+                    vector_status, vector_status_changed_at, vector_attempt_count
+                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, strftime('%s','now'), 0)
+                """,
+                (memory_id, container, content, document_date, event_date,
+                 confidence, qdrant_id, metadata_json,
+                 client_id, priority, memory_type,
+                 'pending'),
+            )
+
+            # 4. INSERT dedup row if request_id was provided
+            if request_id is not None and request_hash is not None:
+                self._conn.execute(
+                    """
+                    INSERT INTO memory_request_dedup
+                        (client_id, request_id, request_hash, memory_id, created_at_epoch)
+                    VALUES (?, ?, ?, ?, strftime('%s','now'))
+                    """,
+                    (client_id, request_id, request_hash, memory_id),
+                )
+
+            self._conn.execute("COMMIT")
+
+            data: Dict[str, Any] = {
+                "memory_id": memory_id,
+                "qdrant_id": qdrant_id,
+                "vector_status": "pending",
+                "is_duplicate": False,
+                "is_idempotent_replay": False,
+            }
+
+            # Advisory staleness check when caller provides source_uri in metadata.
+            source_uri = (metadata or {}).get("source_uri")
+            if source_uri:
+                try:
+                    content_hash = hashlib.sha256(content.encode()).hexdigest()
+                    stale_info = _check_staleness(self._conn, source_uri, content_hash)
+                    data["is_stale"] = stale_info["stale"]
+                except Exception as exc:  # noqa: BLE001
+                    logger.warning("store: staleness check failed for %s: %s", source_uri, exc)
+                    data["is_stale"] = None
+
+            return {"ok": True, "data": data}
+
+        except sqlite3.OperationalError as exc:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            if "locked" in str(exc).lower() or "busy" in str(exc).lower():
+                raise HandlerError(
+                    ErrorCode.RESOURCE_EXHAUSTED,
+                    f"sqlite busy after busy_timeout: {exc}",
+                    retryable=True,
+                )
+            raise
+        except HandlerError:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            raise
+        except Exception:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            raise
+
+    # ─── anamnesis_temporal_add ────────────────────────────────────────
+
+    VALID_TRIGGER_DIRECTIONS = {"outgoing", "incoming", "both"}
+
+    async def handle_temporal_add(self, env: Envelope) -> Dict[str, Any]:
+        """anamnesis_temporal_add — INSERT temporal_facts triple (v8).
+
+        Args:
+            subject (str, required)
+            predicate (str, required)
+            object (str, required)
+            container (str, default 'default')
+            valid_from (str, optional ISO date)
+            valid_to (str, optional ISO date)
+            confidence (float, default 0.9)
+            source_memory_id (str, optional UUID)
+            source_chunk_id (str, optional UUID)
+            request_id (str, optional, for idempotency)
+        """
+        args = env.args
+        subject = args.get("subject")
+        predicate = args.get("predicate")
+        object_ = args.get("object")
+        container = str(args.get("container", "default"))
+        valid_from = args.get("valid_from")
+        valid_to = args.get("valid_to")
+        confidence = float(args.get("confidence", 0.9))
+        source_memory_id = args.get("source_memory_id")
+        source_chunk_id = args.get("source_chunk_id")
+
+        for k, v in (("subject", subject), ("predicate", predicate), ("object", object_)):
+            if not isinstance(v, str) or not v.strip():
+                raise HandlerError(ErrorCode.INVALID_INPUT,
+                                   f"args.{k} required (non-empty string)",
+                                   retryable=False)
+
+        if container not in {"default", "work", "personal", "research", "clients", "archive"}:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               f"args.container invalid: {container!r}",
+                               retryable=False)
+
+        client_id = env.scope.client_id
+        if client_id == LEGACY_SENTINEL:
+            raise HandlerError(ErrorCode.INVALID_SCOPE,
+                               f"client_id={LEGACY_SENTINEL!r} is reserved for migrated rows",
+                               retryable=False)
+
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._do_temporal_add_sync,
+                subject, predicate, object_, container,
+                valid_from, valid_to, confidence,
+                source_memory_id, source_chunk_id, client_id,
+            )
+
+    def _do_temporal_add_sync(
+        self,
+        subject: str, predicate: str, object_: str, container: str,
+        valid_from: Optional[str], valid_to: Optional[str], confidence: float,
+        source_memory_id: Optional[str], source_chunk_id: Optional[str],
+        client_id: str,
+    ) -> Dict[str, Any]:
+        assert self._conn is not None
+        fact_id = str(uuid.uuid4())
+        try:
+            self._conn.execute("BEGIN IMMEDIATE")
+            self._conn.execute(
+                """
+                INSERT INTO temporal_facts
+                    (id, subject, predicate, object, container_id,
+                     source_memory_id, source_chunk_id,
+                     valid_from, valid_to, confidence, client_id)
+                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+                """,
+                (fact_id, subject, predicate, object_, container,
+                 source_memory_id, source_chunk_id,
+                 valid_from, valid_to, confidence, client_id),
+            )
+            self._conn.execute("COMMIT")
+            return {"ok": True, "data": {
+                "fact_id": fact_id,
+                "subject": subject, "predicate": predicate, "object": object_,
+            }}
+        except sqlite3.OperationalError as exc:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            if "locked" in str(exc).lower() or "busy" in str(exc).lower():
+                raise HandlerError(ErrorCode.RESOURCE_EXHAUSTED,
+                                   f"sqlite busy: {exc}", retryable=True)
+            raise
+        except Exception:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            raise
