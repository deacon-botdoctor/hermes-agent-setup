index 0000000000000000000000000000000000000000..8ea4845a22e47003a6f6a9ebdb266f2bbada0c13
--- /dev/null
+++ b/workers/memory/anamnesis/external.py
@@ -0,0 +1,324 @@
+"""workers/memory/anamnesis/external.py — Ollama + OpenAI + Qdrant clients (v8).
+
+Per docs/specs/hermes-worker-decomposition-v8.md §5.9 + Phase 5.7b.
+
+Real httpx-free implementations matching the EmbedClient / VectorStoreClient
+Protocols from vector_reindex.py. Uses urllib (stdlib only — no httpx
+dependency) so the workers package stays lean.
+
+Embed providers:
+- OllamaEmbedClient — local Ollama HTTP, native /api/embed shape
+- OpenAIEmbedClient — OpenAI-compatible /v1/embeddings (works with OpenAI
+  AND OpenRouter via the same response shape; this is what production Doc
+  uses with EMBED_MODEL=openai/text-embedding-3-small via OpenRouter)
+
+Posture flags:
+- HERMES_EMBED_PROVIDER  (ollama|openai; default ollama)
+- HERMES_OLLAMA_URL      (default http://localhost:11434)
+- HERMES_OLLAMA_AUTH_TOKEN  (optional)
+- HERMES_OPENAI_EMBED_URL   (e.g. https://openrouter.ai/api/v1/embeddings)
+- HERMES_OPENAI_EMBED_API_KEY (or HERMES_OPENROUTER_API_KEY / OPENROUTER_API_KEY fallbacks)
+- HERMES_EMBED_MODEL     (model id; defaults differ per provider)
+- HERMES_QDRANT_URL      (default http://localhost:6333)
+- HERMES_QDRANT_COLLECTION (default anamnesis_memories)
+
+Falls through to NullEmbedClient / NullVectorClient when nothing is wired.
+Memory writes still succeed in that case (vector_status='pending' captures
+unprocessed rows; reindex worker drains when services return).
+
+Phase 5.7a finding: the OLD anamnesis-local server silently dropped Doc's
+upserts because Qdrant returns `200 acknowledged` for dim-mismatched points.
+QdrantClient._upsert_sync now uses ?wait=true and verifies the
+response status is `completed`, surfacing dim mismatches as RuntimeError.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import os
+import urllib.error
+import urllib.request
+from typing import List, Optional
+
+
+logger = logging.getLogger(__name__)
+
+
+DEFAULT_OLLAMA_URL = "http://localhost:11434"
+DEFAULT_QDRANT_URL = "http://localhost:6333"
+DEFAULT_OPENAI_EMBED_URL = "https://api.openai.com/v1/embeddings"
+DEFAULT_OLLAMA_EMBED_MODEL = "nomic-embed-text"
+DEFAULT_OPENAI_EMBED_MODEL = "openai/text-embedding-3-small"
+# Back-compat alias (some callers imported this name)
+DEFAULT_EMBED_MODEL = DEFAULT_OLLAMA_EMBED_MODEL
+DEFAULT_QDRANT_COLLECTION = "anamnesis_memories"
+DEFAULT_EMBED_DIM = 768
+DEFAULT_TIMEOUT = 30.0
+
+
+# ─────────────────────────────────────────────────────────────────
+# Real Ollama embed client (urllib-based; no httpx dep)
+# ─────────────────────────────────────────────────────────────────
+
+class OllamaEmbedClient:
+    def __init__(
+        self,
+        *,
+        base_url: str = DEFAULT_OLLAMA_URL,
+        model: str = DEFAULT_EMBED_MODEL,
+        auth_token: Optional[str] = None,
+        timeout: float = DEFAULT_TIMEOUT,
+    ):
+        self.base_url = base_url.rstrip("/")
+        self.model = model
+        self.auth_token = auth_token
+        self.timeout = timeout
+
+    async def embed(self, text: str) -> List[float]:
+        loop = asyncio.get_running_loop()
+        return await loop.run_in_executor(None, self._embed_sync, text)
+
+    def _embed_sync(self, text: str) -> List[float]:
+        url = f"{self.base_url}/api/embed"
+        body = json.dumps({"model": self.model, "input": text}).encode("utf-8")
+        headers = {"Content-Type": "application/json"}
+        if self.auth_token:
+            headers["Authorization"] = f"Bearer {self.auth_token}"
+
+        req = urllib.request.Request(url, data=body, headers=headers, method="POST")
+        try:
+            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
+                payload = json.loads(resp.read())
+        except urllib.error.HTTPError as exc:
+            raise RuntimeError(f"ollama HTTP {exc.code}: {exc.reason}") from exc
+        except urllib.error.URLError as exc:
+            raise RuntimeError(f"ollama unreachable: {exc.reason}") from exc
+
+        embeddings = payload.get("embeddings") or []
+        if not embeddings or not isinstance(embeddings, list):
+            raise RuntimeError(f"ollama returned no embeddings: {payload}")
+        return embeddings[0]
+
+
+# ─────────────────────────────────────────────────────────────────
+# OpenAI-compatible embed client (works with OpenAI + OpenRouter)
+# ─────────────────────────────────────────────────────────────────
+
+class OpenAIEmbedClient:
+    """OpenAI-compatible /v1/embeddings client.
+
+    Works with OpenAI (api.openai.com) and any compatible gateway including
+    OpenRouter (openrouter.ai/api/v1). Production Doc on Spark uses this via
+    OpenRouter with model=openai/text-embedding-3-small (1536 dim).
+
+    Phase 5.7a context: the OLD anamnesis-local server.py used the same API
+    shape but silently dropped Qdrant upserts due to dim mismatch + lack of
+    ?wait=true (handled by the v8 QdrantClient below).
+    """
+
+    def __init__(
+        self,
+        *,
+        base_url: str = DEFAULT_OPENAI_EMBED_URL,
+        model: str = DEFAULT_OPENAI_EMBED_MODEL,
+        api_key: Optional[str] = None,
+        timeout: float = DEFAULT_TIMEOUT,
+    ):
+        self.base_url = base_url.rstrip("/")
+        self.model = model
+        self.api_key = api_key
+        self.timeout = timeout
+
+    async def embed(self, text: str) -> List[float]:
+        loop = asyncio.get_running_loop()
+        return await loop.run_in_executor(None, self._embed_sync, text)
+
+    def _embed_sync(self, text: str) -> List[float]:
+        body = json.dumps({"model": self.model, "input": text}).encode("utf-8")
+        headers = {"Content-Type": "application/json"}
+        if self.api_key:
+            headers["Authorization"] = f"Bearer {self.api_key}"
+        req = urllib.request.Request(self.base_url, data=body, headers=headers, method="POST")
+        try:
+            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
+                payload = json.loads(resp.read())
+        except urllib.error.HTTPError as exc:
+            raise RuntimeError(
+                f"openai embed HTTP {exc.code}: {exc.reason}"
+            ) from exc
+        except urllib.error.URLError as exc:
+            raise RuntimeError(f"openai embed unreachable: {exc.reason}") from exc
+
+        data = payload.get("data") or []
+        if not data or "embedding" not in data[0]:
+            raise RuntimeError(f"openai embed returned no embedding: {payload}")
+        return data[0]["embedding"]
+
+
+# ─────────────────────────────────────────────────────────────────
+# Real Qdrant vector store client
+# ─────────────────────────────────────────────────────────────────
+
+class QdrantClient:
+    def __init__(
+        self,
+        *,
+        base_url: str = DEFAULT_QDRANT_URL,
+        collection: str = DEFAULT_QDRANT_COLLECTION,
+        timeout: float = DEFAULT_TIMEOUT,
+    ):
+        self.base_url = base_url.rstrip("/")
+        self.collection = collection
+        self.timeout = timeout
+
+    async def upsert(
+        self,
+        *,
+        point_id: str,
+        embedding: List[float],
+        memory_id: str,
+        content: str,
+        container_id: str,
+    ) -> None:
+        loop = asyncio.get_running_loop()
+        return await loop.run_in_executor(
+            None, self._upsert_sync,
+            point_id, embedding, memory_id, content, container_id,
+        )
+
+    def _upsert_sync(
+        self, point_id: str, embedding: List[float],
+        memory_id: str, content: str, container_id: str,
+    ) -> None:
+        # Phase 5.7a: ?wait=true forces Qdrant to return the operation status
+        # synchronously. Without it, dim-mismatched upserts return 200
+        # `acknowledged` but the point is silently dropped — exactly what bit
+        # Doc anamnesis in production for ~3 weeks.
+        url = f"{self.base_url}/collections/{self.collection}/points?wait=true"
+        body = json.dumps({
+            "points": [{
+                "id": point_id,
+                "vector": embedding,
+                "payload": {
+                    "memory_id": memory_id,
+                    "content": content,
+                    "container_id": container_id,
+                },
+            }]
+        }).encode("utf-8")
+        req = urllib.request.Request(
+            url, data=body, method="PUT",
+            headers={"Content-Type": "application/json"},
+        )
+        try:
+            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
+                if resp.status >= 400:
+                    raise RuntimeError(f"qdrant upsert HTTP {resp.status}")
+                payload = json.loads(resp.read())
+        except urllib.error.HTTPError as exc:
+            raise RuntimeError(f"qdrant upsert HTTP {exc.code}: {exc.reason}") from exc
+        except urllib.error.URLError as exc:
+            raise RuntimeError(f"qdrant unreachable: {exc.reason}") from exc
+
+        # With ?wait=true, status moves from "acknowledged" to "completed".
+        # Anything else (most commonly dim mismatch) means the point did NOT land.
+        status = payload.get("result", {}).get("status")
+        if status != "completed":
+            raise RuntimeError(
+                f"qdrant upsert not completed: status={status!r} "
+                f"payload={payload!r}"
+            )
+
+    async def health_check(self) -> bool:
+        loop = asyncio.get_running_loop()
+        return await loop.run_in_executor(None, self._health_check_sync)
+
+    def _health_check_sync(self) -> bool:
+        url = f"{self.base_url}/collections/{self.collection}"
+        try:
+            with urllib.request.urlopen(url, timeout=5.0) as resp:
+                return resp.status == 200
+        except (urllib.error.HTTPError, urllib.error.URLError, OSError):
+            return False
+
+
+# ─────────────────────────────────────────────────────────────────
+# Null clients (used when external services unavailable)
+# ─────────────────────────────────────────────────────────────────
+
+class NullEmbedClient:
+    """No-op embed client. Raises so reindex worker can mark row 'failed'
+    and try again later when real Ollama returns."""
+
+    async def embed(self, text: str) -> List[float]:
+        raise RuntimeError("Ollama embedding service not configured")
+
+
+class NullVectorClient:
+    """No-op vector client. Memory still committed to sqlite (FTS works);
+    vector indexing pending until real Qdrant returns."""
+
+    async def upsert(
+        self, *, point_id, embedding, memory_id, content, container_id,
+    ) -> None:
+        raise RuntimeError("Qdrant vector store not configured")
+
+    async def health_check(self) -> bool:
+        return False
+
+
+# ─────────────────────────────────────────────────────────────────
+# Factory
+# ─────────────────────────────────────────────────────────────────
+
+def make_embed_client_from_env():
+    """Build an embed client from env. Provider chosen by HERMES_EMBED_PROVIDER
+    (ollama|openai). Falls through to Null when nothing is wired."""
+    provider = os.environ.get("HERMES_EMBED_PROVIDER", "ollama").strip().lower()
+
+    if provider == "openai":
+        url = os.environ.get(
+            "HERMES_OPENAI_EMBED_URL", DEFAULT_OPENAI_EMBED_URL,
+        ).strip()
+        api_key = (
+            os.environ.get("HERMES_OPENAI_EMBED_API_KEY")
+            or os.environ.get("HERMES_OPENROUTER_API_KEY")
+            or os.environ.get("OPENROUTER_API_KEY")
+            or os.environ.get("OPENAI_API_KEY")
+            or ""
+        )
+        if not url or url.lower() == "null" or not api_key:
+            logger.warning(
+                "openai embed provider missing url/key → using NullEmbedClient"
+            )
+            return NullEmbedClient()
+        return OpenAIEmbedClient(
+            base_url=url,
+            model=os.environ.get(
+                "HERMES_EMBED_MODEL", DEFAULT_OPENAI_EMBED_MODEL,
+            ),
+            api_key=api_key,
+        )
+
+    # default: ollama
+    url = os.environ.get("HERMES_OLLAMA_URL", DEFAULT_OLLAMA_URL).strip()
+    if not url or url.lower() == "null":
+        logger.warning("HERMES_OLLAMA_URL=%r → using NullEmbedClient", url)
+        return NullEmbedClient()
+    return OllamaEmbedClient(
+        base_url=url,
+        model=os.environ.get("HERMES_EMBED_MODEL", DEFAULT_OLLAMA_EMBED_MODEL),
+        auth_token=os.environ.get("HERMES_OLLAMA_AUTH_TOKEN") or None,
+    )
+
+
+def make_vector_client_from_env() -> "QdrantClient | NullVectorClient":
+    url = os.environ.get("HERMES_QDRANT_URL", DEFAULT_QDRANT_URL).strip()
+    if not url or url.lower() == "null":
+        logger.warning("HERMES_QDRANT_URL=%r → using NullVectorClient", url)
+        return NullVectorClient()
+    return QdrantClient(
+        base_url=url,
+        collection=os.environ.get("HERMES_QDRANT_COLLECTION", DEFAULT_QDRANT_COLLECTION),
+    )
diff --git a/workers/memory/anamnesis/ingest_daemon.py b/workers/memory/anamnesis/ingest_daemon.py
new file mode 100644
index 0000000000000000000000000000000000000000..d50171b6636eeb5dcf7e8f91c360d5f1f0c2382e
--- /dev/null
+++ b/workers/memory/anamnesis/ingest_daemon.py
@@ -0,0 +1,721 @@
+"""workers/memory/anamnesis/ingest_daemon.py — standalone session-ingestion daemon.
+
+Restores durable memory capture that broke 2026-04-24 when the
+`session-resume`/`telegram-transcript` durable-memory hooks were retired.
+After that retirement, no replacement was wired up — sessions accumulated
+in jsonl files but nothing wrote them into anamnesis. v8 cutover migrated
+existing rows but did not restore ingestion.
+
+Architecture mirrors reindex_daemon.py (Phase 5.7h sibling-daemon pattern):
+the gateway opens stdio to MCP servers only as needed and closes between
+calls, so any in-shim background work dies. Long-running ingestion needs
+a dedicated process under platform-native service management.
+
+What it does:
+  - Watches HERMES_HOME/sessions/*.jsonl for new conversation turns
+  - Writes each user/assistant/tool turn into anamnesis chunks table
+  - When --extract-memories is on, runs the heuristic compress worker on
+    assistant turns and writes priority>=notable observations into memories
+    (with vector_status='pending' so reindex_daemon picks them up)
+  - Tracks per-file byte offset in a state file; resumes after restart
+  - Appends a row to ingestion_log per batch for observability
+
+Usage:
+    python -m workers.memory.anamnesis.ingest_daemon \\
+        --memory-db ~/.anamnesis/memory.db \\
+        --capability-db ~/.hermes/state/capability-router-usage.db \\
+        --sessions-dir ~/.hermes/sessions \\
+        --state-file ~/.anamnesis/ingest-daemon-state.json \\
+        --container clients \\
+        [--interval 30] [--extract-memories] [--log-level INFO]
+
+Env:
+    HERMES_CLIENT_ID    required — client_id stamped on every row
+    HERMES_PROFILE_ID   optional — defaults to client_id
+
+Cleanly handles SIGTERM / SIGINT — finishes the current batch, persists
+state, exits.
+"""
+from __future__ import annotations
+
+import argparse
+import asyncio
+import hashlib
+import json
+import logging
+import os
+import re
+import signal
+import sqlite3
+import sys
+import time
+import uuid
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Dict, Optional, Tuple
+
+logger = logging.getLogger("anamnesis.ingest_daemon")
+
+VALID_CONTAINERS = {"default", "work", "personal", "research", "clients", "archive"}
+INGEST_ROLES = {"user", "assistant", "tool"}
+
+# Memory routing gate — fail open if unavailable.
+try:
+    _GATE_DIR = str(Path.home() / ".hermes" / "mcp-servers" / "anamnesis")
+    if _GATE_DIR not in sys.path:
+        sys.path.insert(0, _GATE_DIR)
+    from memory_router import classify as _gate_classify  # noqa: E402
+    from memory_routing_declarations import may_write_to_anamnesis as _gate_allows_store  # noqa: E402
+    _GATE_OK = True
+except Exception:
+    _GATE_OK = False
+
+
+def _gate_env_truthy(name: str, default: str = "") -> bool:
+    return os.environ.get(name, default).strip().lower() in ("1", "true", "yes", "on")
+
+
+def _memory_gate_ok(content: str, role: str = "assistant") -> bool:
+    """True if the content may be written to the anamnesis memories table.
+
+    Source is derived from the message role: user turns are explicit
+    instructions, assistant/tool turns are observed output.
+    """
+    if not _GATE_OK or _gate_env_truthy("HERMES_MEMORY_GATE_BYPASS", ""):
+        return True
+    if not _gate_env_truthy("HERMES_MEMORY_GATE_ENFORCE", "1"):
+        return True
+    source = "explicit_user_instruction" if role == "user" else "observed_tool_output"
+    cls = _gate_classify(content, {"source": source})
+    if _gate_allows_store(cls.scope):
+        return True
+    logger.info("memory_gate reject:%s reason=%s content=%s", cls.scope, cls.reason, content[:80])
+    return False
+
+# Heuristic compression — same patterns as workers/memory/compress.py
+# Phase 1 stays heuristic; provider-chain LLM lands in a follow-up.
+_CRITICAL_PATTERNS = re.compile(
+    r"\b(decision|MUST|SHALL|blocked|incident|outage|critical|deadline|"
+    r"production down|p0|p1|escalat\w*)\b",
+    re.IGNORECASE,
+)
+_NOTABLE_PATTERNS = re.compile(
+    r"\b(consider|should|recommend|pattern|lesson|learned|takeaway|"
+    r"next step|follow.?up|todo|reminder|note)\b",
+    re.IGNORECASE,
+)
+
+
+@dataclass
+class BatchStats:
+    files_seen: int = 0
+    files_with_new: int = 0
+    chunks_written: int = 0
+    memories_written: int = 0
+    skipped_dupes: int = 0
+    errors: int = 0
+    elapsed_ms: int = 0
+
+
+@dataclass
+class IngestState:
+    files: Dict[str, Dict[str, Any]] = field(default_factory=dict)
+    last_run: Optional[str] = None
+
+
+def _now_iso() -> str:
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def _now_epoch() -> int:
+    return int(time.time())
+
+
+def _deterministic_chunk_id(session_id: str, line_offset: int) -> str:
+    """Stable id from (session, offset) so re-running the daemon never
+    produces duplicate chunks for the same line."""
+    h = hashlib.sha256(f"{session_id}:{line_offset}".encode("utf-8")).hexdigest()
+    # Format as UUID
+    return f"{h[:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:32]}"
+
+
+def _deterministic_memory_id(session_id: str, line_offset: int, summary: str) -> str:
+    h = hashlib.sha256(
+        f"{session_id}:{line_offset}:{summary}".encode("utf-8")
+    ).hexdigest()
+    return f"{h[:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:32]}"
+
+
+def _heuristic_priority(text: str) -> Tuple[str, str]:
+    """Return (priority, evidence_phrase). Mirrors compress.py heuristic."""
+    if not text:
+        return "background", ""
+    m = _CRITICAL_PATTERNS.search(text)
+    if m:
+        return "critical", m.group(0)
+    m = _NOTABLE_PATTERNS.search(text)
+    if m:
+        return "notable", m.group(0)
+    return "background", ""
+
+
+def _open_memory_db(path: str) -> sqlite3.Connection:
+    conn = sqlite3.connect(path, isolation_level=None, check_same_thread=False)
+    conn.execute("PRAGMA journal_mode=WAL")
+    conn.execute("PRAGMA busy_timeout=5000")
+    conn.execute("PRAGMA synchronous=NORMAL")
+    conn.execute("PRAGMA foreign_keys=ON")
+    return conn
+
+
+def _load_state(state_file: Path) -> IngestState:
+    if not state_file.exists():
+        return IngestState()
+    try:
+        data = json.loads(state_file.read_text())
+        return IngestState(
+            files=data.get("files", {}),
+            last_run=data.get("last_run"),
+        )
+    except (json.JSONDecodeError, OSError) as exc:
+        logger.warning("state file unreadable (%s) — starting fresh", exc)
+        return IngestState()
+
+
+def _save_state(state_file: Path, state: IngestState) -> None:
+    state_file.parent.mkdir(parents=True, exist_ok=True)
+    payload = {"files": state.files, "last_run": _now_iso()}
+    tmp = state_file.with_suffix(state_file.suffix + ".tmp")
+    tmp.write_text(json.dumps(payload, indent=2))
+    tmp.replace(state_file)
+
+
+def _extract_content(line_obj: Dict[str, Any]) -> Optional[str]:
+    content = line_obj.get("content")
+    if content is None:
+        return None
+    if isinstance(content, str):
+        return content.strip() or None
+    # Some assistant turns may have list-of-parts content
+    if isinstance(content, list):
+        text_parts = []
+        for part in content:
+            if isinstance(part, str):
+                text_parts.append(part)
+            elif isinstance(part, dict):
+                t = part.get("text") or part.get("content")
+                if isinstance(t, str):
+                    text_parts.append(t)
+        joined = "\n".join(text_parts).strip()
+        return joined or None
+    return None
+
+
+def _ingest_one_file(
+    conn: sqlite3.Connection,
+    jsonl_path: Path,
+    state: IngestState,
+    container: str,
+    client_id: str,
+    extract_memories: bool,
+    stats: BatchStats,
+) -> int:
+    """Ingest new lines from one session jsonl. Returns end byte offset."""
+    fname = jsonl_path.name
+    file_state = state.files.setdefault(fname, {"offset": 0, "lines_processed": 0})
+    last_offset = int(file_state.get("offset") or 0)
+
+    fsize = jsonl_path.stat().st_size
+    if fsize <= last_offset:
+        return last_offset
+
+    session_id = jsonl_path.stem  # e.g. 20260427_150558_6466ebaf
+    document_date = _now_iso()
+    new_chunks = 0
+    new_memories = 0
+    line_offsets: list = []
+
+    with jsonl_path.open("r", encoding="utf-8") as f:
+        f.seek(last_offset)
+        while True:
+            offset_before = f.tell()
+            line = f.readline()
+            if not line:
+                break
+            if not line.endswith("\n"):
+                # Partial line — file is being written. Stop here; resume next
+                # batch from offset_before.
+                break
+
+            try:
+                obj = json.loads(line)
+            except json.JSONDecodeError:
+                stats.errors += 1
+                continue
+
+            role = obj.get("role")
+            if role not in INGEST_ROLES:
+                continue
+
+            content = _extract_content(obj)
+            if not content:
+                continue
+
+            # 1) Insert chunk (deterministic id)
+            chunk_id = _deterministic_chunk_id(session_id, offset_before)
+            try:
+                conn.execute("BEGIN IMMEDIATE")
+                cur = conn.execute(
+                    """
+                    INSERT OR IGNORE INTO chunks
+                        (id, session_id, container_id, document_date,
+                         role, content, client_id, created_at, metadata)
+                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
+                    """,
+                    (
+                        chunk_id, session_id, container, document_date,
+                        role, content, client_id, document_date,
+                        json.dumps({"line_offset": offset_before}),
+                    ),
+                )
+                if cur.rowcount > 0:
+                    new_chunks += 1
+                else:
+                    stats.skipped_dupes += 1
+
+                # 2) Optional memory extraction on assistant + user turns
+                if extract_memories and role in ("assistant", "user"):
+                    priority, evidence = _heuristic_priority(content)
+                    if priority in ("critical", "notable") and _memory_gate_ok(content, role):
+                        memory_id = _deterministic_memory_id(
+                            session_id, offset_before, content[:200]
+                        )
+                        qdrant_id = str(uuid.uuid4())
+                        meta = {
+                            "source": "ingest_daemon",
+                            "session_id": session_id,
+                            "line_offset": offset_before,
+                            "evidence": evidence,
+                            "role": role,
+                            # store.py drift-detection fields (kept for compatibility;
+                            # actual embedding done by reindex_daemon).
+                            "embedding_model": "openai/text-embedding-3-small",
+                            "embedding_dim": 1536,
+                        }
+                        cur = conn.execute(
+                            """
+                            INSERT OR IGNORE INTO memories
+                                (id, container_id, chunk_id, content,
+                                 document_date, confidence, qdrant_id, metadata,
+                                 client_id, priority, memory_type,
+                                 vector_status, vector_status_changed_at,
+                                 vector_attempt_count)
+                            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
+                                    'pending', strftime('%s','now'), 0)
+                            """,
+                            (
+                                memory_id, container, chunk_id, content,
+                                document_date, 0.7, qdrant_id, json.dumps(meta),
+                                client_id, priority, "general",
+                            ),
+                        )
+                        if cur.rowcount > 0:
+                            new_memories += 1
+                conn.execute("COMMIT")
+            except sqlite3.OperationalError as exc:
+                try:
+                    conn.execute("ROLLBACK")
+                except sqlite3.Error:
+                    pass
+                logger.warning("sqlite busy on %s line %d: %s",
+                               fname, offset_before, exc)
+                stats.errors += 1
+                # Stop this file; retry next batch
+                break
+            except Exception as exc:
+                try:
+                    conn.execute("ROLLBACK")
+                except sqlite3.Error:
+                    pass
+                logger.warning("ingest error on %s line %d: %s",
+                               fname, offset_before, exc)
+                stats.errors += 1
+                continue
+
+            line_offsets.append(offset_before)
+
+        end_offset = f.tell()
+
+    file_state["offset"] = end_offset
+    file_state["lines_processed"] = (
+        int(file_state.get("lines_processed") or 0) + len(line_offsets)
+    )
+    file_state["last_seen"] = _now_iso()
+
+    if new_chunks or new_memories:
+        # Append observability row per file with new content
+        try:
+            conn.execute(
+                """
+                INSERT INTO ingestion_log
+                    (id, session_id, container_id, turn_index,
+                     memories_created, memories_updated, memories_derived,
+                     chunks_created, extraction_model, extraction_ms,
+                     embedding_ms, total_ms, created_at)
+                VALUES (?, ?, ?, ?, ?, 0, 0, ?, 'heuristic-v1', 0, 0, ?, ?)
+                """,
+                (
+                    str(uuid.uuid4()), session_id, container,
+                    len(line_offsets), new_memories, new_chunks,
+                    0,  # total_ms — set by caller via stats.elapsed_ms aggregation
+                    _now_iso(),
+                ),
+            )
+        except sqlite3.Error as exc:
+            logger.warning("ingestion_log insert failed: %s", exc)
+        stats.files_with_new += 1
+        stats.chunks_written += new_chunks
+        stats.memories_written += new_memories
+
+    return end_offset
+
+
+
+# ===================== [HERMES_ANAMNESIS_STATEDB_INGEST_v1] =====================
+# state.db.messages ingestion. The gateway stopped emitting legacy
+# sessions/*.jsonl ~2026-05-26; conversations now live only in
+# ~/.hermes/state.db. We read new message rows incrementally (resumable by
+# max message id) and write the same chunks/memories the jsonl path did.
+# Deterministic ids (session_id:msg_id) make this idempotent + re-runnable.
+
+def _discover_state_db(sessions_dir: Path) -> Optional[Path]:
+    """state.db sits next to the sessions/ dir: <home>/.hermes/state.db."""
+    cand = sessions_dir.parent / "state.db"
+    return cand if cand.exists() else None
+
+
+def _statedb_chunk_id(session_id: str, msg_id: int) -> str:
+    h = hashlib.sha256(f"statedb:{session_id}:{msg_id}".encode("utf-8")).hexdigest()
+    return f"{h[:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:32]}"
+
+
+def _statedb_memory_id(session_id: str, msg_id: int, summary: str) -> str:
+    h = hashlib.sha256(
+        f"statedb:{session_id}:{msg_id}:{summary}".encode("utf-8")
+    ).hexdigest()
+    return f"{h[:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:32]}"
+
+
+def _ingest_state_db(
+    conn: sqlite3.Connection,
+    state_db_path: Path,
+    state: IngestState,
+    container: str,
+    client_id: str,
+    extract_memories: bool,
+    stats: BatchStats,
+    since_ts: float,
+) -> None:
+    """Read new rows from state.db.messages and write chunks/memories.
+
+    Resumable: we persist the max message id consumed under the synthetic
+    state-file key "__state_db__". `since_ts` is a hard floor (unix seconds)
+    so a first run only backfills the gap after existing jsonl-derived chunks
+    rather than re-chunking ancient history already covered.
+    """
+    sd_state = state.files.setdefault("__state_db__", {"last_id": 0})
+    last_id = int(sd_state.get("last_id") or 0)
+
+    src = sqlite3.connect(f"file:{state_db_path}?mode=ro", uri=True)
+    src.row_factory = sqlite3.Row
+    try:
+        rows = src.execute(
+            """
+            SELECT m.id, m.session_id, m.role, m.content, m.timestamp
+            FROM messages m
+            WHERE m.id > ?
+              AND m.timestamp >= ?
+              AND m.role IN ('user','assistant','tool')
+            ORDER BY m.id ASC
+            LIMIT 5000
+            """,
+            (last_id, since_ts),
+        ).fetchall()
+    except sqlite3.Error as exc:
+        logger.warning("state.db read failed: %s", exc)
+        src.close()
+        return
+    src.close()
+
+    stats.files_seen += 1  # count state.db as one "source"
+    new_chunks = 0
+    new_memories = 0
+    max_id = last_id
+
+    for row in rows:
+        msg_id = int(row["id"])
+        max_id = max(max_id, msg_id)
+        role = row["role"]
+        content = (row["content"] or "").strip()
+        if not content:
+            continue
+        session_id = row["session_id"] or "unknown"
+        # message timestamp (unix seconds) -> ISO document_date so recency
+        # scoring reflects when the turn actually happened, not ingest time.
+        try:
+            doc_date = time.strftime(
+                "%Y-%m-%dT%H:%M:%SZ", time.gmtime(float(row["timestamp"]))
+            )
+        except (ValueError, TypeError, OSError):
+            doc_date = _now_iso()
+
+        chunk_id = _statedb_chunk_id(session_id, msg_id)
+        try:
+            conn.execute("BEGIN IMMEDIATE")
+            cur = conn.execute(
+                """
+                INSERT OR IGNORE INTO chunks
+                    (id, session_id, container_id, document_date,
+                     role, content, client_id, created_at, metadata)
+                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
+                """,
+                (
+                    chunk_id, session_id, container, doc_date,
+                    role, content, client_id, _now_iso(),
+                    json.dumps({"source": "state_db", "msg_id": msg_id}),
+                ),
+            )
+            if cur.rowcount > 0:
+                new_chunks += 1
+            else:
+                stats.skipped_dupes += 1
+
+            if extract_memories and role in ("assistant", "user"):
+                priority, evidence = _heuristic_priority(content)
+                if priority in ("critical", "notable") and _memory_gate_ok(content, role):
+                    memory_id = _statedb_memory_id(session_id, msg_id, content[:200])
+                    qdrant_id = str(uuid.uuid4())
+                    meta = {
+                        "source": "ingest_daemon_statedb",
+                        "session_id": session_id,
+                        "msg_id": msg_id,
+                        "evidence": evidence,
+                        "role": role,
+                        "embedding_model": "openai/text-embedding-3-small",
+                        "embedding_dim": 1536,
+                    }
+                    cur = conn.execute(
+                        """
+                        INSERT OR IGNORE INTO memories
+                            (id, container_id, chunk_id, content,
+                             document_date, confidence, qdrant_id, metadata,
+                             client_id, priority, memory_type,
+                             vector_status, vector_status_changed_at,
+                             vector_attempt_count)
+                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
+                                'pending', strftime('%s','now'), 0)
+                        """,
+                        (
+                            memory_id, container, chunk_id, content,
+                            doc_date, 0.7, qdrant_id, json.dumps(meta),
+                            client_id, priority, "general",
+                        ),
+                    )
+                    if cur.rowcount > 0:
+                        new_memories += 1
+            conn.execute("COMMIT")
+        except sqlite3.OperationalError as exc:
+            try:
+                conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            logger.warning("state.db chunk write busy at msg %d: %s", msg_id, exc)
+            stats.errors += 1
+            break  # resume next batch from last committed id
+        except Exception as exc:
+            try:
+                conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            logger.warning("state.db chunk write error at msg %d: %s", msg_id, exc)
+            stats.errors += 1
+            continue
+
+    sd_state["last_id"] = max_id
+    if new_chunks or new_memories:
+        try:
+            conn.execute(
+                """
+                INSERT INTO ingestion_log
+                    (id, session_id, container_id, turn_index,
+                     memories_created, memories_updated, memories_derived,
+                     chunks_created, extraction_model, extraction_ms,
+                     embedding_ms, total_ms, created_at)
+                VALUES (?, 'state_db', ?, ?, ?, 0, 0, ?, 'statedb-heuristic-v1', 0, 0, 0, ?)
+                """,
+                (
+                    str(uuid.uuid4()), container, len(rows),
+                    new_memories, new_chunks, _now_iso(),
+                ),
+            )
+        except sqlite3.Error as exc:
+            logger.warning("ingestion_log (state_db) insert failed: %s", exc)
+        stats.files_with_new += 1
+        stats.chunks_written += new_chunks
+        stats.memories_written += new_memories
+# =================== end [HERMES_ANAMNESIS_STATEDB_INGEST_v1] ===================
+
+async def _run_one_batch(
+    memory_db: str,
+    sessions_dir: Path,
+    state_file: Path,
+    container: str,
+    client_id: str,
+    extract_memories: bool,
+) -> BatchStats:
+    stats = BatchStats()
+    started = time.time()
+    state = _load_state(state_file)
+
+    if not sessions_dir.exists():
+        logger.debug("sessions dir %s does not exist yet", sessions_dir)
+        stats.elapsed_ms = int((time.time() - started) * 1000)
+        return stats
+
+    conn = _open_memory_db(memory_db)
+    try:
+        files = sorted(sessions_dir.glob("*.jsonl"))
+        stats.files_seen = len(files)
+        for jsonl_path in files:
+            try:
+                _ingest_one_file(
+                    conn, jsonl_path, state,
+                    container, client_id, extract_memories,
+                    stats,
+                )
+            except Exception as exc:
+                logger.exception("file %s ingest failed: %s",
+                                 jsonl_path.name, exc)
+                stats.errors += 1
+
+        # [HERMES_ANAMNESIS_STATEDB_INGEST_v1] — also drain state.db.messages (the live source
+        # since the gateway stopped emitting *.jsonl ~2026-05-26).
+        state_db_path = _discover_state_db(sessions_dir)
+        if state_db_path is not None:
+            try:
+                _ingest_state_db(
+                    conn, state_db_path, state, container, client_id,
+                    extract_memories, stats,
+                    since_ts=float(os.environ.get("ANAMNESIS_STATEDB_SINCE_TS", "0") or 0),
+                )
+            except Exception as exc:
+                logger.exception("state.db ingest failed: %s", exc)
+                stats.errors += 1
+    finally:
+        conn.close()
+        _save_state(state_file, state)
+
+    stats.elapsed_ms = int((time.time() - started) * 1000)
+    return stats
+
+
+async def main_async(args: argparse.Namespace) -> int:
+    client_id = os.environ.get("HERMES_CLIENT_ID")
+    if not client_id:
+        logger.error("HERMES_CLIENT_ID env required")
+        return 2
+    if client_id == "_legacy":
+        logger.error("HERMES_CLIENT_ID=_legacy is reserved for migration only")
+        return 2
+    if args.container not in VALID_CONTAINERS:
+        logger.error("--container must be one of %s; got %r",
+                     sorted(VALID_CONTAINERS), args.container)
+        return 2
+
+    logger.info(
+        "ingest daemon started: db=%s sessions=%s container=%s client_id=%s "
+        "extract_memories=%s interval=%ss",
+        args.memory_db, args.sessions_dir, args.container, client_id,
+        args.extract_memories, args.interval,
+    )
+
+    stop_event = asyncio.Event()
+
+    def _signal_handler():
+        logger.info("signal received — finishing current batch")
+        stop_event.set()
+
+    loop = asyncio.get_running_loop()
+    for sig in (signal.SIGTERM, signal.SIGINT):
+        try:
+            loop.add_signal_handler(sig, _signal_handler)
+        except NotImplementedError:
+            pass
+
+    batches = 0
+    try:
+        while not stop_event.is_set():
+            batches += 1
+            try:
+                stats = await _run_one_batch(
+                    memory_db=args.memory_db,
+                    sessions_dir=Path(args.sessions_dir),
+                    state_file=Path(args.state_file),
+                    container=args.container,
+                    client_id=client_id,
+                    extract_memories=args.extract_memories,
+                )
+                if stats.chunks_written or stats.memories_written or stats.errors:
+                    logger.info(
+                        "batch %d: files_seen=%d files_with_new=%d "
+                        "chunks=%d memories=%d dupes=%d errors=%d elapsed_ms=%d",
+                        batches, stats.files_seen, stats.files_with_new,
+                        stats.chunks_written, stats.memories_written,
+                        stats.skipped_dupes, stats.errors, stats.elapsed_ms,
+                    )
+                elif batches % 20 == 0:
+                    logger.info(
+                        "batch %d: idle (files_seen=%d)",
+                        batches, stats.files_seen,
+                    )
+            except Exception as exc:
+                logger.exception("batch raised: %s", exc)
+            try:
+                await asyncio.wait_for(stop_event.wait(), timeout=args.interval)
+                break
+            except asyncio.TimeoutError:
+                continue
+    finally:
+        logger.info("ingest daemon stopped after %d batches", batches)
+    return 0
+
+
+def main() -> int:
+    p = argparse.ArgumentParser(description="Anamnesis session-ingestion daemon (v8)")
+    p.add_argument("--memory-db", required=True, type=Path,
+                   help="Path to ~/.anamnesis/memory.db")
+    p.add_argument("--capability-db", type=Path, default=None,
+                   help="Optional capability-router-usage.db (kept for parity, not used in v1)")
+    p.add_argument("--sessions-dir", required=True, type=Path,
+                   help="Path to ~/.hermes/sessions/")
+    p.add_argument("--state-file", required=True, type=Path,
+                   help="Path to ingest-daemon-state.json")
+    p.add_argument("--container", default="clients",
+                   help="Anamnesis container_id (default: clients)")
+    p.add_argument("--interval", type=float, default=30.0,
+                   help="Seconds between batches (default 30)")
+    p.add_argument("--extract-memories", action="store_true",
+                   help="Run heuristic memory extraction on top of chunk capture")
+    p.add_argument("--log-level", default="INFO")
+    args = p.parse_args()
+
+    logging.basicConfig(
+        level=args.log_level,
+        stream=sys.stderr,
+        format="%(asctime)s %(levelname)s %(name)s %(message)s",
+    )
+    return asyncio.run(main_async(args))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
