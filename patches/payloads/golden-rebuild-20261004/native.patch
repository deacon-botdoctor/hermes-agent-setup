+"""workers/memory/retrieve.py — memory-retrieve worker.
+
+Per docs/specs/hermes-worker-decomposition-v4.md §5.2:
+  Sole writer to durable-threads.db tables: agent_threads, agent_promises,
+  pending_commits. Closes the bug class from
+  project_session_resume_debundle_2026_04_26 (session-resume hook bypassing
+  gateway-native authority) by enforcing single-writer at the worker
+  boundary.
+
+Functions:
+  memory::retrieve_thread(scope, thread_id, since=None)
+    → list of agent_threads rows for that thread_id; optional since-epoch filter
+  memory::write_promise(scope, promise_id, resume_chain_id, thread_id,
+                        agent_profile, promise_text, trigger_type,
+                        trigger_condition, made_by_run_id,
+                        extraction_source, due_at=None, note=None)
+    → INSERT into agent_promises with state='pending'
+  memory::settle_promise(scope, promise_id, new_state,
+                         fulfilled_by_run_id=None, note=None)
+    → UPDATE state to 'fulfilled' | 'expired' | 'cancelled'
+
+This worker IS the gateway-native authority for durable-threads.db. The
+existing direct-sqlite paths from agent/durable_runtime.py + agent/
+stage_b_hooks.py continue writing during Phases 1-4a (warm fallback).
+After Phase 4a Doc proof passes, those direct paths are removed and all
+writes route through this worker.
+
+Self-trigger suppressions: writes to durable-threads.db tables are NOT
+typically watched by state triggers in v1 (the main watched scope is
+memory_store.facts). If durable-threads triggers register later, this
+worker MUST emit suppressions same-txn — already wired via
+attach_capability_db.
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+import sqlite3
+import time
+from typing import Any, Dict, List, Optional
+
+from .._ipc.envelope import Envelope, ErrorCode
+from .._ipc.server import HandlerError
+
+
+logger = logging.getLogger(__name__)
+
+
+VALID_PROMISE_STATES = {"pending", "fulfilled", "expired", "cancelled"}
+VALID_TRIGGER_TYPES = {"time", "user_action", "agent_condition"}
+VALID_EXTRACTION_SOURCES = {"llm_extraction", "explicit_tool"}
+
+# Settle transitions allowed: pending → {fulfilled, expired, cancelled}.
+# Other transitions rejected to preserve audit trail.
+ALLOWED_SETTLE_TARGETS = {"fulfilled", "expired", "cancelled"}
+
+
+class MemoryRetrieveWorker:
+    """Sole writer to durable-threads.db. Single-writer rule enforced via lock."""
+
+    def __init__(self, durable_db_path: str):
+        self.durable_db_path = durable_db_path
+        self._conn: Optional[sqlite3.Connection] = None
+        self._lock = asyncio.Lock()
+
+    def open(self) -> None:
+        self._conn = sqlite3.connect(
+            self.durable_db_path,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        self._conn.execute("PRAGMA journal_mode=WAL")
+        self._conn.execute("PRAGMA busy_timeout=5000")
+        self._conn.execute("PRAGMA synchronous=NORMAL")
+        self._conn.execute("PRAGMA foreign_keys=ON")
+
+    def close(self) -> None:
+        if self._conn is not None:
+            self._conn.close()
+            self._conn = None
+
+    # ─── memory::retrieve_thread (read) ─────────────────────────────────
+
+    async def handle_retrieve_thread(self, env: Envelope) -> Dict[str, Any]:
+        thread_id = env.args.get("thread_id")
+        since = env.args.get("since")
+
+        if not isinstance(thread_id, str) or not thread_id:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               "args.thread_id is required", retryable=False)
+        if since is not None:
+            try:
+                since = int(since)
+            except (TypeError, ValueError):
+                raise HandlerError(ErrorCode.INVALID_INPUT,
+                                   "args.since must be int (epoch seconds)",
+                                   retryable=False)
+
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._retrieve_thread_sync, thread_id, since,
+            )
+
+    def _retrieve_thread_sync(self, thread_id: str, since: Optional[int]) -> Dict[str, Any]:
+        assert self._conn is not None
+        if since is not None:
+            sql = """
+                SELECT run_id, thread_id, session_key, agent_profile, source,
+                       started_at, ended_at, terminal_state, note,
+                       resume_chain_id, resume_generation, superseded_by_run_id,
+                       resume_claimed_at
+                  FROM agent_threads
+                 WHERE thread_id = ? AND started_at >= ?
+                 ORDER BY started_at DESC
+                 LIMIT 100
+            """
+            rows = self._conn.execute(sql, (thread_id, since)).fetchall()
+        else:
+            sql = """
+                SELECT run_id, thread_id, session_key, agent_profile, source,
+                       started_at, ended_at, terminal_state, note,
+                       resume_chain_id, resume_generation, superseded_by_run_id,
+                       resume_claimed_at
+                  FROM agent_threads
+                 WHERE thread_id = ?
+                 ORDER BY started_at DESC
+                 LIMIT 100
+            """
+            rows = self._conn.execute(sql, (thread_id,)).fetchall()
+
+        keys = ("run_id", "thread_id", "session_key", "agent_profile", "source",
+                "started_at", "ended_at", "terminal_state", "note",
+                "resume_chain_id", "resume_generation", "superseded_by_run_id",
+                "resume_claimed_at")
+        results = [dict(zip(keys, row)) for row in rows]
+        return {"ok": True, "data": {"threads": results, "count": len(results),
+                                      "thread_id": thread_id}}
+
+    # ─── memory::write_promise (write) ──────────────────────────────────
+
+    async def handle_write_promise(self, env: Envelope) -> Dict[str, Any]:
+        a = env.args
+        required = ("promise_id", "resume_chain_id", "thread_id",
+                    "agent_profile", "promise_text", "trigger_type",
+                    "trigger_condition", "made_by_run_id", "extraction_source")
+        for k in required:
+            v = a.get(k)
+            if not isinstance(v, str) or not v:
+                raise HandlerError(ErrorCode.INVALID_INPUT,
+                                   f"args.{k} is required (non-empty string)",
+                                   retryable=False)
+
+        if a["trigger_type"] not in VALID_TRIGGER_TYPES:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               f"args.trigger_type must be one of {sorted(VALID_TRIGGER_TYPES)}",
+                               retryable=False)
+        if a["extraction_source"] not in VALID_EXTRACTION_SOURCES:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               f"args.extraction_source must be one of {sorted(VALID_EXTRACTION_SOURCES)}",
+                               retryable=False)
+
+        due_at = a.get("due_at")
+        if due_at is not None:
+            try:
+                due_at = int(due_at)
+            except (TypeError, ValueError):
+                raise HandlerError(ErrorCode.INVALID_INPUT,
+                                   "args.due_at must be int (epoch seconds)",
+                                   retryable=False)
+
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._write_promise_sync, a, due_at,
+            )
+
+    def _write_promise_sync(self, a: Dict[str, Any], due_at: Optional[int]) -> Dict[str, Any]:
+        assert self._conn is not None
+        now = int(time.time())
+        try:
+            self._conn.execute("BEGIN IMMEDIATE")
+            self._conn.execute(
+                """
+                INSERT INTO agent_promises (
+                    promise_id, resume_chain_id, thread_id, agent_profile,
+                    promise_text, trigger_type, trigger_condition, due_at,
+                    made_at, made_by_run_id, extraction_source,
+                    state, sweep_attempts, state_changed_at, note
+                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', 0, ?, ?)
+                """,
+                (a["promise_id"], a["resume_chain_id"], a["thread_id"],
+                 a["agent_profile"], a["promise_text"], a["trigger_type"],
+                 a["trigger_condition"], due_at, now, a["made_by_run_id"],
+                 a["extraction_source"], now, a.get("note")),
+            )
+            self._conn.execute("COMMIT")
+            return {"ok": True, "data": {"promise_id": a["promise_id"], "made_at": now}}
+        except sqlite3.IntegrityError as exc:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            # PK collision = duplicate promise_id; idempotency-friendly.
+            if "PRIMARY KEY" in str(exc) or "UNIQUE" in str(exc):
+                row = self._conn.execute(
+                    "SELECT made_at FROM agent_promises WHERE promise_id = ?",
+                    (a["promise_id"],),
+                ).fetchone()
+                return {"ok": True, "data": {"promise_id": a["promise_id"],
+                                              "made_at": row[0] if row else None,
+                                              "is_new": False}}
+            raise HandlerError(ErrorCode.INTERNAL_FAILURE,
+                               f"agent_promises insert failed: {exc}",
+                               retryable=False)
+        except Exception:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            raise
+
+    # ─── memory::settle_promise (write) ─────────────────────────────────
+
+    async def handle_settle_promise(self, env: Envelope) -> Dict[str, Any]:
+        a = env.args
+        promise_id = a.get("promise_id")
+        new_state = a.get("new_state")
+        fulfilled_by = a.get("fulfilled_by_run_id")
+        note = a.get("note")
+
+        if not isinstance(promise_id, str) or not promise_id:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               "args.promise_id is required", retryable=False)
+        if new_state not in ALLOWED_SETTLE_TARGETS:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               f"args.new_state must be one of {sorted(ALLOWED_SETTLE_TARGETS)}",
+                               retryable=False)
+
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._settle_promise_sync,
+                promise_id, new_state, fulfilled_by, note,
+            )
+
+    def _settle_promise_sync(
+        self, promise_id: str, new_state: str,
+        fulfilled_by: Optional[str], note: Optional[str],
+    ) -> Dict[str, Any]:
+        assert self._conn is not None
+        now = int(time.time())
+        try:
+            self._conn.execute("BEGIN IMMEDIATE")
+            # Read current state to prevent illegal transitions.
+            row = self._conn.execute(
+                "SELECT state FROM agent_promises WHERE promise_id = ?",
+                (promise_id,),
+            ).fetchone()
+            if row is None:
+                self._conn.execute("ROLLBACK")
+                raise HandlerError(ErrorCode.INVALID_INPUT,
+                                   f"promise_id {promise_id!r} not found",
+                                   retryable=False)
+            current = row[0]
+            if current != "pending":
+                # Idempotent re-settle to same state is OK; state change forbidden.
+                if current == new_state:
+                    self._conn.execute("ROLLBACK")
+                    return {"ok": True, "data": {"promise_id": promise_id,
+                                                  "state": current,
+                                                  "already_settled": True}}
+                self._conn.execute("ROLLBACK")
+                raise HandlerError(ErrorCode.INVALID_INPUT,
+                                   f"cannot settle promise in state {current!r}",
+                                   retryable=False)
+
+            extras_sql = ""
+            extras = []
+            if new_state == "fulfilled" and fulfilled_by:
+                extras_sql = ", fulfilled_by_run_id = ?, fulfilled_at = ?"
+                extras = [fulfilled_by, now]
+
+            sql = f"""
+                UPDATE agent_promises
+                   SET state = ?, state_changed_at = ?, note = COALESCE(?, note){extras_sql}
+                 WHERE promise_id = ?
+            """
+            params = [new_state, now, note] + extras + [promise_id]
+            self._conn.execute(sql, params)
+            self._conn.execute("COMMIT")
+            return {"ok": True, "data": {"promise_id": promise_id,
+                                          "state": new_state,
+                                          "state_changed_at": now}}
+        except HandlerError:
+            raise
+        except Exception:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            raise
