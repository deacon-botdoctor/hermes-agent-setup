@@ -0,0 +1,130 @@
+"""
+tools/memory_routing_declarations.py — Memory-routing classifications.
+
+The authoritative declaration of memory classes and their owners, used by
+workers/memory/memory_router.py to decide WHERE a candidate fact may be
+stored. This is the memory-write analogue of durability_declarations.py:
+the model may PROPOSE a memory; the harness (this table + the router)
+owns PLACEMENT.
+
+Golden-neutral: classes and target_store keys are logical/placeholders.
+No client names, host aliases, or Telegram IDs live here.
+
+A candidate "remember this" item is classified into exactly one of seven
+scopes before any durable write is allowed:
+
+  hot_user       stable, cross-session, cross-project user preference
+                 (scarce L1 cache; default-denied unless it passes the
+                 hot rules in memory_router.classify_hot_allowed).
+  agent_memory   stable environment/tool/project convention affecting
+                 execution (durable, but never promoted to the hot USER
+                 profile by the dream-cycle).
+  thread         applies to one chat/thread/task family, not globally.
+  project        belongs in GBrain / workspace / source of truth.
+  skill          repeatable workflow / routing logic / checklist.
+  ephemeral      current progress / TODOs / temporary decisions.
+                 session-only; never durable.
+  reject         PR/issue numbers, one-time task status, stale obs.
+
+Only hot_user and agent_memory may flow into the anamnesis store (tagged
+with their class so the dream-cycle can avoid promoting agent_memory to the
+hot profile). thread/project/skill/ephemeral/reject are rejected at the
+anamnesis boundary and routed to their declared target store.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Dict, Optional
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Memory classes — declared owners + routing targets
+# ─────────────────────────────────────────────────────────────────────────────
+
+# write_to_anamnesis: whether the gate lets the candidate reach the anamnesis
+#   store handler at all. Only the two durable, non-scoped classes may.
+# durable: whether the class represents a durable fact (vs session/ephemeral).
+MEMORY_CLASSES: Dict[str, Dict[str, Any]] = {
+    "hot_user": {
+        "owner": "universal user preferences (global profile)",
+        "target_store": "anamnesis:profile",
+        "durable": True,
+        "write_to_anamnesis": True,
+        "hot_profile_allowed": True,
+    },
+    "agent_memory": {
+        "owner": "machine / tool / environment conventions",
+        "target_store": "anamnesis:memories[class=agent_memory]",
+        "durable": True,
+        "write_to_anamnesis": True,
+        "hot_profile_allowed": False,
+    },
+    "thread": {
+        "owner": "chat / thread / task-family style and routing",
+        "target_store": "thread_preferences[<client>/<profile>/<thread>]",
+        "durable": True,
+        "write_to_anamnesis": False,
+        "hot_profile_allowed": False,
+    },
+    "project": {
+        "owner": "business / client / editorial knowledge (GBrain)",
+        "target_store": "gbrain/project",
+        "durable": True,
+        "write_to_anamnesis": False,
+        "hot_profile_allowed": False,
+    },
+    "skill": {
+        "owner": "repeatable procedures / playbooks",
+        "target_store": "skills",
+        "durable": True,
+        "write_to_anamnesis": False,
+        "hot_profile_allowed": False,
+    },
+    "ephemeral": {
+        "owner": "current task state (session / todo)",
+        "target_store": "session/todo",
+        "durable": False,
+        "write_to_anamnesis": False,
+        "hot_profile_allowed": False,
+    },
+    "reject": {
+        "owner": "forbidden / stale / one-time",
+        "target_store": None,
+        "durable": False,
+        "write_to_anamnesis": False,
+        "hot_profile_allowed": False,
+    },
+}
+
+VALID_SCOPES = frozenset(MEMORY_CLASSES.keys())
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Reject reason codes (Point 5). Returned with the correct alternative store.
+# ─────────────────────────────────────────────────────────────────────────────
+
+REJECT_THREAD_SCOPED = "REJECT_THREAD_SCOPED"
+REJECT_PROJECT_SCOPED = "REJECT_PROJECT_SCOPED"
+REJECT_PROCEDURAL = "REJECT_PROCEDURAL"
+REJECT_STALE = "REJECT_STALE"
+REJECT_LOW_FREQUENCY = "REJECT_LOW_FREQUENCY"
+REJECT_ALREADY_IN_CONTEXT = "REJECT_ALREADY_IN_CONTEXT"
+REJECT_TOO_VERBOSE = "REJECT_TOO_VERBOSE"
+REJECT_AMBIGUOUS = "REJECT_AMBIGUOUS"
+REJECT_EMPTY = "REJECT_EMPTY"
+
+
+def class_for_scope(scope: str) -> Dict[str, Any]:
+    """Return the declared class record for a scope. Raises on unknown scope."""
+    if scope not in MEMORY_CLASSES:
+        raise ValueError(f"unknown memory scope {scope!r}; expected one of {sorted(VALID_SCOPES)}")
+    return MEMORY_CLASSES[scope]
+
+
+def target_store_for(scope: str) -> Optional[str]:
+    """Return the declared target store for a scope (None for reject)."""
+    return class_for_scope(scope)["target_store"]
+
+
+def may_write_to_anamnesis(scope: str) -> bool:
+    """True only for the two durable, non-scoped classes (hot_user, agent_memory)."""
+    return bool(class_for_scope(scope)["write_to_anamnesis"])
