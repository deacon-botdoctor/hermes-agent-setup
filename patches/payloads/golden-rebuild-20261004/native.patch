+"""Config-backed client-visible gateway safety helpers.
+
+HERMES_GATEWAY_CLIENT_VISIBLE_SAFETY_CONFIG_v1
+"""
+from __future__ import annotations
+
+from functools import lru_cache
+from typing import Any
+
+
+def _get_nested(data: Any, *keys: str, default: Any = None) -> Any:
+    cur = data
+    for key in keys:
+        if not isinstance(cur, dict) or key not in cur:
+            return default
+        cur = cur[key]
+    return cur
+
+
+@lru_cache(maxsize=1)
+def _client_visible_safety_config() -> dict[str, Any]:
+    try:
+        from hermes_cli.config import load_config
+        cfg = load_config() or {}
+    except Exception:
+        cfg = {}
+    if not isinstance(cfg, dict):
+        return {}
+    section = _get_nested(cfg, "gateway", "client_visible_safety", default=None)
+    if not isinstance(section, dict):
+        section = cfg.get("client_visible_safety")
+    return section if isinstance(section, dict) else {}
+
+
+def _bool(keys: tuple[str, ...], default: bool) -> bool:
+    cfg = _client_visible_safety_config()
+    for key in keys:
+        value = cfg.get(key)
+        if isinstance(value, bool):
+            return value
+        if isinstance(value, str):
+            lowered = value.strip().lower()
+            if lowered in {"1", "true", "yes", "on"}:
+                return True
+            if lowered in {"0", "false", "no", "off"}:
+                return False
+    return default
+
+
+# Operator surfaces where client-visible safety suppression must never apply.
+# Single source of truth shared by the async-delegation completion gate and
+# the client progress detail gate.
+OPERATOR_PLATFORMS = frozenset({"local", "api_server", "webhook", "relay"})
+
+
+def is_operator_platform(platform: Any) -> bool:
+    value = getattr(platform, "value", platform)
+    return str(value or "").lower() in OPERATOR_PLATFORMS
+
+
+def suppress_async_delegation_completion_injection() -> bool:
+    return _bool(("suppress_async_delegation_completion_injection", "suppress_async_delegation_injection"), True)
+
+
+def suppress_client_progress_detail() -> bool:
+    return _bool(("suppress_client_progress_detail", "suppress_tool_progress_detail", "suppress_step_prose"), True)
