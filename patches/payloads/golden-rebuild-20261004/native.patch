index 0000000000000000000000000000000000000000..bc21e3951f48deadd1f80313fe4f9a0e5665bc4e
--- /dev/null
+++ b/gateway/media_provenance.py
@@ -0,0 +1,368 @@
+# [HERMES_TELEGRAM_REPLY_MEDIA_v1]
+"""Reverse-resolvable media provenance store.
+
+Maps a Telegram ``message_id`` (and Telegram ``file_id`` / ``file_unique_id``)
+back to the local artifact that produced or received it:
+
+  - **outgoing**: when the gateway (or ``telegram-send-artifact``) sends a
+    locally-generated image/document/video, record the ``origin_path`` (the
+    generator's source file, e.g. ``/tmp/.../g25_1_calm_study.png``), the
+    uploaded Telegram ``file_id``/``file_unique_id``, sha256, caption, and
+    dimensions, keyed by the delivered Telegram ``message_id``.
+  - **incoming**: when a user uploads media, record the gateway cache path
+    plus the Telegram file ids.
+
+A later user reply to that Telegram media can then resolve back to the exact
+local/generated artifact via :func:`lookup_by_message` — this is what lets the
+agent answer "I like this one" without re-generating or re-asking.
+
+Companion to ``gateway/media_index.py`` (in-thread breadcrumb) and
+``gateway/media_memory.py`` (long-horizon searchable memory).  This module is
+the precise message_id -> artifact map.
+
+Pure additive, best-effort: every public function is wrapped so a failure
+logs rather than raising — it must never block a gateway send/receive turn.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import logging
+import os
+import sqlite3
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+try:
+    from hermes_constants import get_hermes_home
+except Exception:  # pragma: no cover - import only used at module load
+    get_hermes_home = None  # type: ignore[assignment]
+
+
+logger = logging.getLogger(__name__)
+
+
+def _db_path() -> Path:
+    home = get_hermes_home() if get_hermes_home else None
+    if home is None:
+        home = Path(os.path.expanduser("~/.hermes"))
+    return Path(home) / "data" / "media-provenance.db"
+
+
+def _now_iso() -> str:
+    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def _connect() -> Optional[sqlite3.Connection]:
+    try:
+        path = _db_path()
+        path.parent.mkdir(parents=True, exist_ok=True)
+        conn = sqlite3.connect(str(path), timeout=5.0)
+        conn.execute("PRAGMA busy_timeout=5000")
+        conn.execute("PRAGMA journal_mode=WAL")
+        conn.execute(
+            """
+            CREATE TABLE IF NOT EXISTS media_provenance (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                platform TEXT NOT NULL DEFAULT 'telegram',
+                chat_id TEXT,
+                thread_id TEXT,
+                message_id TEXT,
+                direction TEXT NOT NULL,
+                kind TEXT,
+                file_id TEXT,
+                file_unique_id TEXT,
+                origin_path TEXT,
+                local_cached_path TEXT,
+                caption TEXT,
+                mime_type TEXT,
+                width INTEGER,
+                height INTEGER,
+                file_size INTEGER,
+                sha256 TEXT,
+                filename TEXT,
+                created_at TEXT NOT NULL,
+                UNIQUE(platform, chat_id, message_id, file_id)
+            )
+            """
+        )
+        conn.execute(
+            "CREATE INDEX IF NOT EXISTS idx_mp_lookup "
+            "ON media_provenance(platform, chat_id, thread_id, message_id)"
+        )
+        conn.execute(
+            "CREATE INDEX IF NOT EXISTS idx_mp_file_unique "
+            "ON media_provenance(file_unique_id)"
+        )
+        conn.commit()
+        return conn
+    except Exception as exc:
+        logger.warning("media_provenance: connect failed: %s", exc)
+        return None
+
+
+def compute_sha256(path: Optional[str]) -> Optional[str]:
+    """Best-effort sha256 of a local file. Returns None on any failure."""
+    if not path:
+        return None
+    try:
+        h = hashlib.sha256()
+        with open(path, "rb") as fh:
+            for chunk in iter(lambda: fh.read(1 << 20), b""):
+                h.update(chunk)
+        return h.hexdigest()
+    except Exception as exc:
+        logger.debug("media_provenance: sha256 failed for %s: %s", path, exc)
+        return None
+
+
+def _norm(value: Any) -> Optional[str]:
+    if value is None:
+        return None
+    s = str(value).strip()
+    return s or None
+
+
+def _norm_chat(value: Any) -> Optional[str]:
+    """Normalize a chat id to a bare form for consistent matching.
+
+    Writes come from the gateway send path with a bare numeric chat id
+    (``-100XXXXXXXXXX``) while reads from the transcript tool arrive as
+    ``telegram:-100XXXXXXXXXX``.  Strip a leading ``telegram:`` and any
+    trailing ``:thread`` so both sides agree on the chat key.
+    """
+    s = _norm(value)
+    if s is None:
+        return None
+    if s.startswith("telegram:"):
+        s = s[len("telegram:"):]
+    # Drop a trailing :thread fragment if one was included in the chat id.
+    if ":" in s:
+        s = s.split(":", 1)[0]
+    return s or None
+
+
+def _insert(row: Dict[str, Any]) -> Optional[int]:
+    conn = _connect()
+    if conn is None:
+        return None
+    try:
+        cur = conn.execute(
+            """
+            INSERT OR REPLACE INTO media_provenance
+                (platform, chat_id, thread_id, message_id, direction, kind,
+                 file_id, file_unique_id, origin_path, local_cached_path,
+                 caption, mime_type, width, height, file_size, sha256,
+                 filename, created_at)
+            VALUES
+                (:platform, :chat_id, :thread_id, :message_id, :direction, :kind,
+                 :file_id, :file_unique_id, :origin_path, :local_cached_path,
+                 :caption, :mime_type, :width, :height, :file_size, :sha256,
+                 :filename, :created_at)
+            """,
+            row,
+        )
+        conn.commit()
+        return cur.lastrowid
+    except Exception as exc:
+        logger.warning("media_provenance: insert failed: %s", exc)
+        return None
+    finally:
+        conn.close()
+
+
+def record_outgoing(
+    *,
+    chat_id: Any,
+    message_id: Any,
+    origin_path: Optional[str] = None,
+    thread_id: Any = None,
+    kind: Optional[str] = None,
+    file_id: Optional[str] = None,
+    file_unique_id: Optional[str] = None,
+    caption: Optional[str] = None,
+    mime_type: Optional[str] = None,
+    width: Optional[int] = None,
+    height: Optional[int] = None,
+    file_size: Optional[int] = None,
+    sha256: Optional[str] = None,
+    filename: Optional[str] = None,
+    platform: str = "telegram",
+    compute_hash: bool = True,
+) -> Optional[int]:
+    """Record a gateway-sent local artifact, keyed by the delivered message_id.
+
+    A later user reply to this Telegram media resolves back to ``origin_path``.
+    """
+    try:
+        if sha256 is None and compute_hash and origin_path:
+            sha256 = compute_sha256(origin_path)
+        if filename is None and origin_path:
+            filename = os.path.basename(origin_path)
+        row = {
+            "platform": platform,
+            "chat_id": _norm_chat(chat_id),
+            "thread_id": _norm(thread_id),
+            "message_id": _norm(message_id),
+            "direction": "outgoing",
+            "kind": _norm(kind),
+            "file_id": _norm(file_id),
+            "file_unique_id": _norm(file_unique_id),
+            "origin_path": origin_path,
+            "local_cached_path": None,
+            "caption": caption,
+            "mime_type": _norm(mime_type),
+            "width": int(width) if width is not None else None,
+            "height": int(height) if height is not None else None,
+            "file_size": int(file_size) if file_size is not None else None,
+            "sha256": sha256,
+            "filename": filename,
+            "created_at": _now_iso(),
+        }
+        return _insert(row)
+    except Exception as exc:
+        logger.warning("media_provenance.record_outgoing failed: %s", exc)
+        return None
+
+
+def record_incoming(
+    *,
+    chat_id: Any,
+    message_id: Any,
+    local_cached_path: Optional[str] = None,
+    thread_id: Any = None,
+    kind: Optional[str] = None,
+    file_id: Optional[str] = None,
+    file_unique_id: Optional[str] = None,
+    caption: Optional[str] = None,
+    mime_type: Optional[str] = None,
+    width: Optional[int] = None,
+    height: Optional[int] = None,
+    file_size: Optional[int] = None,
+    filename: Optional[str] = None,
+    platform: str = "telegram",
+) -> Optional[int]:
+    """Record a user-uploaded media file, keyed by its Telegram message_id."""
+    try:
+        if filename is None and local_cached_path:
+            filename = os.path.basename(local_cached_path)
+        row = {
+            "platform": platform,
+            "chat_id": _norm_chat(chat_id),
+            "thread_id": _norm(thread_id),
+            "message_id": _norm(message_id),
+            "direction": "incoming",
+            "kind": _norm(kind),
+            "file_id": _norm(file_id),
+            "file_unique_id": _norm(file_unique_id),
+            "origin_path": None,
+            "local_cached_path": local_cached_path,
+            "caption": caption,
+            "mime_type": _norm(mime_type),
+            "width": int(width) if width is not None else None,
+            "height": int(height) if height is not None else None,
+            "file_size": int(file_size) if file_size is not None else None,
+            "sha256": None,
+            "filename": filename,
+            "created_at": _now_iso(),
+        }
+        return _insert(row)
+    except Exception as exc:
+        logger.warning("media_provenance.record_incoming failed: %s", exc)
+        return None
+
+
+def _row_to_dict(row: sqlite3.Row) -> Dict[str, Any]:
+    return {
+        "platform": row["platform"],
+        "chat_id": row["chat_id"],
+        "thread_id": row["thread_id"],
+        "message_id": row["message_id"],
+        "direction": row["direction"],
+        "kind": row["kind"],
+        "file_id": row["file_id"],
+        "file_unique_id": row["file_unique_id"],
+        "origin_path": row["origin_path"],
+        "local_cached_path": row["local_cached_path"],
+        "caption": row["caption"],
+        "mime_type": row["mime_type"],
+        "width": row["width"],
+        "height": row["height"],
+        "file_size": row["file_size"],
+        "sha256": row["sha256"],
+        "filename": row["filename"],
+        "created_at": row["created_at"],
+    }
+
+
+def lookup_by_message(
+    chat_id: Any,
+    thread_id: Any,
+    message_id: Any,
+    platform: str = "telegram",
+) -> List[Dict[str, Any]]:
+    """Return provenance rows for one Telegram message.
+
+    Matching is keyed by ``(platform, chat_id, message_id)``. ``thread_id`` is
+    not part of the match key because a Telegram ``message_id`` is already
+    unique within a chat; the thread is recorded for context only.
+    """
+    conn = _connect()
+    if conn is None:
+        return []
+    try:
+        conn.row_factory = sqlite3.Row
+        msg = _norm(message_id)
+        if msg is None:
+            return []
+        cid = _norm_chat(chat_id)
+        rows = conn.execute(
+            """
+            SELECT * FROM media_provenance
+            WHERE platform = ? AND message_id = ?
+              AND (chat_id = ? OR ? IS NULL OR chat_id IS NULL)
+            ORDER BY id DESC
+            """,
+            (platform, msg, cid, cid),
+        ).fetchall()
+        return [_row_to_dict(r) for r in rows]
+    except Exception as exc:
+        logger.warning("media_provenance.lookup_by_message failed: %s", exc)
+        return []
+    finally:
+        conn.close()
+
+
+def lookup_by_file_unique_id(
+    file_unique_id: Optional[str],
+    platform: str = "telegram",
+) -> List[Dict[str, Any]]:
+    """Return provenance rows matching a Telegram ``file_unique_id``.
+
+    ``file_unique_id`` is stable across re-sends of the same file, so this can
+    resolve a replied-to media object back to its artifact even when the
+    delivered ``message_id`` was not the one recorded.
+    """
+    conn = _connect()
+    if conn is None:
+        return []
+    try:
+        conn.row_factory = sqlite3.Row
+        fuid = _norm(file_unique_id)
+        if fuid is None:
+            return []
+        rows = conn.execute(
+            """
+            SELECT * FROM media_provenance
+            WHERE platform = ? AND file_unique_id = ?
+            ORDER BY id DESC
+            """,
+            (platform, fuid),
+        ).fetchall()
+        return [_row_to_dict(r) for r in rows]
+    except Exception as exc:
+        logger.warning("media_provenance.lookup_by_file_unique_id failed: %s", exc)
+        return []
+    finally:
+        conn.close()
