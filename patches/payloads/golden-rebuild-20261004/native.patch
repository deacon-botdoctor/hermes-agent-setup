@@ -0,0 +1,82 @@
+"""workers/memory/store_mcp.py — memory-store MCP shim entry point.
+
+Per docs/specs/hermes-worker-decomposition-v4.md D2 (dual-shim):
+  Same MemoryStoreWorker handler as native JSON-RPC; different transport.
+
+Usage (consumed by MCP-aware clients via stdio):
+    python -m hermes_agent.workers.memory.store_mcp \\
+        --memory-db ~/.hermes/memory_store.db \\
+        --capability-db ~/.hermes/state/capability-router-usage.db
+
+Reads MCP requests from stdin; writes responses to stdout. Logs go to
+stderr only — stdout is RESERVED for MCP wire output (mixing breaks parsers).
+"""
+from __future__ import annotations
+
+import argparse
+import asyncio
+import logging
+import sys
+from pathlib import Path
+
+from .._mcp.dispatch import McpStdioDispatcher
+from .store import MemoryStoreWorker
+
+
+SCHEMA_STORE = {
+    "type": "object",
+    "properties": {
+        "memory_type": {
+            "type": "string",
+            "enum": ["decision", "person", "lesson", "project",
+                     "commitment", "preference", "handoff", "general"],
+            "description": "Typed memory category"
+        },
+        "content": {"type": "string", "description": "Fact text"},
+        "priority": {
+            "type": "string",
+            "enum": ["critical", "notable", "background", "normal"],
+        },
+        "metadata": {"type": "object"},
+        "entity_refs": {"type": "array", "items": {"type": "object"}},
+        "category": {"type": "string"},
+        "tags": {"type": "string"},
+    },
+    "required": ["memory_type", "content"],
+}
+
+
+async def run(args) -> int:
+    worker = MemoryStoreWorker(str(args.memory_db), str(args.capability_db))
+    worker.open()
+    try:
+        d = McpStdioDispatcher(server_name="memory-store", server_version="1.0.0")
+        d.register(
+            "memory::store",
+            worker.handle_store,
+            version="1.0.0",
+            compatible_callers=">=1.0 <2.0",
+            input_schema=SCHEMA_STORE,
+            description="Store a typed memory fact in memory_store.db",
+        )
+        return await d.run_stdio()
+    finally:
+        worker.close()
+
+
+def main() -> int:
+    p = argparse.ArgumentParser(description="memory-store MCP stdio shim")
+    p.add_argument("--memory-db", required=True, type=Path)
+    p.add_argument("--capability-db", required=True, type=Path)
+    p.add_argument("--log-level", default="WARNING")
+    args = p.parse_args()
+
+    # Logs go to stderr ONLY. Stdout is the MCP wire — never log there.
+    logging.basicConfig(level=args.log_level, stream=sys.stderr,
+                        format="%(asctime)s %(levelname)s %(name)s %(message)s")
+
+    return asyncio.run(run(args))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
