new file mode 100644
index 0000000000000000000000000000000000000000..d78c0aec93ea6f001b9d209fa38006fa84ac4966
--- /dev/null
+++ b/workers/memory/__main__.py
@@ -0,0 +1,163 @@
+"""workers/memory/__main__.py — CLI entry point for memory workers.
+
+Per docs/specs/hermes-worker-decomposition-v4.md §5.6.2:
+  Workers run as gateway-supervised subprocesses for v1.
+
+Usage:
+    python -m hermes_agent.workers.memory store    --socket ... --memory-db ... --capability-db ... [--traces-db ...]
+    python -m hermes_agent.workers.memory recall   --socket ... --memory-db ... [--traces-db ...]
+    python -m hermes_agent.workers.memory compress --socket ... [--traces-db ...]
+    python -m hermes_agent.workers.memory summarize --socket ... --state-db ... --durable-db ... [--traces-db ...]
+    python -m hermes_agent.workers.memory retrieve --socket ... --durable-db ... [--traces-db ...]
+"""
+from __future__ import annotations
+
+import argparse
+import asyncio
+import logging
+import signal
+import sys
+from pathlib import Path
+
+from .._ipc.server import WorkerServer
+from .._ipc.tracing import TraceWriter
+from .store import MemoryStoreWorker
+from .recall import MemoryRecallWorker
+from .compress import MemoryCompressWorker
+from .summarize import MemorySummarizeWorker
+from .retrieve import MemoryRetrieveWorker
+
+
+logger = logging.getLogger(__name__)
+
+FUNCTION_VERSION = "1.0.0"
+COMPATIBLE_CALLERS = ">=1.0 <2.0"
+
+
+async def _run_server(server: WorkerServer, on_stop) -> int:
+    await server.start()
+    if not await server.self_probe():
+        logger.error("self-probe failed; aborting startup")
+        await server.stop()
+        return 2
+
+    logger.info("worker ready: %s on %s", server.worker_name, server.socket_path)
+
+    stop_event = asyncio.Event()
+
+    def _request_stop(*_):
+        logger.info("stop signal received")
+        stop_event.set()
+
+    loop = asyncio.get_running_loop()
+    for sig in (signal.SIGTERM, signal.SIGINT):
+        try:
+            loop.add_signal_handler(sig, _request_stop)
+        except NotImplementedError:
+            pass
+
+    serve_task = asyncio.create_task(server.serve_forever())
+    try:
+        await stop_event.wait()
+    finally:
+        await server.stop()
+        serve_task.cancel()
+        try:
+            await serve_task
+        except (asyncio.CancelledError, Exception):
+            pass
+        try:
+            on_stop()
+        except Exception:
+            logger.exception("on_stop callback failed")
+    return 0
+
+
+def _make_trace_writer(args) -> "TraceWriter|None":
+    return TraceWriter(str(args.traces_db)) if args.traces_db else None
+
+
+async def run_store(args):
+    w = MemoryStoreWorker(str(args.memory_db), str(args.capability_db))
+    w.open()
+    tw = _make_trace_writer(args)
+    s = WorkerServer(worker_name="memory-store", socket_path=str(args.socket), trace_writer=tw)
+    s.register("memory::store", w.handle_store, version=FUNCTION_VERSION, compatible_callers=COMPATIBLE_CALLERS)
+    return await _run_server(s, on_stop=lambda: w.close())
+
+
+async def run_recall(args):
+    w = MemoryRecallWorker(str(args.memory_db))
+    w.open()
+    tw = _make_trace_writer(args)
+    s = WorkerServer(worker_name="memory-recall", socket_path=str(args.socket), trace_writer=tw)
+    s.register("memory::recall", w.handle_recall, version=FUNCTION_VERSION, compatible_callers=COMPATIBLE_CALLERS)
+    return await _run_server(s, on_stop=lambda: w.close())
+
+
+async def run_compress(args):
+    w = MemoryCompressWorker()
+    w.open()
+    tw = _make_trace_writer(args)
+    s = WorkerServer(worker_name="memory-compress", socket_path=str(args.socket), trace_writer=tw)
+    s.register("memory::compress", w.handle_compress, version=FUNCTION_VERSION, compatible_callers=COMPATIBLE_CALLERS)
+    return await _run_server(s, on_stop=lambda: w.close())
+
+
+async def run_summarize(args):
+    w = MemorySummarizeWorker(str(args.state_db), str(args.durable_db))
+    w.open()
+    tw = _make_trace_writer(args)
+    s = WorkerServer(worker_name="memory-summarize", socket_path=str(args.socket), trace_writer=tw)
+    s.register("memory::summarize", w.handle_summarize, version=FUNCTION_VERSION, compatible_callers=COMPATIBLE_CALLERS)
+    return await _run_server(s, on_stop=lambda: w.close())
+
+
+async def run_retrieve(args):
+    w = MemoryRetrieveWorker(str(args.durable_db))
+    w.open()
+    tw = _make_trace_writer(args)
+    s = WorkerServer(worker_name="memory-retrieve", socket_path=str(args.socket), trace_writer=tw)
+    s.register("memory::retrieve_thread", w.handle_retrieve_thread, version=FUNCTION_VERSION, compatible_callers=COMPATIBLE_CALLERS)
+    s.register("memory::write_promise", w.handle_write_promise, version=FUNCTION_VERSION, compatible_callers=COMPATIBLE_CALLERS)
+    s.register("memory::settle_promise", w.handle_settle_promise, version=FUNCTION_VERSION, compatible_callers=COMPATIBLE_CALLERS)
+    return await _run_server(s, on_stop=lambda: w.close())
+
+
+def main() -> int:
+    p = argparse.ArgumentParser(description="hermes memory worker subprocess")
+    p.add_argument("worker", choices=["store", "recall", "compress", "summarize", "retrieve"])
+    p.add_argument("--socket", required=True, type=Path)
+    p.add_argument("--memory-db", type=Path, help="memory_store.db (store, recall)")
+    p.add_argument("--capability-db", type=Path, help="capability-router-usage.db (store)")
+    p.add_argument("--state-db", type=Path, help="machine-level state.db (summarize)")
+    p.add_argument("--durable-db", type=Path, help="durable-threads.db (summarize, retrieve)")
+    p.add_argument("--traces-db", type=Path, help="db with worker_traces (typically capability-db)")
+    p.add_argument("--log-level", default="INFO", choices=["DEBUG", "INFO", "WARNING", "ERROR"])
+    args = p.parse_args()
+
+    logging.basicConfig(level=args.log_level,
+                        format="%(asctime)s %(levelname)s %(name)s %(message)s")
+
+    requirements = {
+        "store":     ("memory_db", "capability_db"),
+        "recall":    ("memory_db",),
+        "compress":  (),
+        "summarize": ("state_db", "durable_db"),
+        "retrieve":  ("durable_db",),
+    }
+    missing = [r for r in requirements[args.worker] if getattr(args, r) is None]
+    if missing:
+        print(f"--{','.join(m.replace('_','-') for m in missing)} required for worker={args.worker}",
+              file=sys.stderr)
+        return 2
+
+    runners = {
+        "store": run_store, "recall": run_recall, "compress": run_compress,
+        "summarize": run_summarize, "retrieve": run_retrieve,
+    }
+    return asyncio.run(runners[args.worker](args))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
