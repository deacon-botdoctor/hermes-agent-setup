+Host Steward remains the durable owner of local tabs. Provider sessions retain
+their existing whole-browser owner. No additional janitor or store is created.
+"""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import importlib.util
+import json
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+from urllib.parse import urlsplit
+
+APPROVED_BINARIES = {'agent-browser-darwin-arm64': '8168b86ab5d94be8f670992dfe4fe1445016518a864b48bda105e64142e7cbf9', 'agent-browser-darwin-x64': '787cb40e086a188d0bb13ff29a99a0b2380aff3aa5e8600b8f8131a0b98ca69c', 'agent-browser-linux-arm64': '690c02d952de8497bba4f8cc58b59acbf27dc27b346755869b518f4b411c7f40', 'agent-browser-linux-musl-arm64': 'eafeca9ca0fdb2fa2aa60c4554723348c739656b0ddba0d82ff654d4d33311b1', 'agent-browser-linux-musl-x64': '993d462f4dcfc19860d93a6521a452eba4502bfc449fe0120303c2ccb998e675', 'agent-browser-linux-x64': 'a54b765192db774666f0513fa8b545a298753b6f29e73bcdf4a1e78f18e7c0e1', 'agent-browser-win32-x64.exe': 'a6a9a3654c41ee19c05961b73489db98cff9eae88a77436986df08a7a7a73786'}
+
+
+def _steward(home):
+    path = Path(home) / "bin/hermes-host-steward.py"
+    if path.is_symlink() or not path.is_file():
+        raise RuntimeError("Host Steward is required for local tab ownership")
+    name = "_hermes_browser_steward_" + hashlib.sha256(str(path).encode()).hexdigest()[:16]
+    if name not in sys.modules:
+        spec = importlib.util.spec_from_file_location(name, path)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[name] = module
+        try:
+            spec.loader.exec_module(module)
+        except BaseException:
+            sys.modules.pop(name, None)
+            raise
+    return sys.modules[name]
+
+
+class OwnedTargets:
+    """One task's targets, health, and recovery state on one browser generation."""
+
+    def __init__(self, task_id, cdp_url, home, state=None, *, cap=3):
+        self.task_id, self.cdp_url, self.home = task_id, cdp_url, str(home)
+        self.state = state if state is not None else {}
+        self.state.setdefault("targets", {})
+        self.state.setdefault("recovery", {})
+        self.cap = max(1, int(cap))
+        self.probe_timeout = 5.0
+        self.close_timeout = 10.0
+        self._lease = None
+        self._local_endpoint = None
+        parsed = urlsplit(cdp_url)
+        if parsed.hostname in {"127.0.0.1", "localhost"} and parsed.port:
+            self._local_endpoint = "http://127.0.0.1:" + str(parsed.port)
+        self._owner_id = "native-browser:" + hashlib.sha256(task_id.encode()).hexdigest()[:32]
+        self.writer = threading.Lock()
+        self._reconcile_lock = asyncio.Lock()
+
+    @property
+    def target_id(self):
+        return self.state.get("target_id")
+
+    @property
+    def working_target_id(self):
+        return self.state.get("active_target_id") or self.target_id
+
+    @property
+    def held(self):
+        return bool(self.state.get("held"))
+
+    async def _call(self, supervisor, method, params=None, *, session_id=None, timeout=None):
+        reply = await supervisor._cdp(method, params, session_id=session_id,
+                                      timeout=timeout or self.probe_timeout)
+        return reply.get("result", {})
+
+    def _claim_local(self):
+        steward = _steward(self.home)
+        # Reuse this task's durable record across a daemon/supervisor restart.
+        # An unresolved intent blocks another create, even if its reply was lost.
+        with steward._registry_lock(Path(self.home), "browser-admission.lock"):
+            intents, invalid_intents = steward.load_intents(Path(self.home))
+            leases, invalid_leases = steward.load_leases(Path(self.home))
+            if invalid_intents or invalid_leases:
+                raise RuntimeError("Browser ownership store requires reconciliation")
+            if any(row.get("task_id") == self._owner_id for _, row in intents):
+                raise RuntimeError("Browser create outcome is uncertain; reconcile before replacement")
+            own = []
+            for _, row in leases:
+                resource = row.get("resource", {})
+                if not resource.get("native_browser") or resource.get("endpoint") != self._local_endpoint:
+                    continue
+                if row.get("task_id") == self._owner_id:
+                    own.append(row)
+                else:
+                    # Expiry does not prove disposal. The existing reconciler
+                    # must release the previous owner before another is admitted.
+                    raise RuntimeError("Browser profile writer is busy; wait for its owner to release")
+            if len(own) > 1:
+                raise RuntimeError("Browser has multiple ownership records; reconcile before use")
+            if own:
+                self._lease = own[0]
+                return own[0]["resource"]
+            result = steward.create_browser_tab(Path(self.home), task_id=self._owner_id,
+                                                endpoint=self._local_endpoint, ttl=300, protected=False,
+                                                native_browser=True, generation=self.cdp_url,
+                                                native_session=self.state.get("native_session", ""))
+            with steward._registry_lock(Path(self.home)):
+                path = steward._lease_path(Path(self.home), result["lease_id"])
+                row = steward._read_json(path)
+                if not row:
+                    raise RuntimeError("Browser lease could not be read after creation")
+                self._lease = row
+                return row["resource"]
+
+    def _persist(self):
+        if self._lease is None:
+            return
+        steward = _steward(self.home)
+        with steward._registry_lock(Path(self.home)):
+            path = steward._lease_path(Path(self.home), self._lease["lease_id"])
+            row = steward._read_json(path)
+            if not row or row.get("task_id") != self._owner_id:
+                raise RuntimeError("Browser lease is missing; reconcile before use")
+            row["resource"]["children"] = {
+                target: parent for target, parent in dict(self.state["targets"]).items()
+                if target != self.target_id
+            }
+            row["resource"]["last_operation"] = self.state.get("last_operation")
+            row["resource"]["uncertain_write"] = bool(self.state.get("uncertain_write"))
+            row["resource"]["checkpoint_url"] = self.state.get("checkpoint_url")
+            row["resource"]["recovery"] = dict(self.state["recovery"])
+            row["resource"]["recovery_safe"] = bool(self.state.get("recovery_safe"))
+            row["resource"]["harness_owner"] = self.state.get("harness_owner")
+            row["resource"]["bootstrap_targets"] = list(self.state.get("bootstrap_targets", []))
+            row["protected"] = self.held
+            row["expires_epoch"] = steward.epoch_now() + 300
+            row["stale_observations"] = 0
+            steward._atomic_json(path, row)
+            self._lease = row
+
+    async def attach(self, supervisor):
+        if self.state.get("claim") == "uncertain":
+            raise RuntimeError("Browser claim is uncertain; reconcile before replacement")
+        if not self.target_id:
+            if self._local_endpoint:
+                resource = await asyncio.to_thread(self._claim_local)
+                if resource.get("generation") != self.cdp_url:
+                    raise RuntimeError("Browser generation changed; reconcile its old lease")
+                target = resource["target_id"]
+                self.state["targets"] = {target: None, **resource.get("children", {})}
+                self.state["held"] = bool(self._lease.get("protected"))
+                self.state["last_operation"] = resource.get("last_operation")
+                self.state["uncertain_write"] = bool(resource.get("uncertain_write"))
+                self.state["checkpoint_url"] = resource.get("checkpoint_url")
+                self.state["recovery"].update(resource.get("recovery", {}))
+                self.state["recovery_safe"] = bool(resource.get("recovery_safe"))
+                self.state["harness_owner"] = resource.get("harness_owner")
+                self.state.setdefault("bootstrap_targets", resource.get("bootstrap_targets", []))
+                self.state["native_session"] = resource.get("native_session", self.state.get("native_session"))
+            elif self.state.get("provider_owned"):
+                # The existing provider's private browser lease owns the whole
+                # generation. Shared remote endpoints cannot use this exception.
+                self.state["claim"] = "uncertain"
+                target = (await self._call(supervisor, "Target.createTarget", {"url": "about:blank"}))["targetId"]
+                self.state["targets"] = {target: None}
+            else:
+                raise RuntimeError("Shared remote browser needs a durable tab owner")
+            self.state.update(target_id=target, claim="verified")
+        live = await self._call(supervisor, "Target.getTargets")
+        if not any(t.get("targetId") == self.working_target_id and t.get("type") == "page"
+                   for t in live.get("targetInfos", [])):
+            raise RuntimeError("Owned browser target is gone; reconcile before replacement")
+        attached = await self._call(supervisor, "Target.attachToTarget",
+                                    {"targetId": self.working_target_id, "flatten": True})
+        previous = supervisor._page_session_id
+        supervisor._page_session_id = attached["sessionId"]
+        if previous and previous != supervisor._page_session_id:
+            await self._call(supervisor, "Target.detachFromTarget", {"sessionId": previous})
+        await supervisor._enable_page_domains(supervisor._page_session_id, timeout=self.probe_timeout)
+        await supervisor._install_dialog_bridge(supervisor._page_session_id)
+        await self._call(supervisor, "Target.setDiscoverTargets", {"discover": True})
+        # These exact initial pages came from a newly leased private process,
+        # before agent dispatch. Shared endpoints never supply this reservation.
+        for target in list(self.state.get("bootstrap_targets", [])):
+            if target != self.target_id:
+                self.state["targets"][target] = self.target_id
+                await asyncio.to_thread(self._persist)
+                await self._close_target(supervisor, target)
+            self.state["bootstrap_targets"].remove(target)
+        await self.reconcile(supervisor)
+
+    async def reconcile(self, supervisor, *, trim=True):
+        async with self._reconcile_lock:
+            return await self._reconcile_unlocked(supervisor, trim=trim)
+
+    async def _reconcile_unlocked(self, supervisor, *, trim=True):
+        infos = (await self._call(supervisor, "Target.getTargets")).get("targetInfos", [])
+        known = self.state["targets"]
+        # Resolve ancestry in repeated passes so nested popups do not depend on
+        # target enumeration order. Unrelated targets are never adopted.
+        changed = True
+        while changed:
+            changed = False
+            for info in infos:
+                tid, opener = info.get("targetId"), info.get("openerId")
+                if info.get("type") == "page" and tid not in known and opener in known:
+                    known[tid] = opener
+                    changed = True
+        await asyncio.to_thread(self._persist)
+        live = {t.get("targetId") for t in infos}
+        # Keep closed ancestors until their surviving descendants are released.
+        live_owned = [tid for tid in known if tid in live]
+        if trim and len(live_owned) > self.cap and not self.held and not self.state.get("in_flight"):
+            keep = list(dict.fromkeys([self.working_target_id, self.target_id] + live_owned))
+            keep = [tid for tid in keep if tid in live][:self.cap]
+            for tid in reversed([tid for tid in live_owned if tid not in keep]):
+                await self._close_target(supervisor, tid)
+                live.discard(tid)
+        # Prune absent leaves. This preserves a complete durable ancestry tree.
+        changed = True
+        while changed:
+            changed = False
+            for tid in list(known):
+                if tid != self.target_id and tid not in live and tid not in known.values():
+                    known.pop(tid)
+                    changed = True
+        await asyncio.to_thread(self._persist)
+        if trim and len([tid for tid in known if tid in live]) > self.cap:
+            raise RuntimeError("Browser target capacity is held; wait for protected targets")
+
+    async def _close_target(self, supervisor, target):
+        if target not in self.state["targets"]:
+            raise RuntimeError("Refusing to close an unowned browser target")
+        live = (await self._call(supervisor, "Target.getTargets")).get("targetInfos", [])
+        if not any(t.get("targetId") == target for t in live):
+            return
+        await self._call(supervisor, "Target.closeTarget", {"targetId": target}, timeout=self.close_timeout)
+        deadline = time.monotonic() + self.close_timeout
+        while True:
+            live = (await self._call(supervisor, "Target.getTargets")).get("targetInfos", [])
+            if not any(t.get("targetId") == target for t in live):
+                return
+            if time.monotonic() >= deadline:
+                raise RuntimeError("Owned browser target disposal was not confirmed")
+            await asyncio.sleep(0.05)
+
+    async def health(self, supervisor):
+        observed = time.time()
+        try:
+            targets = (await self._call(supervisor, "Target.getTargets")).get("targetInfos", [])
+        except Exception:
+            return {"transport": False, "page": "unknown", "observed_at": observed}
+        info = next((t for t in targets if t.get("targetId") == self.working_target_id), None)
+        if info is None:
+            return {"transport": True, "page": "gone", "observed_at": observed}
+        if self.held:
+            return {"transport": True, "page": "human_hold", "observed_at": observed}
+        with supervisor._state_lock:
+            if supervisor._pending_dialogs:
+                return {"transport": True, "page": "dialog", "observed_at": observed}
+        try:
+            value = await self._call(supervisor, "Runtime.evaluate",
+                                     {"expression": "({value:1,ready:document.readyState})", "returnByValue": True},
+                                     session_id=supervisor._page_session_id)
+            result = value.get("result", {}).get("value", {})
+            if result.get("value") != 1:
+                raise RuntimeError("Page probe did not return its expected value")
+            page = "navigating" if result.get("ready") == "loading" else "responsive"
+            self.state["probe_failures"] = 0
+            self.state["checkpoint_url"] = info.get("url", "about:blank")
+        except Exception:
+            self.state["probe_failures"] = self.state.get("probe_failures", 0) + 1
+            page = "suspect" if self.state["probe_failures"] >= 2 else "probe_failed"
+        return {"transport": True, "page": page, "observed_at": observed}
+
+    async def prepare(self, supervisor, *, read_only=False):
+        await self.reconcile(supervisor)
+        report = await self.health(supervisor)
+        if report["page"] in {"responsive", "navigating", "dialog"}:
+            return report
+        if report["page"] == "probe_failed":
+            report = await self.health(supervisor)
+        if self.held or self.state.get("uncertain_write"):
+            raise RuntimeError("Browser recovery requires human handback or write-result verification")
+        if report["page"] == "suspect":
+            recovery = self.state["recovery"]
+            if not recovery.get("reattach"):
+                recovery["reattach"] = True
+                await asyncio.to_thread(self._persist)
+                await self.attach(supervisor)
+                report = await self.health(supervisor)
+            if report["page"] == "responsive":
+                return report
+            if read_only and self.state.get("recovery_safe") and not recovery.get("reload"):
+                recovery["reload"] = True
+                await asyncio.to_thread(self._persist)
+                await self._call(supervisor, "Page.reload", session_id=supervisor._page_session_id)
+                report = await self.health(supervisor)
+            if report["page"] == "responsive":
+                return report
+            checkpoint = self.state.get("checkpoint_url")
+            if read_only and self.state.get("recovery_safe") and checkpoint and not recovery.get("replacement"):
+                recovery["replacement"] = True
+                await asyncio.to_thread(self._persist)
+                await self.release(supervisor)
+                self.state.pop("target_id", None)
+                self.state.pop("active_target_id", None)
+                self.state.pop("claim", None)
+                self.state.pop("released", None)
+                self.state["targets"] = {}
+                await self.attach(supervisor)
+                await self._call(supervisor, "Page.navigate", {"url": checkpoint}, session_id=supervisor._page_session_id)
+                report = await self.health(supervisor)
+                if report["page"] in {"responsive", "navigating"}:
+                    return report
+        raise RuntimeError("Owned page recovery is exhausted; reconcile before another browser is created")
+
+    def operation_started(self, *, read_only=False):
+        self.state["last_operation"] = "reading" if read_only else "uncertain"
+        if not read_only:
+            self.state["recovery_safe"] = False
+            self.state["uncertain_write"] = True
+        self.state["in_flight"] = True
+        self._persist()
+
+    def operation_finished(self, success, *, dispatched=True, read_only=False):
+        self.state["last_operation"] = "confirmed" if success else ("failed" if read_only or not dispatched else "uncertain")
+        if not read_only and (success or not dispatched):
+            self.state["uncertain_write"] = False
+        if success:
+            self.state["recovery"] = {}
+        elif dispatched and not read_only:
+            self.state["uncertain_write"] = True
+        self.state["last_activity"] = time.time()
+        self.state["in_flight"] = False
+        self._persist()
+
+    async def hold(self, value):
+        self.state["held"] = bool(value)
+        await asyncio.to_thread(self._persist)
+
+    async def release(self, supervisor):
+        async with self._reconcile_lock:
+            return await self._release_unlocked(supervisor)
+
+    async def _release_unlocked(self, supervisor):
+        if self.held:
+            raise RuntimeError("Browser cleanup is held for human authentication")
+        await self._reconcile_unlocked(supervisor, trim=False)
+        for target in reversed(list(self.state["targets"])):
+            await self._close_target(supervisor, target)
+            self.state["targets"].pop(target)
+        if self._lease:
+            steward = _steward(self.home)
+            result = await asyncio.to_thread(steward.release_lease, Path(self.home),
+                                             lease_id=self._lease["lease_id"], apply=True)
+            if result.get("outcome") not in {"released", "already_gone"}:
+                raise RuntimeError("Browser lease release needs reconciliation")
+            self._lease = None
+        self.state["released"] = True
+
+
+def command_read_only(command, args):
+    """Only explicit inspection commands can be replayed after a backend failure."""
+    return command in {"snapshot", "screenshot", "get", "is", "find"} and (
+        command != "find" or not any(x in args for x in {"click", "fill", "check", "hover", "press"})
+    )
+
+
+def managed_agent_browser(home):
+    """Verify the exact private artifact; never accept an ambient npx command."""
+    home = Path(home)
+    receipt = home / "state/agent-browser-install-v1.json"
+    try:
+        row = json.loads(receipt.read_text())
+        path = Path(row["executable"])
+        root = home / "tools/agent-browser-managed/0.38.2"
+        if row.get("version") != "0.38.2" or path.parent != root or path.is_symlink():
+            raise ValueError("unapproved artifact")
+        if row["sha256"] != APPROVED_BINARIES.get(path.name) or hashlib.sha256(path.read_bytes()).hexdigest() != row["sha256"]:
+            raise ValueError("artifact changed")
+        return str(path)
+    except (OSError, ValueError, KeyError, TypeError):
+        raise FileNotFoundError("Managed agent-browser 0.38.2 is required. Run Golden's ensure-agent-browser.py installer on the owning runtime.") from None
+
+
+def pin_native_target(home, session_name, socket_dir, target_id):
+    """Write the exact 0.38.2 binding cache from an already verified owner.
+
+    This is the CLI's existing cache, not another ownership store. The pinned
+    version validates and reloads it before attach, including after a restart.
+    """
+    import re
+    if not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", session_name) or not re.fullmatch(r"[A-Za-z0-9_-]+", target_id):
+        raise RuntimeError("Native target binding identifiers are invalid")
+    path = Path(socket_dir) / (session_name + ".target")
+    if path.is_symlink() or Path(socket_dir).is_symlink():
+        raise RuntimeError("Native target binding cache must not be a symlink")
+    _steward(home)._atomic_json(path, {"targetId": target_id, "url": "", "pinned": True})
+
+
+def record_harness_owner(owned, env):
+    """Keep only nonsecret harness references and the exact daemon fingerprint."""
+    keys = ("BU_NAME", "BH_HOME", "BH_CONFIG_DIR", "BH_RUNTIME_DIR", "BH_RUNTIME_DIR_SHARED", "BH_TMP_DIR", "BH_TMP_DIR_SHARED")
+    references = {key: env[key] for key in keys if key in env}
+    runtime_dir = references.get("BH_RUNTIME_DIR")
+    if not runtime_dir:
+        raise RuntimeError("The managed harness runtime directory is required")
+    stem = "bu-" + references.get("BU_NAME", "default") if references.get("BH_RUNTIME_DIR_SHARED") == "1" else "bu"
+    pid_path = Path(runtime_dir) / (stem + ".pid")
+    owner = owned.state.get("harness_owner")
+    if owner is None:
+        owner = owned.state["harness_owner"] = {"env": references, "pid_path": str(pid_path)}
+    if owner["env"] != references:
+        raise RuntimeError("The harness namespace changed before its owner was released")
+    if pid_path.is_file():
+        pid = int(pid_path.read_text().strip())
+        identity = _steward(owned.home).process_identity(pid)
+        if identity is None:
+            raise RuntimeError("Harness daemon identity requires reconciliation")
+        if owner.get("identity") and not _steward(owned.home)._fingerprint_matches(owner["identity"], identity):
+            raise RuntimeError("Harness daemon generation changed before disposal")
+        owner["identity"] = identity
+    owned._persist()
+
+
+def release_harness_owner(owned, command, base_env):
+    owner = owned.state.get("harness_owner")
+    if not owner:
+        return
+    steward = _steward(owned.home)
+    identity = owner.get("identity")
+    if identity is None:
+        if Path(owner["pid_path"]).exists():
+            raise RuntimeError("Harness creation outcome needs reconciliation")
+    else:
+        current = steward.process_identity(identity["pid"])
+        if current is not None:
+            if not steward._fingerprint_matches(identity, current):
+                raise RuntimeError("Harness process identity changed; refusing disposal")
+            env = {**base_env, **owner["env"], "BU_AUTOSPAWN": "0"}
+            result = subprocess.run([*command, "--reload"], input="", capture_output=True, text=True, env=env, timeout=10)
+            if result.returncode:
+                raise RuntimeError("Owned harness daemon shutdown failed")
+            deadline = time.monotonic() + 5
+            while steward.process_identity(identity["pid"]) is not None:
+                if time.monotonic() >= deadline:
+                    raise RuntimeError("Owned harness daemon disposal was not confirmed")
+                time.sleep(.05)
+    owned.state.pop("harness_owner", None)
+    owned._persist()
