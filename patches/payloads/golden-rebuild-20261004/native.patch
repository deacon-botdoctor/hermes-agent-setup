+"""workers/memory/anamnesis/reranker.py — cross-encoder re-ranking for anamnesis recall.
+
+Optional post-processing step over FTS5 or vector results. Requires
+sentence-transformers (optional dep); degrades gracefully to unranked
+top_k slice if unavailable.
+
+Model: cross-encoder/ms-marco-MiniLM-L-6-v2 (~80MB, CPU-friendly).
+Override with HERMES_RERANKER_MODEL env var.
+
+Usage:
+    from .reranker import rerank
+    hits = rerank(query, hits, top_k=10)
+"""
+from __future__ import annotations
+
+import logging
+import os
+from typing import Any, Dict, List, Optional
+
+logger = logging.getLogger(__name__)
+
+DEFAULT_MODEL = "cross-encoder/ms-marco-MiniLM-L-6-v2"
+
+_cross_encoder: Optional[Any] = None
+_load_attempted: bool = False
+_load_failed: bool = False
+
+
+def _load_model() -> bool:
+    """Load cross-encoder model on first use. Returns True if available."""
+    global _cross_encoder, _load_attempted, _load_failed
+    if _load_attempted:
+        return not _load_failed
+    _load_attempted = True
+    try:
+        from sentence_transformers import CrossEncoder  # type: ignore[import]
+        model_name = os.environ.get("HERMES_RERANKER_MODEL", DEFAULT_MODEL)
+        _cross_encoder = CrossEncoder(model_name)
+        logger.info("reranker: loaded model %s", model_name)
+        return True
+    except ImportError:
+        logger.warning(
+            "reranker: sentence-transformers not installed; "
+            "returning unranked results. "
+            "To enable re-ranking: pip install sentence-transformers"
+        )
+        _load_failed = True
+        return False
+    except Exception as exc:  # noqa: BLE001
+        logger.warning("reranker: model load failed (%s); returning unranked results", exc)
+        _load_failed = True
+        return False
+
+
+def rerank(query: str, hits: List[Dict[str, Any]], top_k: int) -> List[Dict[str, Any]]:
+    """Re-score hits with a cross-encoder and return top_k best results.
+
+    Replaces combined_score with cross-encoder logit score (higher = more
+    relevant). Falls back to unranked top_k slice when model unavailable.
+
+    Args:
+        query: original search query string
+        hits: list of hit dicts with at least 'content' and 'combined_score'
+        top_k: number of results to return after re-ranking
+    """
+    if not hits:
+        return []
+    if top_k <= 0:
+        return []
+
+    if not _load_model():
+        return list(hits[:top_k])
+
+    pairs = [(query, h.get("content", "")) for h in hits]
+    try:
+        scores = _cross_encoder.predict(pairs)
+    except Exception as exc:  # noqa: BLE001
+        logger.warning("reranker: predict failed (%s); returning unranked results", exc)
+        return list(hits[:top_k])
+
+    ranked = sorted(zip(scores, hits), key=lambda x: float(x[0]), reverse=True)
+    result = []
+    for score, hit in ranked[:top_k]:
+        reranked = dict(hit)
+        reranked["combined_score"] = float(score)
+        result.append(reranked)
+    return result
