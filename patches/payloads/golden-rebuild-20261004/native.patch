+"""Preserve the enabled legacy checkpoint hooks at native turn boundaries."""
+from contextlib import contextmanager
+import logging
+from agent import stage_b_hooks
+logger = logging.getLogger(__name__)
+
+@contextmanager
+def durability_run(agent, task_id):
+    from tools.approval_context import get_current_session_key
+    thread_id = get_current_session_key("") or task_id or getattr(agent, "session_id", "") or ""
+    state = None
+    outcome = {"result": None}
+    try:
+        state = stage_b_hooks.begin_run(
+            agent, thread_id=thread_id,
+            session_id=getattr(agent, "session_id", "") or "", resume_state=None,
+        )
+        yield state, outcome
+    finally:
+        if state is not None:
+            result = outcome["result"]
+            terminal = "SUCCESS" if isinstance(result, dict) and result.get("completed", True) and not result.get("error") else "FAIL"
+            if isinstance(result, dict) and isinstance(result.get("messages"), list):
+                state.messages = result["messages"]
+            try:
+                stage_b_hooks.end_run(agent, state, terminal_state=terminal)
+            finally:
+                original = getattr(agent, "_sb_original_execute_tool_calls", None)
+                if original is not None:
+                    agent._execute_tool_calls = original
+                    agent._sb_tool_wrap_installed = False
+                    agent._sb_current_rs = None
+                    del agent._sb_original_execute_tool_calls
+
+def checkpoint(agent, loop, phase):
+    state = loop._durable_state
+    if state is None or not state.enabled:
+        return
+    state.messages = list(loop.messages)
+    state.turn_index = state.api_call_count = loop.api_call_count
+    state.model = agent.model
+    state.provider_name = getattr(agent, "provider", "") or ""
+    state.api_mode = getattr(agent, "api_mode", "chat") or "chat"
+    response = loop.response
+    body = None
+    if phase == stage_b_hooks.PHASE_POST_RESPONSE and response is not None:
+        if hasattr(response, "model_dump"):
+            body = response.model_dump()
+        elif hasattr(response, "__dict__"):
+            body = {k: v for k, v in vars(response).items() if not k.startswith("_")}
+    stage_b_hooks.checkpoint(agent, state, phase=phase, response_body=body)
