new file mode 100644
index 0000000000000000000000000000000000000000..468a84abbcf274d7ee3c5216c1e9e7343882f3f6
--- /dev/null
+++ b/gateway/topic_hygiene.py
@@ -0,0 +1,84 @@
+"""Config-backed topic hygiene helpers.
+
+HERMES_TOPIC_HYGIENE_CONFIG_v1
+"""
+from __future__ import annotations
+
+import re
+from functools import lru_cache
+from typing import Any
+
+
+def _get_nested(data: Any, *keys: str, default: Any = None) -> Any:
+    cur = data
+    for key in keys:
+        if not isinstance(cur, dict) or key not in cur:
+            return default
+        cur = cur[key]
+    return cur
+
+
+@lru_cache(maxsize=1)
+def _topic_hygiene_config() -> dict[str, Any]:
+    try:
+        from hermes_cli.config import load_config
+        cfg = load_config() or {}
+    except Exception:
+        cfg = {}
+    topic = cfg.get("topic_hygiene") if isinstance(cfg, dict) else {}
+    if not isinstance(topic, dict):
+        topic = {}
+    return topic
+
+
+def _bool(path: tuple[str, ...], default: bool) -> bool:
+    value = _get_nested(_topic_hygiene_config(), *path, default=default)
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        return value.strip().lower() in {"1", "true", "yes", "on"}
+    return bool(value) if value is not None else default
+
+
+def normalize_topic_chat_type(platform: str, chat_type: str, thread_id: object) -> str:
+    """Return the session-key chat_type after config-backed topic normalization."""
+    if (
+        platform == "telegram"
+        and thread_id
+        and chat_type in {"forum", "supergroup"}
+        and _bool(("telegram", "normalize_forum_topics_to_group"), True)
+    ):
+        return "group"
+    return chat_type
+
+
+def disable_participant_fallback(platform: str) -> bool:
+    """Return True when group session keys should not append sender ids."""
+    return platform == "telegram" and _bool(("telegram", "disable_group_user_fallback"), True)
+
+
+def exact_thread_tasks_by_default() -> bool:
+    return _bool(("active_tasks", "exact_thread_by_default"), True)
+
+
+def low_signal_current_topic_guard_enabled() -> bool:
+    return _bool(("session_search", "low_signal_current_topic_guard"), True)
+
+
+_DEFAULT_LOW_SIGNAL_TERMS = ["?", "ok", "okay", "yes", "yep", "sure", "go", "do it", "continue", "resume", "proceed", "thanks", "thank you"]
+
+
+@lru_cache(maxsize=1)
+def _low_signal_re() -> re.Pattern[str]:
+    terms = _get_nested(_topic_hygiene_config(), "session_search", "low_signal_terms", default=_DEFAULT_LOW_SIGNAL_TERMS)
+    if not isinstance(terms, list) or not terms:
+        terms = _DEFAULT_LOW_SIGNAL_TERMS
+    cleaned = [str(term).strip() for term in terms if str(term).strip()]
+    if not cleaned:
+        cleaned = _DEFAULT_LOW_SIGNAL_TERMS
+    body = "|".join(re.escape(term) for term in sorted(cleaned, key=len, reverse=True))
+    return re.compile(rf"^\s*(?:{body})\s*[.!?]*\s*\Z", re.I)
+
+
+def is_low_signal_topic_query(query: str) -> bool:
+    return bool(_low_signal_re().match(str(query or "")))
diff --git a/gateway/transcript_redaction.py b/gateway/transcript_redaction.py
new file mode 100644
index 0000000000000000000000000000000000000000..ff9282f165d74505d6ea80b71f37073600069d7e
--- /dev/null
+++ b/gateway/transcript_redaction.py
@@ -0,0 +1,21 @@
+"""Redact all nested transcript strings before gateway persistence."""
+import re as _re
+from agent.redact import redact_sensitive_text
+_STRICT_SURVIVOR_PATTERNS = [
+    _re.compile(r"[0-9]{8,12}:AA[EFGH][A-Za-z0-9_-]{32}"),                # Telegram bot token body
+    _re.compile(r"sk-or-v1-[a-f0-9]{60,}"),                                # OpenRouter key
+    _re.compile(r"sk-ant-(?:api|oat|admin)[0-9]+-[A-Za-z0-9_\-]{60,}"),   # Anthropic
+    _re.compile(r"sk-proj-[A-Za-z0-9_\-]{80,}"),                          # OpenAI project
+]
+
+def redact_message(value):
+    if isinstance(value, str):
+        value = redact_sensitive_text(value, force=True)
+        for pattern in _STRICT_SURVIVOR_PATTERNS:
+            value = pattern.sub("[REDACTED_SECRET]", value)
+        return value
+    if isinstance(value, dict):
+        return {key: redact_message(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [redact_message(item) for item in value]
+    return value
