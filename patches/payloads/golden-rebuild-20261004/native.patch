+++ b/workers/memory/store.py
@@ -0,0 +1,234 @@
+"""workers/memory/store.py — memory-store worker.
+
+Sole writer to memory_store.db's facts/entities/fact_entities tables per
+docs/specs/hermes-worker-decomposition-v4.md §5.2.
+
+Function: memory::store
+Args:
+    memory_type: one of decision|person|lesson|project|commitment|preference|handoff|general
+    content: str (the fact text)
+    priority: critical|notable|background|normal (default normal)
+    metadata: dict (serialized as metadata_json) — optional
+    entity_refs: list of {name, entity_type?, aliases?} — optional
+    category: legacy field for backwards-compat — optional
+    tags: legacy field — optional
+Returns:
+    {"ok": True, "data": {"fact_id": int, "is_new": bool}}
+
+Atomicity: every store is one BEGIN IMMEDIATE → suppress + INSERT facts +
+INSERT entities + INSERT fact_entities → COMMIT. Crash mid-write rolls
+back via WAL.
+
+Self-trigger prevention: every facts write is preceded by a suppression
+INSERT in the same txn against scope='memory_store.facts' (per §5.3.2).
+The state-trigger watcher checks suppressions before emitting events;
+memory-store's own writes don't loop back as triggers.
+
+Single-writer rule (v4 §5.0): all writes serialized through this process's
+single sqlite connection. Worker holds an asyncio.Lock to serialize across
+concurrent IPC requests.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import sqlite3
+import time
+from typing import Any, Dict, List, Optional
+
+from .._ipc.envelope import Envelope, ErrorCode
+from .._ipc.server import HandlerError
+from .._ipc.suppressions import attach_capability_db, suppress_in_txn
+
+
+logger = logging.getLogger(__name__)
+
+
+VALID_TYPES = {
+    "decision", "person", "lesson", "project",
+    "commitment", "preference", "handoff", "general",
+}
+VALID_PRIORITIES = {"critical", "notable", "background", "normal"}
+
+
+class MemoryStoreWorker:
+    """memory::store handler. Holds the single writer connection."""
+
+    def __init__(self, memory_db_path: str, capability_db_path: str):
+        self.memory_db_path = memory_db_path
+        self.capability_db_path = capability_db_path
+        self._conn: Optional[sqlite3.Connection] = None
+        self._lock = asyncio.Lock()
+
+    def open(self) -> None:
+        """Open sqlite connection. Call once at worker startup, before serve_forever."""
+        self._conn = sqlite3.connect(
+            self.memory_db_path,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        self._conn.execute("PRAGMA journal_mode=WAL")
+        self._conn.execute("PRAGMA busy_timeout=5000")
+        self._conn.execute("PRAGMA synchronous=NORMAL")
+        self._conn.execute("PRAGMA foreign_keys=ON")
+        # Attach capability-router-usage.db for cross-db suppression writes.
+        attach_capability_db(self._conn, self.capability_db_path)
+
+    def close(self) -> None:
+        if self._conn is not None:
+            self._conn.close()
+            self._conn = None
+
+    async def handle_store(self, env: Envelope) -> Dict[str, Any]:
+        """memory::store handler."""
+        args = env.args
+        memory_type = str(args.get("memory_type", "general"))
+        content = args.get("content")
+        priority = str(args.get("priority", "normal"))
+        metadata = args.get("metadata")
+        entity_refs = args.get("entity_refs") or []
+        category = str(args.get("category", "general"))
+        tags = str(args.get("tags", ""))
+
+        # Validation
+        if not isinstance(content, str) or not content.strip():
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                "args.content is required and must be a non-empty string",
+                retryable=False,
+            )
+        if memory_type not in VALID_TYPES:
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                f"args.memory_type must be one of {sorted(VALID_TYPES)}; got {memory_type!r}",
+                retryable=False,
+            )
+        if priority not in VALID_PRIORITIES:
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                f"args.priority must be one of {sorted(VALID_PRIORITIES)}; got {priority!r}",
+                retryable=False,
+            )
+        if metadata is not None and not isinstance(metadata, dict):
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                "args.metadata must be a dict if provided",
+                retryable=False,
+            )
+        if not isinstance(entity_refs, list):
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                "args.entity_refs must be a list if provided",
+                retryable=False,
+            )
+
+        metadata_json = json.dumps(metadata, separators=(",", ":")) if metadata else None
+        client_id = env.scope.client_id  # mandated by §5.1.6
+
+        # Single-writer serialization
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None,
+                self._do_store_sync,
+                memory_type, content, priority, metadata_json,
+                entity_refs, category, tags, client_id,
+            )
+
+    def _do_store_sync(
+        self,
+        memory_type: str,
+        content: str,
+        priority: str,
+        metadata_json: Optional[str],
+        entity_refs: List[Dict[str, Any]],
+        category: str,
+        tags: str,
+        client_id: str,
+    ) -> Dict[str, Any]:
+        """The actual sqlite work. Runs in executor; lock held by caller."""
+        assert self._conn is not None, "worker not opened"
+
+        try:
+            self._conn.execute("BEGIN IMMEDIATE")
+
+            # 1. Suppression — covers self-trigger loop on memory_store.facts.
+            #    Must commit/rollback atomically with the INSERT(s) below.
+            #    Using a placeholder key='*' since fact_id is autoincrement;
+            #    the actual fact_id is included as scope-qualified key after
+            #    insert. Watchers match either '*' (broad) or specific id.
+            #    Rather than two suppressions, we use a sentinel that watcher
+            #    treats as "skip the next memory_store.facts event observed
+            #    within TTL from this writer".
+            suppress_in_txn(
+                self._conn,
+                scope="memory_store.facts",
+                key="*",
+                op="modify",
+                issued_by="memory-store",
+                ttl_seconds=5,
+            )
+
+            # 2. Try INSERT; sqlite UNIQUE on content might raise IntegrityError.
+            try:
+                cur = self._conn.execute(
+                    """
+                    INSERT INTO facts (
+                        content, category, tags, memory_type, priority,
+                        metadata_json, client_id
+                    ) VALUES (?, ?, ?, ?, ?, ?, ?)
+                    """,
+                    (content, category, tags, memory_type, priority,
+                     metadata_json, client_id),
+                )
+                fact_id = cur.lastrowid
+                is_new = True
+            except sqlite3.IntegrityError as exc:
+                # UNIQUE constraint on content → fact already exists.
+                # Surface the existing fact_id rather than failing.
+                if "UNIQUE" not in str(exc):
+                    raise
+                row = self._conn.execute(
+                    "SELECT fact_id FROM facts WHERE content = ?",
+                    (content,),
+                ).fetchone()
+                fact_id = row[0] if row else None
+                is_new = False
+
+            # 3. Optional entity refs — INSERT into entities + fact_entities.
+            for ref in entity_refs:
+                if not isinstance(ref, dict) or "name" not in ref:
+                    continue
+                name = ref["name"]
+                entity_type = ref.get("entity_type", "unknown")
+                aliases = ref.get("aliases", "")
+                if isinstance(aliases, list):
+                    aliases = ",".join(aliases)
+                # Find or create entity
+                row = self._conn.execute(
+                    "SELECT entity_id FROM entities WHERE name = ?", (name,),
+                ).fetchone()
+                if row:
+                    entity_id = row[0]
+                else:
+                    cur = self._conn.execute(
+                        "INSERT INTO entities (name, entity_type, aliases) VALUES (?, ?, ?)",
+                        (name, entity_type, aliases),
+                    )
+                    entity_id = cur.lastrowid
+                # Link fact ↔ entity (idempotent via PRIMARY KEY)
+                if fact_id is not None and entity_id is not None:
+                    self._conn.execute(
+                        "INSERT OR IGNORE INTO fact_entities (fact_id, entity_id) VALUES (?, ?)",
+                        (fact_id, entity_id),
+                    )
+
+            self._conn.execute("COMMIT")
+            return {"ok": True, "data": {"fact_id": fact_id, "is_new": is_new}}
+
+        except Exception:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            raise
