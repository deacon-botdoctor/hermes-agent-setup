+"""Operator recovery receipt bridge, after native MCP authorization and recovery."""
+import json
+import logging
+from tools.mcp_tool_common import _core
+logger = logging.getLogger(__name__)
+
+def _ensure_current_process_mcp_server(server_name):
+    """Reuse the policy-gated MCP control tool already loaded in this process."""
+    from tools.registry import registry as _tool_registry
+
+    raw = _tool_registry.dispatch(
+        "restart_mcp_server",
+        {"server_name": server_name},
+        _mcp_ensure_active=True,
+    )
+    result = raw if isinstance(raw, dict) else json.loads(raw)
+    if not (
+        result.get("ok") is True
+        and result.get("status") == "connected"
+        and result.get("connected") is True
+        and int(result.get("tools") or 0) > 0
+    ):
+        raise RuntimeError(
+            "policy-gated current-process MCP activation did not reach connected state"
+        )
+    _core._reset_server_error(server_name)
+
+
+def _tool_doctor_recover_mcp_call(
+    server_name, tool_name, error_text, retry_call, *, repair_suppressed=False,
+    call_phase="in_flight"
+):
+    """HERMES_MCP_CALL_TOOL_DOCTOR_RECOVERY_v2: one bounded local heal and one exact retry."""
+    try:
+        from tools import mcp_call_classifier as _mcp_classifier
+
+        return _mcp_classifier.recover_mcp_call(
+            server_name=server_name,
+            tool_name=tool_name,
+            error_text=error_text,
+            retry_call=retry_call,
+            on_recovered=lambda: _ensure_current_process_mcp_server(server_name),
+            repair_suppressed=repair_suppressed,
+            call_phase=call_phase,
+        )
+    except Exception as _recovery_exc:
+        logger.debug("MCP Tool Doctor recovery skipped: %s", _recovery_exc)
+        return json.dumps({"error": error_text}, ensure_ascii=False)
+
+
+def _record_mcp_call_success(server_name, tool_name, duration_ms):
+    try:
+        from tools import mcp_call_classifier as _mcp_classifier
+
+        _mcp_classifier.record_outcome(
+            server_name=server_name,
+            tool_name=tool_name,
+            ok=True,
+            duration_ms=duration_ms,
+        )
+    except Exception as _classifier_exc:
+        logger.debug("MCP classifier outcome write skipped: %s", _classifier_exc)
