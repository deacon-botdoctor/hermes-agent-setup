new file mode 100644
index 0000000000000000000000000000000000000000..04873d1c99946c8db2eb8bd9f071c21cb352f6e8
--- /dev/null
+++ b/workers/memory/thread_preferences.py
@@ -0,0 +1,125 @@
+"""
+workers/memory/thread_preferences.py — scoped preference store.
+
+The routing target for thread-scoped facts that the memory gate rejects from
+the anamnesis store (REJECT_THREAD_SCOPED). Without a real target, "auto-route
+to the correct layer" would be hollow.
+
+A thread preference applies to one chat / thread / task family, never to the
+global user profile. It is keyed by (client_id, profile_id, thread_key). When
+no thread_key is present the fact is still kept here under a sentinel bucket
+rather than polluting hot memory.
+
+Plain stdlib sqlite3, idempotent (content-hash key, INSERT OR IGNORE), safe to
+re-run. Golden-neutral: no schema field assumes any client identity.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import sqlite3
+import time
+from pathlib import Path
+from typing import Any, Optional
+
+_UNSCOPED = "_unscoped"
+
+
+def _now_iso() -> str:
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+def _det_id(client_id: str, profile_id: str, thread_key: str, content: str) -> str:
+    h = hashlib.sha256(f"{client_id}|{profile_id}|{thread_key}|{content}".encode("utf-8")).hexdigest()
+    return f"{h[:8]}-{h[8:12]}-{h[12:16]}-{h[16:20]}-{h[20:32]}"
+
+
+class ThreadPreferenceStore:
+    """SQLite-backed store for thread-scoped preferences."""
+
+    def __init__(self, db_path: Any):
+        self.db_path = str(db_path)
+        self._conn: Optional[sqlite3.Connection] = None
+
+    def open(self) -> "ThreadPreferenceStore":
+        Path(self.db_path).parent.mkdir(parents=True, exist_ok=True)
+        self._conn = sqlite3.connect(self.db_path)
+        self._conn.execute(
+            """
+            CREATE TABLE IF NOT EXISTS thread_preferences (
+                id TEXT PRIMARY KEY,
+                client_id TEXT NOT NULL,
+                profile_id TEXT NOT NULL,
+                thread_key TEXT NOT NULL,
+                content TEXT NOT NULL,
+                memory_class TEXT NOT NULL,
+                classification TEXT NOT NULL,
+                created_at TEXT NOT NULL
+            )
+            """
+        )
+        self._conn.execute(
+            "CREATE INDEX IF NOT EXISTS ix_thread_prefs_scope ON thread_preferences (client_id, profile_id, thread_key)"
+        )
+        self._conn.commit()
+        return self
+
+    def close(self) -> None:
+        if self._conn is not None:
+            self._conn.close()
+            self._conn = None
+
+    def _ensure(self) -> sqlite3.Connection:
+        if self._conn is None:
+            self.open()
+        assert self._conn is not None
+        return self._conn
+
+    def put(
+        self, client_id: str, profile_id: str, thread_key: Optional[str], content: str, classification: Any
+    ) -> bool:
+        """Insert a thread-scoped preference. Idempotent. Returns True if new."""
+        conn = self._ensure()
+        tk = thread_key or _UNSCOPED
+        cls_dict = classification.to_dict() if hasattr(classification, "to_dict") else dict(classification)
+        row_id = _det_id(client_id or "", profile_id or "", tk, content or "")
+        cur = conn.execute(
+            "INSERT OR IGNORE INTO thread_preferences "
+            "(id, client_id, profile_id, thread_key, content, memory_class, classification, created_at) "
+            "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+            (
+                row_id,
+                client_id or "",
+                profile_id or "",
+                tk,
+                content or "",
+                str(cls_dict.get("scope", "thread")),
+                json.dumps(cls_dict, default=str),
+                _now_iso(),
+            ),
+        )
+        conn.commit()
+        return cur.rowcount > 0
+
+    def list(self, client_id: str, profile_id: str, thread_key: Optional[str] = None) -> list:
+        """Return preferences for a scope (all threads if thread_key is None).
+
+        Each row is a dict: thread_key, content, memory_class, created_at.
+        """
+        conn = self._ensure()
+        if thread_key:
+            cur = conn.execute(
+                "SELECT thread_key, content, memory_class, created_at FROM thread_preferences "
+                "WHERE client_id=? AND profile_id=? AND thread_key=? "
+                "ORDER BY created_at DESC",
+                (client_id or "", profile_id or "", thread_key),
+            )
+        else:
+            cur = conn.execute(
+                "SELECT thread_key, content, memory_class, created_at FROM thread_preferences "
+                "WHERE client_id=? AND profile_id=? ORDER BY created_at DESC",
+                (client_id or "", profile_id or ""),
+            )
+        cols = [d[0] for d in cur.description]
+        return [dict(zip(cols, r)) for r in cur.fetchall()]
