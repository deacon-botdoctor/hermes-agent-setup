+def _try_broker_grok_alternative(agent, pool, reason):
+    # HERMES_GROK_SUBSCRIPTION_FAILOVER_v1
+    if agent.provider != "xai-oauth" or pool.provider != "xai-oauth":
+        return None
+    from hermes_cli.auth import _xai_access_token_is_expiring, read_credential_pool
+    from agent.credential_pool import PooledCredential
+
+    request = (getattr(agent, "_current_turn_id", None),
+               getattr(agent, "_api_call_count", None))
+    if getattr(agent, "_grok_failover_request", None) != request:
+        agent._grok_failover_request = request
+        agent._grok_failover_tried = set()
+    tried = agent._grok_failover_tried
+    failed_id = (getattr(agent, "_credential_pool_entry_id", None)
+                 or pool._current_id)
+    if not failed_id:
+        return False
+    tried.add(failed_id)
+    if len(tried) >= 3:
+        return False
+    # Capacity does not establish an exhausted subscription. Do not persist
+    # an exhausted/dead status or let a consumer refresh a broker credential.
+    with pool._lock:
+        managed = lambda e: (e.source.startswith("manual:broker_grok")
+                            or (e.source == "device_code" and e.id == "xai-broker"))
+        if not any(managed(e) for e in pool._entries):
+            return None
+        try:
+            fresh = [PooledCredential.from_dict("xai-oauth", row)
+                     for row in read_credential_pool("xai-oauth")]
+        except Exception:
+            return False
+        if (not fresh or len(fresh) > 3 or len({e.id for e in fresh}) != len(fresh)
+                or any(not managed(e) or e.refresh_token != "dummy_broker_managed"
+                       for e in fresh)):
+            return False
+        # Adopt the broker's atomic access snapshot without persisting stale members.
+        pool._entries = fresh
+        # Keep native quota/auth recovery when the failed account still exists.
+        # A retired failed account must not receive the native same-account retry.
+        if (reason not in {FailoverReason.overloaded, FailoverReason.timeout}
+                and failed_id in {e.id for e in fresh}):
+            return None
+        available, _pending_refresh = pool._available_entries()
+        for entry in available:
+            if (not (entry.source.startswith("manual:broker_grok")
+                     or (entry.source == "device_code" and entry.id == "xai-broker"))
+                    or entry.refresh_token != "dummy_broker_managed"
+                    or not entry.access_token or entry.id in tried
+                    or _xai_access_token_is_expiring(entry.access_token, 120)):
+                continue
+            tried.add(entry.id)
+            if agent._swap_credential(entry) is not False:
+                pool._current_id = entry.id
+                return True
+    return False
+
+
+def _broker_codex_quota(entry, timeout):
+    import json, math, time
+    from urllib.request import Request, urlopen
+    from agent.codex_headers import codex_account_headers
+    from agent.credential_pool import _codex_principal_identity
+    identity = _codex_principal_identity(entry.access_token)
+    expected = (entry.extra.get('broker_account_id'), entry.extra.get('broker_subject'))
+    if not identity or identity != expected:
+        return False
+    headers = codex_account_headers(entry.access_token)
+    headers.update(Authorization='Bearer ' + entry.access_token, Accept='application/json',
+                   **{'User-Agent': 'HermesAgent'})
+    try:
+        request = Request('https://chatgpt.com/backend-api/wham/usage', headers=headers)
+        with urlopen(request, timeout=timeout) as response:
+            rate = json.load(response).get('rate_limit') or {}
+        windows = [rate[k] for k in ('primary_window', 'secondary_window')
+                   if isinstance(rate.get(k), dict)]
+        if rate.get('allowed') is not True or not windows:
+            return False
+        now = time.time()
+        return all(isinstance(w.get('used_percent'), (int, float))
+                   and not isinstance(w['used_percent'], bool)
+                   and math.isfinite(w['used_percent']) and 0 <= w['used_percent'] <= 80
+                   and isinstance(w.get('reset_at'), (int, float))
+                   and not isinstance(w['reset_at'], bool)
+                   and math.isfinite(w['reset_at']) and w['reset_at'] > now for w in windows)
+    except Exception:
+        return False
+
+
+def _broker_codex_entries(pool):
+    from hermes_cli.auth import read_credential_pool
+    from agent.credential_pool import PooledCredential
+    return [PooledCredential.from_dict(pool.provider, row)
+            for row in read_credential_pool(pool.provider) if isinstance(row, dict)]
+
+
+def _broker_codex_request(agent):
+    return (getattr(agent, '_current_turn_id', None), getattr(agent, '_api_call_count', None))
+
+
+def _try_broker_codex_alternative(agent, pool, reason, messages):
+    # HERMES_CODEX_SUBSCRIPTION_FAILOVER_v1
+    if agent.provider != 'openai-codex' or pool.provider != 'openai-codex':
+        return None
+    entries = pool.entries()
+    managed = [e for e in entries if e.extra.get('broker_codex_failover') == 1]
+    if not managed:
+        return None
+    # Do not let generic recovery refresh dummy tokens or select unmanaged rows.
+    if (len(entries) != len(managed) or len(entries) > 5 or messages is None
+            or reason not in {FailoverReason.rate_limit, FailoverReason.billing,
+                              FailoverReason.overloaded, FailoverReason.timeout, FailoverReason.auth}):
+        return False
+    # Encrypted compaction can be the only remaining record of prior context.
+    # Preserve it and stop account rotation rather than silently lose that context.
+    if any(m.get('codex_compaction_items') for m in messages if isinstance(m, dict)):
+        return False
+    import time
+    from hermes_cli.auth import _codex_access_token_is_expiring
+    request = _broker_codex_request(agent)
+    if getattr(agent, '_codex_broker_request', None) != request:
+        agent._codex_broker_request = request
+        agent._codex_broker_tried = set()
+        agent._codex_broker_deadline = time.monotonic() + 60
+        agent._codex_broker_adopted = False
+    remaining = agent._codex_broker_deadline - time.monotonic()
+    if remaining <= 0:
+        return False
+    failed_id = getattr(agent, '_credential_pool_entry_id', None) or pool._current_id
+    if not failed_id:
+        return False
+    try:
+        fresh = _broker_codex_entries(pool)
+    except Exception:
+        return False
+    if (not fresh or len(fresh) > 5 or len({e.id for e in fresh}) != len(fresh)
+            or any(e.extra.get('broker_codex_failover') != 1
+                   or e.refresh_token != 'dummy_broker_managed' for e in fresh)):
+        return False
+    with pool._lock:
+        # Access copies and membership come from Spark's latest atomic snapshot.
+        pool._entries = fresh
+        available, _pending = pool._available_entries(model=getattr(agent, 'model', None))
+    # A centrally renewed token may repair 401 without changing principals.
+    current = next((e for e in available if e.id == failed_id), None)
+    if (reason == FailoverReason.auth and current and current.access_token != agent.api_key
+            and not agent._codex_broker_adopted and current.refresh_token == 'dummy_broker_managed'
+            and not _codex_access_token_is_expiring(current.access_token, 120)
+            and _broker_codex_quota(current, min(3, remaining))):
+        agent._codex_broker_adopted = True
+        return agent._swap_credential(current) is not False
+    tried = agent._codex_broker_tried
+    tried.add(failed_id)
+    if len(tried) >= 5:
+        return False
+    for entry in available:
+        if (entry.id in tried or entry.refresh_token != 'dummy_broker_managed'
+                or not entry.access_token or entry.extra.get('broker_codex_failover') != 1
+                or _codex_access_token_is_expiring(entry.access_token, 120)
+                or entry.base_url != agent.base_url):
+            continue
+        tried.add(entry.id)
+        remaining = agent._codex_broker_deadline - time.monotonic()
+        if remaining <= 0:
+            return False
+        if not _broker_codex_quota(entry, min(3, remaining)):
+            continue
+        if agent._swap_credential(entry) is False:
+            continue
+        with pool._lock:
+            pool._current_id = entry.id
+        # Replay plaintext messages and completed tool results, not another
+        # account's encrypted reasoning. No transcript or tool state is edited.
+        agent._codex_reasoning_replay_enabled = False
+        return True
+    return False
+
+
+def _broker_codex_retry_timeout(agent, kwargs):
+    if (agent.provider == 'openai-codex'
+            and getattr(agent, '_codex_broker_request', None) == _broker_codex_request(agent)):
+        import time
+        remaining = agent._codex_broker_deadline - time.monotonic()
+        if remaining <= 0:
+            raise TimeoutError('Codex subscription recovery deadline exhausted')
+        configured = kwargs.get('timeout')
+        kwargs['timeout'] = min(configured, remaining) if isinstance(configured, (int, float)) else remaining
+    return kwargs
