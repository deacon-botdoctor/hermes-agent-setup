@@ -0,0 +1,244 @@
+"""workers/memory/anamnesis/summarize.py — anamnesis-chunks summarize (v8).
+
+Per docs/specs/hermes-worker-decomposition-v8.md §5.2.
+
+Reads anamnesis chunks (transcript records) AND memories. Returns text
+summary. Caller decides whether to memory::store the summary.
+
+Differs from v4 memory-summarize (which read state.db.messages):
+- Source is anamnesis chunks/memories (chunks have session_id which maps
+  to durable-threads.db.agent_threads.session_key for thread→chunks)
+- Filters by client_id (scope) AND optional container
+
+Phase 5.3b ships heuristic placeholder (head + tail slice + memory bullets).
+Real LLM-backed summarization integrates the provider chain in batch 5.3c.
+
+Args (memory::summarize):
+    thread_id (str, optional) — restrict to a thread; if absent, summarizes
+        recent chunks from container
+    container (str, optional) — namespace filter
+    target_tokens (int, default 1000)
+    max_chunks (int, default 50, max 500)
+    include_memories (bool, default True) — also pull recent memories in
+        same container
+
+Returns:
+    {ok: True, data: {summary, chunks_considered, memories_considered,
+                      tokens_in_estimate, tokens_out_estimate, provider}}
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+import sqlite3
+from typing import Any, Dict, List, Optional
+
+from ..._ipc.envelope import Envelope, ErrorCode
+from ..._ipc.server import HandlerError
+
+
+logger = logging.getLogger(__name__)
+
+
+DEFAULT_MAX_CHUNKS = 50
+HARD_MAX_CHUNKS = 500
+DEFAULT_TARGET_TOKENS = 1000
+LEGACY_SENTINEL = "_legacy"
+
+
+class AnamnesisSummarizeWorker:
+    """memory::summarize handler over anamnesis substrate.
+
+    Read-only over ~/.anamnesis/memory.db AND ~/.hermes/profiles/<p>/data/
+    durable-threads.db (latter for thread_id -> session_key mapping).
+    """
+
+    def __init__(self, memory_db_path: str, durable_db_path: Optional[str] = None):
+        self.memory_db_path = memory_db_path
+        self.durable_db_path = durable_db_path
+        self._mem_conn: Optional[sqlite3.Connection] = None
+        self._dur_conn: Optional[sqlite3.Connection] = None
+        self._lock = asyncio.Lock()
+
+    def open(self) -> None:
+        self._mem_conn = sqlite3.connect(
+            f"file:{self.memory_db_path}?mode=ro",
+            uri=True, isolation_level=None, check_same_thread=False,
+        )
+        self._mem_conn.execute("PRAGMA busy_timeout=5000")
+        if self.durable_db_path:
+            self._dur_conn = sqlite3.connect(
+                f"file:{self.durable_db_path}?mode=ro",
+                uri=True, isolation_level=None, check_same_thread=False,
+            )
+            self._dur_conn.execute("PRAGMA busy_timeout=5000")
+
+    def close(self) -> None:
+        for c in (self._mem_conn, self._dur_conn):
+            if c is not None:
+                try:
+                    c.close()
+                except sqlite3.Error:
+                    pass
+        self._mem_conn = None
+        self._dur_conn = None
+
+    async def handle_summarize(self, env: Envelope) -> Dict[str, Any]:
+        args = env.args
+        thread_id = args.get("thread_id")
+        container = args.get("container")
+        target_tokens = args.get("target_tokens", DEFAULT_TARGET_TOKENS)
+        max_chunks = args.get("max_chunks", DEFAULT_MAX_CHUNKS)
+        include_memories = bool(args.get("include_memories", True))
+
+        try:
+            target_tokens = int(target_tokens)
+            max_chunks = int(max_chunks)
+        except (TypeError, ValueError):
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               "args.target_tokens and args.max_chunks must be int",
+                               retryable=False)
+        max_chunks = max(1, min(HARD_MAX_CHUNKS, max_chunks))
+
+        if thread_id is not None and not isinstance(thread_id, str):
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               "args.thread_id must be string", retryable=False)
+        if container is not None and not isinstance(container, str):
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               "args.container must be string", retryable=False)
+
+        client_id = env.scope.client_id
+
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._do_summarize_sync,
+                thread_id, container, target_tokens, max_chunks,
+                include_memories, client_id,
+            )
+
+    def _do_summarize_sync(
+        self,
+        thread_id: Optional[str],
+        container: Optional[str],
+        target_tokens: int,
+        max_chunks: int,
+        include_memories: bool,
+        client_id: str,
+    ) -> Dict[str, Any]:
+        assert self._mem_conn is not None
+
+        # Resolve thread_id -> session_keys via durable-threads.db
+        session_keys: List[str] = []
+        if thread_id is not None and self._dur_conn is not None:
+            try:
+                rows = self._dur_conn.execute(
+                    """SELECT DISTINCT session_key FROM agent_threads
+                        WHERE thread_id = ? AND session_key IS NOT NULL
+                        ORDER BY started_at DESC LIMIT 50""",
+                    (thread_id,),
+                ).fetchall()
+                session_keys = [r[0] for r in rows if r[0]]
+            except sqlite3.OperationalError as exc:
+                logger.warning("durable-threads lookup failed: %s", exc)
+
+        # Read chunks
+        chunks: List[tuple] = []
+        chunk_clauses = ["c.client_id IN (?, ?)"]
+        chunk_params: List[Any] = [client_id, LEGACY_SENTINEL]
+        if container:
+            chunk_clauses.append("c.container_id = ?")
+            chunk_params.append(container)
+        if session_keys:
+            ph = ",".join("?" * len(session_keys))
+            chunk_clauses.append(f"c.session_id IN ({ph})")
+            chunk_params.extend(session_keys)
+        chunk_where = " AND ".join(chunk_clauses)
+
+        try:
+            chunks = self._mem_conn.execute(
+                f"""SELECT c.role, c.content, c.document_date, c.session_id
+                      FROM chunks c
+                     WHERE {chunk_where}
+                     ORDER BY c.document_date ASC
+                     LIMIT ?""",
+                [*chunk_params, max_chunks],
+            ).fetchall()
+        except sqlite3.OperationalError as exc:
+            logger.warning("chunks query failed (schema?): %s", exc)
+            chunks = []
+
+        memories: List[tuple] = []
+        if include_memories:
+            mem_clauses = ["m.client_id IN (?, ?)",
+                           "m.superseded_by IS NULL", "m.forgotten_at IS NULL"]
+            mem_params: List[Any] = [client_id, LEGACY_SENTINEL]
+            if container:
+                mem_clauses.append("m.container_id = ?")
+                mem_params.append(container)
+            mem_where = " AND ".join(mem_clauses)
+            try:
+                memories = self._mem_conn.execute(
+                    f"""SELECT m.content, m.memory_type, m.priority, m.document_date
+                          FROM memories m
+                         WHERE {mem_where}
+                         ORDER BY m.document_date DESC
+                         LIMIT 20""",
+                    mem_params,
+                ).fetchall()
+            except sqlite3.OperationalError:
+                memories = []
+
+        if not chunks and not memories:
+            return {"ok": True, "data": {
+                "summary": f"(no chunks or memories found for client_id={client_id!r}"
+                           f"{', thread_id=' + thread_id if thread_id else ''}"
+                           f"{', container=' + container if container else ''})",
+                "chunks_considered": 0,
+                "memories_considered": 0,
+                "tokens_in_estimate": 0,
+                "tokens_out_estimate": 0,
+                "provider": "heuristic-v1",
+            }}
+
+        # Heuristic placeholder. Real LLM lands in batch 5.3c.
+        chars_budget = target_tokens * 4
+        head_n, tail_n = 5, 5
+        parts: List[str] = []
+
+        if chunks:
+            parts.append(f"Conversation chunks ({len(chunks)}):")
+            if len(chunks) <= head_n + tail_n:
+                for r in chunks:
+                    parts.append(f"  [{r[0]}] {(r[1] or '')[:200]}")
+            else:
+                for r in chunks[:head_n]:
+                    parts.append(f"  [{r[0]}] {(r[1] or '')[:200]}")
+                parts.append(f"  ... ({len(chunks) - head_n - tail_n} omitted) ...")
+                for r in chunks[-tail_n:]:
+                    parts.append(f"  [{r[0]}] {(r[1] or '')[:200]}")
+
+        if memories:
+            parts.append(f"\nDistilled memories ({len(memories)}):")
+            for r in memories[:10]:
+                priority_marker = {"critical": "[CRIT]", "notable": "[NOTE]",
+                                   "background": "[BG]", "normal": "."}.get(r[2], ".")
+                parts.append(f"  {priority_marker} [{r[1]}] {(r[0] or '')[:200]}")
+
+        summary = "\n".join(parts)
+        if len(summary) > chars_budget:
+            summary = summary[:chars_budget - 4] + " ..."
+
+        tokens_in = (
+            sum(len(c[1] or "") for c in chunks)
+            + sum(len(m[0] or "") for m in memories)
+        ) // 4
+        tokens_out = len(summary) // 4
+
+        return {"ok": True, "data": {
+            "summary": summary,
+            "chunks_considered": len(chunks),
+            "memories_considered": len(memories),
+            "tokens_in_estimate": tokens_in,
+            "tokens_out_estimate": tokens_out,
+            "provider": "heuristic-v1",
+        }}
