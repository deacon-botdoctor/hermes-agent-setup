@@ -0,0 +1,372 @@
+"""workers/memory/anamnesis/recall.py — anamnesis recall handlers (v8).
+
+Per docs/specs/hermes-worker-decomposition-v8.md §5.2.
+
+Implements:
+  Function: memory::recall (native worker namespace)
+  Plus the 7 anamnesis_* read-tool dispatch surface (used by
+  anamnesis_compat_mcp shim in Phase 5.3d).
+
+Substrate: ~/.anamnesis/memory.db (read-only WAL connection) + Qdrant
+(via injected client; mock in tests).
+
+This worker handles the FTS5 path natively; vector + hybrid paths require
+an injected Qdrant client (see batch 5.3d for production wiring).
+
+Args (memory::recall):
+    query (str, required) — search query
+    container (str, optional) — namespace filter
+    limit (int, default 10, max 100)
+    retrieval_mode (str, default 'fts') — fts|vector|hybrid
+    types (list, optional) — memory_type filter
+    priority (str, optional) — priority filter
+    include_legacy (bool, default false)
+
+Returns:
+    {ok: True, data: {hits: [{memory_id, content, container_id, ...,
+                              combined_score}], count, mode}}
+
+Filters by env.scope.client_id (per-tenant isolation).
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+import re
+import json
+import os
+from pathlib import Path
+import sqlite3
+import subprocess
+from typing import Any, Dict, List, Optional
+
+from ..._ipc.envelope import Envelope, ErrorCode
+from ..._ipc.server import HandlerError
+
+
+logger = logging.getLogger(__name__)
+
+
+VALID_MODES = {"fts", "vector", "hybrid"}
+VALID_CONTAINERS = {"default", "work", "personal", "research", "clients", "archive"}
+DEFAULT_LIMIT = 10
+MAX_LIMIT = 100
+LEGACY_SENTINEL = "_legacy"
+# [HERMES_ANAMNESIS_DOCTRINE_RECALL_v1] shared pseudo-client for doctrine-sync rules (MEMORY.md/USER.md)
+DOCTRINE_SENTINEL = "doctrine-sync"
+
+# [HERMES_SPEC006_FLEET_LAYOUT_COMPAT_v1 anamnesis-worker-leann]
+LEANN_BIN = os.environ.get("LEANN_BIN", os.path.expanduser("~/.local/bin/leann"))
+LEANN_INDEXES = os.environ.get("ANAMNESIS_LEANN_INDEXES", "hermes-brain,hermes-sessions")
+LEANN_TIMEOUT = float(os.environ.get("ANAMNESIS_LEANN_TIMEOUT", "8"))
+LEANN_TOP_K = int(os.environ.get("ANAMNESIS_LEANN_TOP_K", "5"))
+
+def _load_leann_env() -> dict[str, str]:
+    env = dict(os.environ)
+    dotenv = Path(os.environ.get("HERMES_HOME", os.path.expanduser("~/.hermes"))) / ".env"
+    try:
+        for raw in dotenv.read_text(encoding="utf-8").splitlines():
+            line = raw.strip()
+            if not line or line.startswith("#") or "=" not in line:
+                continue
+            key, value = line.split("=", 1)
+            env.setdefault(key.strip(), value.strip().strip('"').strip("'"))
+    except OSError:
+        pass
+    if not env.get("OPENAI_API_KEY") and env.get("OPENROUTER_API_KEY"):
+        env["OPENAI_API_KEY"] = env["OPENROUTER_API_KEY"]
+    env.setdefault("OPENAI_BASE_URL", "https://openrouter.ai/api/v1")
+    return env
+
+def _extract_leann_json_array(text: str) -> list[Any]:
+    decoder = json.JSONDecoder()
+    for match in reversed(list(re.finditer(r"\[", text))):
+        try:
+            data, _ = decoder.raw_decode(text[match.start():])
+        except json.JSONDecodeError:
+            continue
+        if isinstance(data, list):
+            return data
+    return []
+
+def leann_semantic_hits(query: str, limit: int, client_id: str) -> list[dict[str, Any]]:
+    if os.environ.get("ANAMNESIS_LEANN_ENABLED", "1").lower() in {"0", "false", "no", "off"}:
+        return []
+    leann = Path(LEANN_BIN).expanduser()
+    if not leann.exists():
+        return []
+    indexes = [i.strip() for i in LEANN_INDEXES.split(",") if i.strip()]
+    if not indexes:
+        return []
+    per_index = max(1, min(LEANN_TOP_K, limit))
+    env = _load_leann_env()
+    hits: list[dict[str, Any]] = []
+    seen: set[str] = set()
+    for index in indexes:
+        cmd = [str(leann), "search", index, query, "--top-k", str(per_index), "--complexity", "16", "--json", "--non-interactive", "--show-metadata"]
+        try:
+            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=LEANN_TIMEOUT, env=env, cwd=str(Path.home()))
+        except (OSError, subprocess.TimeoutExpired):
+            continue
+        if proc.returncode != 0:
+            continue
+        for rank, item in enumerate(_extract_leann_json_array(proc.stdout + proc.stderr), start=1):
+            if not isinstance(item, dict):
+                continue
+            content = str(item.get("text") or "").strip()
+            if not content:
+                continue
+            metadata = item.get("metadata") if isinstance(item.get("metadata"), dict) else {}
+            source = str(metadata.get("file_path") or metadata.get("source") or index)
+            key = f"{index}:{source}:{content[:160]}"
+            if key in seen:
+                continue
+            seen.add(key)
+            score = item.get("score", item.get("similarity", 0.0))
+            try:
+                score = float(score)
+            except (TypeError, ValueError):
+                score = 0.0
+            hits.append({
+                "memory_id": f"leann:{index}:{rank}",
+                "content": content,
+                "container_id": "leann",
+                "document_date": None,
+                "event_date": None,
+                "confidence": max(0.0, min(1.0, score)) if score else 0.5,
+                "client_id": client_id,
+                "memory_type": "semantic",
+                "priority": "background",
+                "vector_status": "leann",
+                "combined_score": -abs(score) if score else 0.0,
+                "source": source,
+                "leann_index": index,
+            })
+            if len(hits) >= limit:
+                return hits
+    return hits
+
+
+def build_fts_query(query: str) -> str:
+    """Convert loose natural-language input into a safe FTS5 query.
+
+    Mirrors anamnesis server.py's build_fts_query — same tokenization rules
+    so parity tests get equivalent FTS5 ranking.
+    """
+    tokens = re.findall(r"[A-Za-z0-9_]+", query.lower())
+    if not tokens:
+        return query
+    return " AND ".join(f'"{token}"' for token in tokens)
+
+
+class AnamnesisRecallWorker:
+    """memory::recall + anamnesis_* read-tool dispatch.
+
+    Read-only over ~/.anamnesis/memory.db. Optionally takes injected
+    QdrantClient + OllamaClient for vector/hybrid modes (None → fts-only,
+    matches existing anamnesis fall-through behavior).
+    """
+
+    def __init__(
+        self,
+        memory_db_path: str,
+        *,
+        qdrant_client: Any = None,
+        ollama_client: Any = None,
+    ):
+        self.memory_db_path = memory_db_path
+        self._qdrant = qdrant_client
+        self._ollama = ollama_client
+        self._conn: Optional[sqlite3.Connection] = None
+        self._lock = asyncio.Lock()
+
+    def open(self) -> None:
+        # Read-only WAL connection; sees committed writes via WAL snapshot.
+        self._conn = sqlite3.connect(
+            f"file:{self.memory_db_path}?mode=ro",
+            uri=True,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        self._conn.execute("PRAGMA busy_timeout=5000")
+
+    def close(self) -> None:
+        if self._conn is not None:
+            self._conn.close()
+            self._conn = None
+
+    async def handle_recall(self, env: Envelope) -> Dict[str, Any]:
+        args = env.args
+        query = args.get("query")
+        container = args.get("container")
+        limit = args.get("limit", DEFAULT_LIMIT)
+        mode = str(args.get("retrieval_mode", "fts"))
+        types_filter = args.get("types")
+        priority_filter = args.get("priority")
+        include_legacy = bool(args.get("include_legacy", False))
+        rerank_flag = bool(args.get("rerank", False))
+
+        # Validation
+        if not isinstance(query, str) or not query.strip():
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               "args.query is required", retryable=False)
+        if mode not in VALID_MODES:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               f"args.retrieval_mode must be in {sorted(VALID_MODES)}",
+                               retryable=False)
+        if container is not None and container not in VALID_CONTAINERS:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               f"args.container must be in {sorted(VALID_CONTAINERS)}",
+                               retryable=False)
+        try:
+            limit = int(limit)
+        except (TypeError, ValueError):
+            raise HandlerError(ErrorCode.INVALID_INPUT, "args.limit must be int",
+                               retryable=False)
+        limit = max(1, min(MAX_LIMIT, limit))
+
+        if types_filter is not None:
+            if not isinstance(types_filter, list) or not all(isinstance(t, str) for t in types_filter):
+                raise HandlerError(ErrorCode.INVALID_INPUT,
+                                   "args.types must be list of strings", retryable=False)
+
+        client_id = env.scope.client_id
+
+        # If vector or hybrid mode requested but no Qdrant injected, fall back
+        # to FTS (matches existing anamnesis fall-through behavior; soft-degrade
+        # rather than hard error).
+        effective_mode = mode
+        if mode in ("vector", "hybrid") and self._qdrant is None:
+            logger.warning("vector/hybrid requested but Qdrant client not injected; falling back to FTS")
+            effective_mode = "fts"
+
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._do_recall_sync,
+                query, effective_mode, limit, container,
+                types_filter, priority_filter,
+                client_id, include_legacy, rerank_flag,
+            )
+
+    def _do_recall_sync(
+        self,
+        query: str,
+        mode: str,
+        limit: int,
+        container: Optional[str],
+        types_filter: Optional[List[str]],
+        priority_filter: Optional[str],
+        client_id: str,
+        include_legacy: bool,
+        rerank_flag: bool = False,
+    ) -> Dict[str, Any]:
+        assert self._conn is not None
+
+        # Build common WHERE clauses
+        clauses = ["m.superseded_by IS NULL", "m.forgotten_at IS NULL"]
+        params: List[Any] = []
+
+        # [HERMES_ANAMNESIS_DOCTRINE_RECALL_v1] always include this tenant's own doctrine-sync rules
+        # (isolation-safe: per-tenant local DB, so only THIS tenant's rules match).
+        if include_legacy:
+            clauses.append("(m.client_id = ? OR m.client_id = ? OR m.client_id = ?)")
+            params.extend([client_id, LEGACY_SENTINEL, DOCTRINE_SENTINEL])
+        else:
+            clauses.append("(m.client_id = ? OR m.client_id = ?)")
+            params.extend([client_id, DOCTRINE_SENTINEL])
+
+        if container:
+            clauses.append("m.container_id = ?")
+            params.append(container)
+
+        if types_filter:
+            ph = ",".join("?" * len(types_filter))
+            clauses.append(f"m.memory_type IN ({ph})")
+            params.extend(types_filter)
+
+        if priority_filter:
+            clauses.append("m.priority = ?")
+            params.append(priority_filter)
+
+        where = " AND ".join(clauses)
+
+        if mode == "fts":
+            fetch_limit = min(limit * 3, MAX_LIMIT) if rerank_flag else limit
+            result = self._fts_search(query, where, params, fetch_limit)
+            if result.get("ok"):
+                existing = result.setdefault("data", {}).setdefault("hits", [])
+                seen_content = {str(hit.get("content", ""))[:160] for hit in existing if isinstance(hit, dict)}
+                for hit in leann_semantic_hits(query, limit, client_id):
+                    key = str(hit.get("content", ""))[:160]
+                    if key and key not in seen_content:
+                        existing.append(hit)
+                        seen_content.add(key)
+                if rerank_flag:
+                    from .reranker import rerank as _rerank
+                    existing = _rerank(query, existing, limit)
+                    result["data"]["hits"] = existing
+                else:
+                    result["data"]["hits"] = existing[:limit]
+                result["data"]["count"] = len(result["data"]["hits"])
+            return result
+        # mode == 'vector' / 'hybrid' would call self._qdrant — Phase 5.3d wiring.
+        # For Phase 5.3a, only FTS is implemented. Vector + hybrid stub:
+        raise HandlerError(ErrorCode.INVALID_INPUT,
+                           f"mode={mode!r} requires Qdrant client (Phase 5.3d wiring)",
+                           retryable=False)
+
+    def _fts_search(
+        self, query: str, where: str, params: List[Any], limit: int,
+    ) -> Dict[str, Any]:
+        """SQLite FTS5 path — matches anamnesis server.py fts_search semantics."""
+        assert self._conn is not None
+        fts_query = build_fts_query(query)
+        sql = f"""
+            SELECT m.id, m.content, m.container_id, m.document_date,
+                   m.event_date, m.confidence, m.client_id,
+                   m.memory_type, m.priority, m.vector_status,
+                   memories_fts.rank AS combined_score
+              FROM memories_fts
+              JOIN memories m ON memories_fts.memory_id = m.id
+             WHERE memories_fts MATCH ? AND {where}
+             ORDER BY combined_score
+             LIMIT ?
+        """
+        try:
+            rows = self._conn.execute(sql, [fts_query, *params, limit]).fetchall()
+        except sqlite3.OperationalError as exc:
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               f"FTS5 query rejected: {exc}", retryable=False)
+
+        hits = [{
+            "memory_id": r[0],
+            "content": r[1],
+            "container_id": r[2],
+            "document_date": r[3],
+            "event_date": r[4],
+            "confidence": r[5],
+            "client_id": r[6],
+            "memory_type": r[7],
+            "priority": r[8],
+            "vector_status": r[9],
+            "combined_score": r[10],
+        } for r in rows]
+
+        # [HERMES_ANAMNESIS_V8_RECENCY_EXP_30D_v1] normalize FTS + exp 30-day recency, 65/35 fts/recency weight
+        if hits:
+            import math
+            from datetime import datetime as _dt, timezone as _tz
+            _now = _dt.now(_tz.utc)
+            _fts_abs = [abs(h.get("combined_score") or 0.0) for h in hits]
+            _max_fts = max(_fts_abs) or 1.0
+            for _h in hits:
+                try:
+                    _d = _dt.fromisoformat((_h.get("document_date") or "").replace("Z", "+00:00"))
+                    _days_ago = (_now - _d).total_seconds() / 86400.0
+                    _recency = math.exp(-_days_ago * 0.693147 / 30.0)
+                except (ValueError, TypeError, AttributeError):
+                    _recency = 0.0
+                _fts_norm = abs(_h.get("combined_score") or 0.0) / _max_fts
+                _h["combined_score"] = (_fts_norm * 0.65 + _recency * 0.35) * float(_h.get("confidence") or 1.0)  # [HERMES_ANAMNESIS_V8_CONFIDENCE_MULT_v1]
+            hits.sort(key=lambda x: x["combined_score"], reverse=True)
+        return {"ok": True, "data": {"hits": hits, "count": len(hits), "mode": "fts"}}
