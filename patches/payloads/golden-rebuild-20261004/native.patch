+"""
+tools/log_promise_tool.py — explicit promise logging for the agent.
+
+When an agent commits to future work it SHOULD call this tool to record
+the commitment durably. The agent's SOUL.md should encourage this over
+implicit "I'll check back later" statements that rely on LLM extraction.
+
+Tool name: log_promise
+Toolset:   durability
+
+Args:
+  promise_text         (str)  — the commitment, paraphrased or verbatim
+  trigger_type         (str)  — 'time' | 'user_action' | 'agent_condition'
+  trigger_condition    (str)  — concise description of when the promise fires
+  due_at_iso           (str)  — optional ISO datetime if time-based
+
+Returns: { ok: bool, promise_id: str | null, error: str | null }
+"""
+
+from __future__ import annotations
+
+import datetime as _dt
+import json
+import logging
+import os
+import sqlite3
+from pathlib import Path
+from typing import Any
+
+logger = logging.getLogger("tools.log_promise")
+
+
+# Schema for tool registry — discoverable via tools.registry
+LOG_PROMISE_SCHEMA = {
+    "name": "log_promise",
+    "description": (
+        "Durably record a commitment to future action. Call this whenever "
+        "you say you will do something later — checking back, sending an "
+        "update, following up after an event. Logged promises are tracked "
+        "by the durable runtime; if you forget, the system will re-engage "
+        "you when the trigger fires. NEVER rely on memory alone for "
+        "future commitments."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "promise_text": {
+                "type": "string",
+                "description": "Concise statement of what you committed to do."
+            },
+            "trigger_type": {
+                "type": "string",
+                "enum": ["time", "user_action", "agent_condition"],
+                "description": (
+                    "What kind of trigger fires this promise:\n"
+                    "  time            — at a specific datetime / after a duration\n"
+                    "  user_action     — waiting for the user to do or say something\n"
+                    "  agent_condition — tied to an external condition you'll check"
+                ),
+            },
+            "trigger_condition": {
+                "type": "string",
+                "description": (
+                    "Concise description of when the promise fires. For "
+                    "time-based: the time descriptor (e.g. 'tomorrow 9am'). "
+                    "For user_action: what the user must do. For "
+                    "agent_condition: the check you'll perform."
+                ),
+            },
+            "due_at_iso": {
+                "type": "string",
+                "description": (
+                    "Optional ISO 8601 UTC datetime if time-based and "
+                    "specific. Required for sweeper-driven re-engagement."
+                ),
+            },
+        },
+        "required": ["promise_text", "trigger_type", "trigger_condition"],
+    },
+}
+
+
+def log_promise_tool(args: dict, **kwargs: Any) -> str:
+    """
+    Tool handler. Returns a JSON string with {ok, promise_id, error}.
+
+    Reads runtime context from kwargs / globals to identify the current
+    chain/thread/run. The runtime injects these via the agent's
+    self._sb_current_rs that we set in stage_b_hooks._install_tool_dispatcher_wrap.
+    """
+    try:
+        from agent.idempotency import durable_write
+    except ImportError:
+        durable_write = None  # tool still works; classification is metadata
+
+    promise_text = str(args.get("promise_text", "")).strip()
+    trigger_type = str(args.get("trigger_type", "")).strip()
+    trigger_condition = str(args.get("trigger_condition", "")).strip()
+    due_at_iso = args.get("due_at_iso")
+
+    if not promise_text:
+        return _err("promise_text is required")
+    if trigger_type not in ("time", "user_action", "agent_condition"):
+        return _err("trigger_type must be one of: time, user_action, agent_condition")
+    if not trigger_condition:
+        return _err("trigger_condition is required")
+
+    # Parse due_at if provided.
+    due_at = None
+    if due_at_iso:
+        try:
+            parsed = _dt.datetime.fromisoformat(
+                str(due_at_iso).replace("Z", "+00:00")
+            )
+            due_at = int(parsed.timestamp())
+        except (ValueError, TypeError) as exc:
+            return _err(f"due_at_iso parse failed: {exc}")
+
+    # Find the agent's current StageBRunState. The wrap installer at
+    # _install_tool_dispatcher_wrap stashes self._sb_current_rs.
+    agent = kwargs.get("agent") or kwargs.get("self")
+    rs = getattr(agent, "_sb_current_rs", None) if agent is not None else None
+    if rs is None or not getattr(rs, "enabled", False):
+        # Stage B not enabled — promise tool can't durably record.
+        # Fall back to logging a warning. This makes the tool a soft no-op
+        # in non-Stage-B environments rather than an error.
+        logger.warning("log_promise: Stage B not enabled; promise NOT recorded "
+                       "(text=%r)", promise_text[:80])
+        return _ok(promise_id=None, note="stage_b_disabled")
+
+    # Open the durable DB (same path as Stage B uses).
+    try:
+        try:
+            from agent import durable_integration as _di
+        except ImportError:
+            import durable_integration as _di  # type: ignore[no-redef]
+        try:
+            from agent import stage_c_promises as _sc
+        except ImportError:
+            import stage_c_promises as _sc  # type: ignore[no-redef]
+    except ImportError as exc:
+        return _err(f"durable runtime modules unavailable: {exc}")
+
+    conn = _di._open_db()
+    _sc.initialize_schema(conn)
+
+    pid = _sc.log_promise_explicit(
+        conn,
+        resume_chain_id=rs.resume_chain_id,
+        thread_id=rs.thread_id,
+        agent_profile=rs.agent_profile,
+        run_id=rs.run_id,
+        promise_text=promise_text,
+        trigger_type=trigger_type,
+        trigger_condition=trigger_condition,
+        due_at=due_at,
+    )
+    return _ok(promise_id=pid)
+
+
+def _ok(*, promise_id: str | None = None, note: str | None = None) -> str:
+    return json.dumps({"ok": True, "promise_id": promise_id, "note": note})
+
+
+def _err(msg: str) -> str:
+    return json.dumps({"ok": False, "error": msg, "promise_id": None})
+
+
+def _check_log_promise_available() -> bool:
+    """Always available — failure mode is a recorded warning, not a hard error."""
+    return True
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Registry registration (auto-discovered by tools.registry — must be a
+# top-level `registry.register(...)` Expr for AST-based discovery.)
+# ─────────────────────────────────────────────────────────────────────────────
+
+from tools.registry import registry
+
+try:
+    from agent.idempotency import register_durability
+    register_durability("log_promise", class_="write", reconciliation="queryable")
+except Exception:
+    pass
+
+registry.register(
+    name="log_promise",
+    toolset="durability",
+    schema=LOG_PROMISE_SCHEMA,
+    handler=log_promise_tool,
+    check_fn=_check_log_promise_available,
+    emoji="📌",
+)
diff --git a/tools/mcp_call_classifier.py b/tools/mcp_call_classifier.py
new file mode 100644
index 0000000000000000000000000000000000000000..0d8f8b79a3a85f1e7c307f26018546d0fddb583d
--- /dev/null
+++ b/tools/mcp_call_classifier.py
@@ -0,0 +1,496 @@
+"""MCP call failure classifier and cap-router outcome writer.
+
+Installed into hermes-agent as ``tools.mcp_call_classifier``. The module is
+fail-soft by design: classification should improve the error shape and usage
+ledger, but it must never break the underlying MCP call path.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import signal
+import sqlite3
+import subprocess
+import sys
+import threading
+import time
+from contextvars import ContextVar
+from datetime import datetime, timezone
+from functools import lru_cache
+from pathlib import Path
+from typing import Any, Callable
+
+
+_RECOVERY_ACTIVE: ContextVar[bool] = ContextVar("mcp_tool_doctor_recovery_active", default=False)
+_FINGERPRINTS_LOCK = threading.Lock()
+_ACTIVE_FINGERPRINTS: set[str] = set()
+_CALL_INCIDENT_SIGNATURES = {
+    "mcp_call_delivery_unknown",
+    "mcp_call_retry_failed",
+    "current_process_activation_failed",
+}
+_NON_REPAIRABLE_PATTERNS = (
+    ("auth_or_permission", re.compile(r"\b(?:401|403|unauthori[sz]ed|forbidden|oauth|token|api[- ]?key|permission denied)\b", re.I)),
+    ("invalid_arguments", re.compile(r"\b(?:invalid params?|invalid arguments?|validation error|bad request|http 400)\b", re.I)),
+    ("policy_denial", re.compile(r"\b(?:policy denied|policy denial|blocked by policy|not allowed by policy)\b", re.I)),
+    ("provider_business_error", re.compile(r"\b(?:http [45]\d{2}|429|rate limit|quota|insufficient funds|payment required|(?:resource|record|customer|provider) [^\n]{0,80} not found|already exists|conflict)\b", re.I)),
+)
+_REPAIRABLE_PATTERNS = (
+    ("connection_unavailable", re.compile(r"\b(?:connection (?:closed|refused|reset)|not connected|transport is down|unreachable|broken pipe|connection unavailable)\b", re.I)),
+    ("missing_runtime_dependency", re.compile(r"\b(?:modulenotfounderror|no module named|importerror|missing executable|executable .* not found|enoent)\b", re.I)),
+    ("server_startup_failure", re.compile(r"\b(?:startup failed|failed to start|failed to connect to mcp|initialize failed|initialization failed|protocol init|handshake failed)\b", re.I)),
+    ("server_timeout", re.compile(r"\b(?:timeout|timed out|deadline exceeded)\b", re.I)),
+)
+
+
+def hermes_home() -> Path:
+    return Path(os.environ.get("HERMES_HOME", str(Path.home() / ".hermes"))).expanduser()
+
+
+def registry_path() -> Path:
+    return Path(
+        os.environ.get(
+            "CAPABILITY_REGISTRY",
+            str(hermes_home() / "mcp-servers" / "capability-router" / "registry.json"),
+        )
+    ).expanduser()
+
+
+def capability_router_src() -> Path:
+    return hermes_home() / "mcp-servers" / "capability-router" / "src"
+
+
+def _norm(value: str) -> str:
+    return str(value or "").replace("_", "-").lower()
+
+
+@lru_cache(maxsize=1)
+def capability_map() -> dict[tuple[str, str], str]:
+    try:
+        reg = json.loads(registry_path().read_text(encoding="utf-8"))
+    except Exception:
+        return {}
+    out: dict[tuple[str, str], str] = {}
+    for cap in reg.get("capabilities") or []:
+        if not isinstance(cap, dict):
+            continue
+        cap_id = cap.get("id")
+        server = cap.get("mcp_server")
+        tool = cap.get("tool_name")
+        if cap_id and server and tool:
+            out[(_norm(server), _norm(tool))] = str(cap_id)
+    return out
+
+
+def resolve_capability_id(server_name: str, tool_name: str) -> str | None:
+    mapping = capability_map()
+    return mapping.get((_norm(server_name), _norm(tool_name)))
+
+
+def _repair_trigger(detail: str) -> tuple[bool, str]:
+    for trigger, pattern in _NON_REPAIRABLE_PATTERNS:
+        if pattern.search(detail):
+            return False, trigger
+    for trigger, pattern in _REPAIRABLE_PATTERNS:
+        if pattern.search(detail):
+            return True, trigger
+    return False, "ordinary_tool_error"
+
+
+def classify_exception(exc: BaseException, *, timeout: float | None = None) -> dict[str, Any]:
+    detail = str(exc).strip()
+    cls_name = type(exc).__name__
+    lower = detail.lower()
+    if isinstance(exc, TimeoutError) or cls_name in {"TimeoutError", "TimeoutExpired"}:
+        result = {
+            "failure_class": "server_timeout",
+            "failure_detail": detail or f"tool call exceeded {timeout}s budget",
+        }
+    elif "permission" in lower or "unauthorized" in lower or "forbidden" in lower:
+        result = {
+            "failure_class": "permission_denied",
+            "failure_detail": detail or f"{cls_name} (no detail)",
+        }
+    elif "json" in lower or "protocol" in lower or "invalid params" in lower:
+        result = {
+            "failure_class": "protocol_error",
+            "failure_detail": detail or f"{cls_name} (no detail)",
+        }
+    else:
+        result = {
+            "failure_class": "server_runtime_error",
+            "failure_detail": detail or f"{cls_name} (no detail)",
+        }
+    repairable, trigger = _repair_trigger(result["failure_detail"])
+    if isinstance(exc, TimeoutError) or cls_name in {"TimeoutError", "TimeoutExpired"}:
+        repairable, trigger = True, "server_timeout"
+    return {**result, "repairable": repairable, "repair_trigger": trigger}
+
+
+def classify_tool_error(error_text: str) -> dict[str, Any]:
+    detail = str(error_text or "").strip()
+    lower = detail.lower()
+    if "timeout" in lower or "timed out" in lower:
+        failure_class = "server_timeout"
+    elif "permission" in lower or "unauthorized" in lower or "forbidden" in lower:
+        failure_class = "permission_denied"
+    elif "json" in lower or "protocol" in lower or "invalid params" in lower:
+        failure_class = "protocol_error"
+    else:
+        failure_class = "server_runtime_error"
+    repairable, trigger = _repair_trigger(detail)
+    return {
+        "failure_class": failure_class,
+        "failure_detail": detail or "MCP tool returned an error (no detail)",
+        "repairable": repairable,
+        "repair_trigger": trigger,
+    }
+
+
+def _process_group_kwargs() -> dict[str, Any]:
+    if os.name == "nt":
+        return {"creationflags": getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)}
+    return {"start_new_session": True}
+
+
+def _terminate_tree(proc: subprocess.Popen) -> None:
+    if proc.poll() is not None:
+        return
+    if os.name == "nt":
+        subprocess.run(
+            ["taskkill", "/PID", str(proc.pid), "/T", "/F"],
+            capture_output=True, text=True, check=False, timeout=10,
+        )
+    else:
+        try:
+            os.killpg(proc.pid, signal.SIGTERM)
+            proc.wait(timeout=3)
+        except (ProcessLookupError, subprocess.TimeoutExpired):
+            try:
+                os.killpg(proc.pid, signal.SIGKILL)
+            except ProcessLookupError:
+                pass
+    try:
+        proc.wait(timeout=5)
+    except subprocess.TimeoutExpired:
+        proc.kill()
+
+
+def _run_tool_doctor(command: list[str], timeout: float) -> tuple[dict[str, Any] | None, str]:
+    try:
+        proc = subprocess.Popen(
+            command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
+            **_process_group_kwargs(),
+        )
+    except OSError as exc:
+        return None, f"tool_doctor_start_failed:{type(exc).__name__}"
+    try:
+        stdout, stderr = proc.communicate(timeout=timeout)
+    except subprocess.TimeoutExpired:
+        _terminate_tree(proc)
+        return None, f"tool_doctor_timeout_after_{timeout:g}s"
+    try:
+        return json.loads(stdout), "" if proc.returncode == 0 else (stderr.strip()[:500] or f"exit_{proc.returncode}")
+    except (json.JSONDecodeError, TypeError):
+        return None, stderr.strip()[:500] or "tool_doctor_invalid_json"
+
+
+def _target_is_green(receipt: dict[str, Any] | None, server_name: str) -> bool:
+    after = (receipt or {}).get("probe_after") or {}
+    if after.get("status") != "pass":
+        return False
+    rows = [row for row in after.get("servers", []) if row.get("server") == server_name]
+    return bool(rows) and all(row.get("status") == "pass" for row in rows)
+
+
+def _persist_failed_health(server_name: str, timeout: float) -> None:
+    home = hermes_home()
+    runner = home / "bin" / "tool-doctor.py"
+    if not runner.is_file():
+        return
+    _run_tool_doctor([
+        sys.executable, str(runner), "probe", "--home", str(home),
+        "--server", server_name, "--write-health", "--strict-exit", "--json",
+    ], min(20.0, max(5.0, timeout)))
+
+
+def _persist_runtime_failure_health(server_name: str, signature_class: str) -> None:
+    """Fail the existing health artifact closed when the live process is not recovered."""
+    home = hermes_home()
+    path = home / "state" / "tool-health.json"
+    try:
+        current = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
+    except (OSError, json.JSONDecodeError, TypeError):
+        current = {}
+    rows = [
+        row for row in (current.get("servers") or [])
+        if isinstance(row, dict) and row.get("server") != server_name
+    ]
+    rows.append({
+        "server": server_name,
+        "status": "fail",
+        "connect": "fail",
+        "list_tools": "skip",
+        "cheap_call": "skip",
+        "duration_ms": 0,
+        "signature": signature_class,
+        "signature_class": signature_class,
+        "call_incident": True,
+        "tools": [],
+    })
+    current.update({
+        "generated_at": datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z"),
+        "agent_id": current.get("agent_id") or home.name,
+        "home": str(home),
+        "status": "fail",
+        "servers": rows,
+    })
+    current.setdefault("plugins", {"status": "unverified", "plugins": []})
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
+    temporary.write_text(json.dumps(current, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    os.replace(temporary, path)
+
+
+def _clear_runtime_failure_health(server_name: str) -> None:
+    path = hermes_home() / "state" / "tool-health.json"
+    try:
+        current = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError, TypeError):
+        return
+    rows = current.get("servers") or []
+    kept = [
+        row for row in rows
+        if not (
+            isinstance(row, dict)
+            and row.get("server") == server_name
+            and (
+                row.get("call_incident") is True
+                or row.get("signature_class") in _CALL_INCIDENT_SIGNATURES
+            )
+        )
+    ]
+    if len(kept) == len(rows):
+        return
+    current["servers"] = kept
+    plugin_status = (current.get("plugins") or {}).get("status")
+    current["status"] = (
+        "pass"
+        if all(row.get("status") in {"pass", "skip"} for row in kept if isinstance(row, dict))
+        and plugin_status in {"pass", "skip"}
+        else "fail"
+    )
+    temporary = path.with_name(f".{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
+    temporary.write_text(json.dumps(current, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    os.replace(temporary, path)
+
+
+def _escalated_payload(
+    *, server_name: str, tool_name: str, failure: dict[str, Any],
+    reason: str, receipt: dict[str, Any] | None = None,
+) -> str:
+    payload = enrich_error_payload(
+        {"error": failure["failure_detail"]}, server_name=server_name,
+        tool_name=tool_name, failure_class=failure["failure_class"],
+        failure_detail=failure["failure_detail"],
+    )
+    payload.update({
+        "repair_status": "repair_escalated",
+        "repair_trigger": failure.get("repair_trigger"),
+        "repair_reason": reason,
+        "next_update": "next_15m_central_sweep",
+    })
+    if receipt and receipt.get("receipt_id"):
+        payload["tool_doctor_receipt_id"] = receipt["receipt_id"]
+    if reason.startswith("delivery_unknown_after_inflight_"):
+        payload["delivery_state"] = "unknown"
+    return json.dumps(payload, ensure_ascii=False)
+
+
+def recover_mcp_call(
+    *, server_name: str, tool_name: str, error_text: str,
+    retry_call: Callable[[], str], on_recovered: Callable[[], None] | None = None,
+    repair_suppressed: bool = False, timeout: float | None = None,
+    call_phase: str = "in_flight", tool_idempotent: bool = False,
+) -> str:
+    """Run one targeted heal, then retry the exact original MCP call once."""
+    failure = classify_tool_error(error_text)
+    base = enrich_error_payload(
+        {"error": error_text}, server_name=server_name, tool_name=tool_name,
+        failure_class=failure["failure_class"], failure_detail=failure["failure_detail"],
+    )
+    record_outcome(
+        server_name=server_name, tool_name=tool_name, ok=False,
+        failure_class=failure["failure_class"], failure_detail=failure["failure_detail"],
+    )
+    if not failure["repairable"]:
+        return json.dumps(base, ensure_ascii=False)
+    if repair_suppressed or _RECOVERY_ACTIVE.get() or _norm(server_name) == "tool-doctor":
+        _persist_runtime_failure_health(server_name, "mcp_call_retry_failed")
+        return _escalated_payload(
+            server_name=server_name, tool_name=tool_name, failure=failure,
+            reason="recursive_or_retry_repair_suppressed",
+        )
+    fingerprint = f"{_norm(server_name)}:{failure['repair_trigger']}"
+    with _FINGERPRINTS_LOCK:
+        if fingerprint in _ACTIVE_FINGERPRINTS:
+            return _escalated_payload(
+                server_name=server_name, tool_name=tool_name, failure=failure,
+                reason="matching_repair_already_running",
+            )
+        _ACTIVE_FINGERPRINTS.add(fingerprint)
+    token = _RECOVERY_ACTIVE.set(True)
+    try:
+        home = hermes_home()
+        runner = home / "bin" / "tool-doctor.py"
+        heal_timeout = float(timeout or os.environ.get("TOOL_DOCTOR_CALL_HEAL_TIMEOUT", "60"))
+        if not runner.is_file():
+            return _escalated_payload(
+                server_name=server_name, tool_name=tool_name, failure=failure,
+                reason="tool_doctor_runner_missing",
+            )
+        receipt, runner_error = _run_tool_doctor([
+            sys.executable, str(runner), "heal", "--home", str(home),
+            "--server", server_name, "--write-health", "--json",
+        ], heal_timeout)
+        if not _target_is_green(receipt, server_name):
+            _persist_failed_health(server_name, heal_timeout)
+            return _escalated_payload(
+                server_name=server_name, tool_name=tool_name, failure=failure,
+                reason=runner_error or "targeted_heal_not_green", receipt=receipt,
+            )
+        retry_safe = call_phase == "pre_dispatch" or tool_idempotent is True
+        if not retry_safe:
+            _persist_runtime_failure_health(server_name, "mcp_call_delivery_unknown")
+            return _escalated_payload(
+                server_name=server_name, tool_name=tool_name, failure=failure,
+                reason="delivery_unknown_after_inflight_failure", receipt=receipt,
+            )
+        if on_recovered:
+            try:
+                on_recovered()
+            except Exception:
+                _persist_runtime_failure_health(server_name, "current_process_activation_failed")
+                return _escalated_payload(
+                    server_name=server_name, tool_name=tool_name, failure=failure,
+                    reason="current_process_activation_failed", receipt=receipt,
+                )
+        retry_result = retry_call()
+        try:
+            retry_payload = retry_result if isinstance(retry_result, dict) else json.loads(retry_result)
+        except (json.JSONDecodeError, TypeError):
+            retry_payload = {}
+        if not isinstance(retry_payload, dict) or "error" not in retry_payload:
+            _clear_runtime_failure_health(server_name)
+        return retry_result
+    finally:
+        _RECOVERY_ACTIVE.reset(token)
+        with _FINGERPRINTS_LOCK:
+            _ACTIVE_FINGERPRINTS.discard(fingerprint)
+
+
+def enrich_error_payload(
+    payload: dict[str, Any],
+    *,
+    server_name: str,
+    tool_name: str,
+    failure_class: str,
+    failure_detail: str,
+) -> dict[str, Any]:
+    out = dict(payload)
+    out.setdefault("error", failure_detail)
+    out["failure_class"] = failure_class
+    out["failure_detail"] = failure_detail
+    out["mcp_server"] = server_name
+    out["mcp_tool"] = tool_name
+    cap_id = resolve_capability_id(server_name, tool_name)
+    if cap_id:
+        out["capability_id"] = cap_id
+    return out
+
+
+def _call_capability_router_record(**kwargs) -> dict[str, Any]:
+    src = capability_router_src()
+    if str(src) not in sys.path:
+        sys.path.insert(0, str(src))
+    from capability_router import server as cap_router
+
+    return cap_router.record_capability_outcome(**kwargs)
+
+
+def _record_direct_sqlite(**kwargs) -> dict[str, Any]:
+    db_path = Path(
+        os.environ.get(
+            "CAPABILITY_USAGE_DB",
+            str(hermes_home() / "state" / "capability-router-usage.db"),
+        )
+    ).expanduser()
+    db_path.parent.mkdir(parents=True, exist_ok=True)
+    now = int(time.time())
+    with sqlite3.connect(db_path) as conn:
+        conn.execute(
+            """CREATE TABLE IF NOT EXISTS outcomes (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                capability_id TEXT NOT NULL,
+                outcome TEXT NOT NULL,
+                query TEXT,
+                error_class TEXT,
+                duration_ms INTEGER,
+                failure_detail TEXT,
+                ts INTEGER NOT NULL
+            )"""
+        )
+        conn.execute(
+            """INSERT INTO outcomes
+               (capability_id, outcome, query, error_class, duration_ms, failure_detail, ts)
+               VALUES (?, ?, ?, ?, ?, ?, ?)""",
+            (
+                kwargs["capability_id"],
+                "success" if kwargs.get("ok") else "failure",
+                kwargs.get("query") or None,
+                kwargs.get("failure_class") or None,
+                kwargs.get("duration_ms"),
+                (kwargs.get("failure_detail") or None),
+                now,
+            ),
+        )
+        conn.commit()
+    return {"ok": True, "recorded": True, "fallback": "sqlite"}
+
+
+def record_outcome(
+    *,
+    server_name: str,
+    tool_name: str,
+    ok: bool,
+    duration_ms: int | None = None,
+    failure_class: str = "",
+    failure_detail: str = "",
+    query: str = "",
+) -> dict[str, Any]:
+    cap_id = resolve_capability_id(server_name, tool_name)
+    if not cap_id:
+        return {"ok": False, "recorded": False, "reason": "capability_id_not_found"}
+    payload = {
+        "capability_id": cap_id,
+        "ok": ok,
+        "query": query,
+        "failure_class": failure_class,
+        "failure_detail": failure_detail[:500] if failure_detail else "",
+        "duration_ms": duration_ms,
+    }
+    try:
+        return _call_capability_router_record(**payload)
+    except Exception as exc:
+        try:
+            result = _record_direct_sqlite(**payload)
+            result["primary_error"] = f"{type(exc).__name__}: {exc}"
+            return result
+        except Exception as fallback_exc:
+            return {
+                "ok": False,
+                "recorded": False,
+                "reason": f"{type(fallback_exc).__name__}: {fallback_exc}",
+                "primary_error": f"{type(exc).__name__}: {exc}",
+            }
