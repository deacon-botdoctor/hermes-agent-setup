index 0000000000000000000000000000000000000000..503a2120063623766be2df60ab7db5e554ff090e
--- /dev/null
+++ b/gateway/outbound_hygiene.py
@@ -0,0 +1,86 @@
+"""Last-mile client text guard retained from the Mac install."""
+import re
+from typing import Any, Dict, Optional
+
+_HYGIENE_INTERNAL_LINE_PATTERNS = (
+    re.compile(r"^\s*need run\.?\s*$", re.IGNORECASE),
+    re.compile(r"^\s*running (?:it|this|that) now\.?\s*$", re.IGNORECASE),
+    re.compile(r"^\s*script is ready\.?\s*$", re.IGNORECASE),
+)
+_HYGIENE_BLOCKER_PATTERNS = (
+    re.compile(r"\bit may fail if\b", re.IGNORECASE),
+    re.compile(r"\btemplate (?:can't|can’t|cannot) replace\b", re.IGNORECASE),
+)
+_HYGIENE_RUNTIME_PATTERNS = (
+    re.compile(r"\b(?:tool|script|runtime|stack|traceback|stderr|stdout|subprocess|cron|worker|gateway)\b", re.IGNORECASE),
+    re.compile(r"(?:^|\s)/(?:Users|home|tmp|var|etc|opt|private|Volumes)/[^\s`]+"),
+)
+_HYGIENE_APPROVAL_OR_BLOCKER_RE = re.compile(
+    r"\b(?:approve|approval|permission|blocked|blocker|cannot continue|can't continue|need your approval|waiting for approval)\b",
+    re.IGNORECASE,
+)
+_HYGIENE_VERIFIED_RESULT_RE = re.compile(
+    r"\b(?:done|completed|verified|passed|created|updated|fixed|sent|attached|delivered|here(?:'s| is))\b",
+    re.IGNORECASE,
+)
+
+
+def _hygiene_mode(metadata: Optional[Dict[str, Any]]) -> str:
+    meta = metadata if isinstance(metadata, dict) else {}
+    raw = (
+        meta.get("outbound_visibility")
+        or meta.get("hygiene_visibility")
+        or meta.get("visibility")
+        or meta.get("audience")
+        or ""
+    )
+    mode = str(raw).strip().lower()
+    if mode in {"internal", "log", "task", "unrestricted"}:
+        return "unrestricted"
+    if mode in {"operator", "debug", "diagnostic", "permissive"}:
+        return "permissive"
+    return "strict"
+
+
+def _sanitize_client_visible_content(content: str, metadata: Optional[Dict[str, Any]] = None) -> tuple[str, Optional[str]]:
+    """Apply a last-mile hygiene guard before text leaves a platform adapter.
+
+    Returns ``(content, reason)``.  ``reason`` is non-None when the message was
+    rewritten or blocked.  The guard is intentionally mechanical and lives at
+    the adapter boundary so cron, send_message, stream finalization, and helper
+    notifications share the same last check.
+    """
+    if _hygiene_mode(metadata) != "strict":
+        return content, None
+    if not isinstance(content, str) or not content.strip():
+        return content, None
+
+    stripped = content.strip()
+    if _HYGIENE_APPROVAL_OR_BLOCKER_RE.search(stripped):
+        return content, None
+
+    blocker_hit = any(pattern.search(stripped) for pattern in _HYGIENE_BLOCKER_PATTERNS)
+    if blocker_hit and not _HYGIENE_VERIFIED_RESULT_RE.search(stripped):
+        return "I hit one blocker: the requested change could not be applied cleanly yet.", "rewrote_internal_blocker"
+
+    kept: list[str] = []
+    dropped = False
+    for line in content.splitlines():
+        if any(pattern.search(line) for pattern in _HYGIENE_INTERNAL_LINE_PATTERNS):
+            dropped = True
+            continue
+        kept.append(line)
+    cleaned = "\n".join(kept).strip()
+    if dropped:
+        if cleaned and _HYGIENE_VERIFIED_RESULT_RE.search(cleaned):
+            return cleaned, "removed_internal_diary_line"
+        return "", "blocked_internal_diary_line"
+
+    if (
+        any(pattern.search(stripped) for pattern in _HYGIENE_RUNTIME_PATTERNS)
+        and re.search(r"\b(?:maybe|might|probably|try|attempt|debugging|speculation|I think|looks like)\b", stripped, re.IGNORECASE)
+        and not _HYGIENE_VERIFIED_RESULT_RE.search(stripped)
+    ):
+        return "", "blocked_runtime_speculation"
+
+    return content, None
