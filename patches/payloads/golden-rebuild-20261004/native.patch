diff --git a/tests/agent/test_durable_runtime_regressions.py b/tests/agent/test_durable_runtime_regressions.py
new file mode 100644
index 0000000000000000000000000000000000000000..5934d2b424d4dac2e839cd73bcd87abbb0557635
--- /dev/null
+++ b/tests/agent/test_durable_runtime_regressions.py
@@ -0,0 +1,72 @@
+"""Focused regressions for Doc's session flush and Stage-B tool wrapping."""
+
+import sqlite3
+from types import SimpleNamespace
+from typing import Any, cast
+from unittest.mock import MagicMock
+
+from agent import idempotency
+from agent import stage_b_hooks
+from run_agent import AIAgent
+
+
+def test_session_flush_appends_user_and_assistant_without_gateway_meta_flag():
+    """The append path must not reference gateway-only state it does not own."""
+    agent = cast(Any, object.__new__(AIAgent))
+    agent._session_db = MagicMock()
+    agent._session_db_created = True
+    agent.session_id = "regression-session"
+    agent._last_flushed_db_idx = 0
+    agent._flushed_db_message_session_id = None
+    agent._flushed_db_message_ids = set()
+
+    messages = [
+        {"role": "user", "content": "harmless persistence probe"},
+        {"role": "assistant", "content": "persisted"},
+    ]
+
+    agent._flush_messages_to_session_db(messages, conversation_history=[])
+
+    batch = agent._session_db.append_messages_batch.call_args.kwargs["messages"]
+    assert [row["content"] for row in batch] == ["harmless persistence probe", "persisted"]
+    agent._flush_messages_to_session_db(messages, conversation_history=[])
+    assert agent._session_db.append_messages_batch.call_count == 1
+
+
+def test_stage_b_wrapper_creates_and_commits_pending_row():
+    """A normal wrapped tool call must construct PendingCommit and commit it."""
+    conn = sqlite3.connect(":memory:", isolation_level=None)
+    rs: Any = SimpleNamespace(
+        enabled=True,
+        thread_id="thread-regression",
+        run_id="run-regression",
+        resume_chain_id="chain-regression",
+        resume_generation=0,
+        delivery_epoch=0,
+        _conn=conn,
+    )
+    tool_call = SimpleNamespace(
+        id="call-regression",
+        function=SimpleNamespace(name="test_write", arguments='{"value": 1}'),
+    )
+    assistant_message = SimpleNamespace(tool_calls=[tool_call])
+    messages = []
+
+    def original_execute(message, output_messages, _task_id, _api_call_count):
+        call = message.tool_calls[0]
+        output_messages.append({
+            "role": "tool", "tool_call_id": call.id, "content": '{"ok": true}'
+        })
+
+    stage_b_hooks._execute_tool_calls_durable(
+        object(), rs, original_execute, assistant_message, messages, "task-regression"
+    )
+
+    store = idempotency.IdempotencyStore(conn)
+    rows = conn.execute(
+        "SELECT status, tool_name FROM pending_commits"
+    ).fetchall()
+    assert rows == [("committed", "test_write")]
+    assert messages == [
+        {"role": "tool", "tool_call_id": "call-regression", "content": '{"ok": true}'}
+    ]
