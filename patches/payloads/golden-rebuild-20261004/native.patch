+"""workers/memory/anamnesis/reindex_daemon.py — standalone reindex daemon.
+
+Phase 5.7h (2026-04-27): the gateway opens stdio to MCP servers only as
+needed (e.g., tools/list discovery, then tools/call invocations). Stdio
+closes between calls; shim subprocess exits. The Phase 5.7e in-shim
+reindex_loop never gets to run beyond the first tick because the shim
+subprocess dies.
+
+This daemon runs the reindex worker in a dedicated long-lived process,
+configured by the same env vars as the shim:
+
+    HERMES_EMBED_PROVIDER       (ollama|openai)
+    HERMES_EMBED_MODEL          (e.g., openai/text-embedding-3-small)
+    HERMES_OPENAI_EMBED_URL     (e.g., https://openrouter.ai/api/v1/embeddings)
+    HERMES_OPENAI_EMBED_API_KEY (or OPENROUTER_API_KEY fallback)
+    HERMES_QDRANT_URL           (e.g., http://localhost:6333)
+    HERMES_QDRANT_COLLECTION    (e.g., anamnesis_memories)
+
+Per-host service definitions in kit/bin/install-reindex-daemon.sh wire
+this up via systemd / launchd / scheduled task, with restart-on-failure.
+
+Usage:
+    python -m workers.memory.anamnesis.reindex_daemon \\
+        --memory-db ~/.anamnesis/memory.db \\
+        [--reindex-interval 15] [--batch-size 50] [--log-level INFO]
+
+Cleanly handles SIGTERM / SIGINT — finishes the current batch, marks rows
+released from `processing` state via stale-claim sweep on next start, then
+exits.
+"""
+from __future__ import annotations
+
+import argparse
+import asyncio
+import logging
+import signal
+import sys
+from pathlib import Path
+
+_HERE = Path(__file__).resolve().parent.parent.parent
+sys.path.insert(0, str(_HERE))
+
+from workers.memory.anamnesis.vector_reindex import (
+    VectorReindexWorker, DEFAULT_BATCH_SIZE,
+)
+from workers.memory.anamnesis.external import (
+    make_embed_client_from_env,
+    make_vector_client_from_env,
+    NullEmbedClient,
+    NullVectorClient,
+)
+
+logger = logging.getLogger("anamnesis.reindex_daemon")
+
+
+async def main_async(args: argparse.Namespace) -> int:
+    embed_client = make_embed_client_from_env()
+    vector_client = make_vector_client_from_env()
+
+    if isinstance(embed_client, NullEmbedClient):
+        logger.error("embed client is NULL — set HERMES_EMBED_PROVIDER + key")
+        return 2
+    if isinstance(vector_client, NullVectorClient):
+        logger.error("vector client is NULL — set HERMES_QDRANT_URL")
+        return 2
+
+    worker = VectorReindexWorker(
+        str(args.memory_db),
+        embed_client=embed_client,
+        vector_client=vector_client,
+        batch_size=args.batch_size,
+    )
+    worker.open()
+    logger.info(
+        "reindex daemon started: db=%s interval=%ss batch=%d embed=%s vector=%s",
+        args.memory_db, args.reindex_interval, args.batch_size,
+        type(embed_client).__name__, type(vector_client).__name__,
+    )
+
+    stop_event = asyncio.Event()
+
+    def _signal_handler():
+        logger.info("signal received — finishing current batch")
+        stop_event.set()
+
+    loop = asyncio.get_running_loop()
+    for sig in (signal.SIGTERM, signal.SIGINT):
+        try:
+            loop.add_signal_handler(sig, _signal_handler)
+        except NotImplementedError:
+            # Windows asyncio doesn't support add_signal_handler on most loops.
+            # SIGTERM via Win32 will just kill the process; daemon recovers via
+            # stale-claim sweep on next start (rows in 'processing' for >5min
+            # become eligible again).
+            pass
+
+    try:
+        while not stop_event.is_set():
+            try:
+                stats = await worker.run_one_batch()
+                if stats.batches_run % 20 == 0:
+                    logger.info(
+                        "reindex stats: batches=%d processed=%d ok=%d failed=%d "
+                        "dead=%d stale_swept=%d breaker_trips=%d",
+                        stats.batches_run, stats.rows_processed,
+                        stats.rows_succeeded, stats.rows_failed,
+                        stats.rows_dead_lettered, stats.rows_stale_swept,
+                        stats.breaker_trips,
+                    )
+            except Exception as exc:  # noqa: BLE001
+                logger.warning("reindex batch raised: %s", exc)
+            try:
+                await asyncio.wait_for(stop_event.wait(), timeout=args.reindex_interval)
+                break  # signaled; exit loop
+            except asyncio.TimeoutError:
+                continue
+    finally:
+        worker.close()
+        logger.info("reindex daemon stopped")
+    return 0
+
+
+def main() -> int:
+    p = argparse.ArgumentParser(description="Anamnesis vector reindex daemon (v8)")
+    p.add_argument("--memory-db", required=True, type=Path)
+    p.add_argument("--reindex-interval", type=float, default=15.0,
+                   help="Seconds between batches (default 15)")
+    p.add_argument("--batch-size", type=int, default=DEFAULT_BATCH_SIZE)
+    p.add_argument("--log-level", default="INFO")
+    args = p.parse_args()
+
+    logging.basicConfig(
+        level=args.log_level,
+        stream=sys.stderr,
+        format="%(asctime)s %(levelname)s %(name)s %(message)s",
+    )
+    return asyncio.run(main_async(args))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
