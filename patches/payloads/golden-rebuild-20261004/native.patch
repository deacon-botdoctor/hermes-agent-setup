new file mode 100644
index 0000000000000000000000000000000000000000..8ef9027a7a23b212ed09f0fe2199bd4914989e4b
--- /dev/null
+++ b/tools/memory_contract.py
@@ -0,0 +1,108 @@
+"""
+tools/memory_contract.py — Memory read/write contract for dream.py and other scripts.
+
+Provides functions to read, merge, and write memory entries in MEMORY.md / USER.md,
+respecting character limits from the Hermes config.
+"""
+
+import re
+from pathlib import Path
+from typing import List, Tuple
+
+ENTRY_DELIMITER = "\n§\n"
+
+# Default limits from hermes_cli/config.py
+DEFAULT_MEMORY_CHAR_LIMIT = 2200
+DEFAULT_USER_CHAR_LIMIT = 1375
+
+
+def _load_config_limits() -> dict:
+    """Try to read memory limits from config.yaml."""
+    from hermes_cli.config import InvalidUserConfigError, load_config_readonly
+
+    try:
+        cfg = load_config_readonly()
+        mem = cfg.get("memory", {})
+        if not isinstance(mem, dict):
+            return {}
+        return {
+            "memory": int(mem.get("memory_char_limit", DEFAULT_MEMORY_CHAR_LIMIT)),
+            "user": int(mem.get("user_char_limit", DEFAULT_USER_CHAR_LIMIT)),
+        }
+    except (InvalidUserConfigError, OSError, TypeError, ValueError):
+        return {}
+
+
+def char_limit_for_target(target: str) -> int:
+    """Return the character limit for a memory target ('memory' or 'user')."""
+    limits = _load_config_limits()
+    if target == "memory":
+        return limits.get("memory", DEFAULT_MEMORY_CHAR_LIMIT)
+    elif target == "user":
+        return limits.get("user", DEFAULT_USER_CHAR_LIMIT)
+    return DEFAULT_MEMORY_CHAR_LIMIT
+
+
+def normalize_text(text: str) -> str:
+    return re.sub(r"\s+", " ", text.strip())
+
+
+def read_memory_entries(path: Path) -> List[str]:
+    """Read memory entries from a markdown file."""
+    if not path.exists():
+        return []
+    raw = path.read_text(encoding="utf-8")
+    if not raw.strip():
+        return []
+    # Delimiter-based format
+    if ENTRY_DELIMITER in raw:
+        return [e.strip() for e in raw.split(ENTRY_DELIMITER) if e.strip()]
+    # Line-based fallback: treat non-empty lines as entries
+    entries = []
+    for line in raw.splitlines():
+        line = line.strip()
+        if line and not line.startswith("#"):
+            # Strip leading bullet
+            if line.startswith("- "):
+                line = line[2:]
+            if line:
+                entries.append(line)
+    return entries
+
+
+def merge_entries_with_limit(
+    existing: List[str],
+    incoming: List[str],
+    limit: int,
+) -> Tuple[List[str], int]:
+    """Merge incoming entries into existing, respecting char limit. Returns (merged, count_added)."""
+    merged = list(existing)
+    seen = {normalize_text(e) for e in existing if e.strip()}
+    added = 0
+
+    current_len = len(ENTRY_DELIMITER.join(merged)) if merged else 0
+
+    for entry in incoming:
+        normalized = normalize_text(entry)
+        if not normalized:
+            continue
+        if normalized in seen:
+            continue
+
+        candidate_len = len(entry) if not merged else current_len + len(ENTRY_DELIMITER) + len(entry)
+        if candidate_len > limit:
+            continue
+
+        merged.append(entry)
+        seen.add(normalized)
+        current_len = candidate_len
+        added += 1
+
+    return merged, added
+
+
+def write_memory_entries(path: Path, entries: List[str]) -> None:
+    """Write memory entries to a file using the delimiter format."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    content = ENTRY_DELIMITER.join(e.strip() for e in entries if e.strip())
+    path.write_text(content + "\n", encoding="utf-8")
