+"""workers/memory/recall.py — memory-recall worker.
+
+Read-only over memory_store.db per docs/specs/hermes-worker-decomposition-v4.md
+§5.2. Uses FTS5 for text retrieval, optionally HRR vectors for similarity,
+ranked-fusion for hybrid mode.
+
+Function: memory::recall
+Args:
+    query: str (search query)
+    types: list of memory_type filters — optional
+    priority: priority filter — optional
+    limit: max results (default 10, max 100)
+    retrieval_mode: 'fts' | 'vector' | 'hybrid' (default 'fts')
+    include_legacy: bool (default false; if true, allow client_id='_legacy' rows)
+Returns:
+    {"ok": True, "data": {"hits": [{fact_id, content, memory_type, priority,
+                                    score, ...}, ...]}}
+
+Filter rules:
+  - Always filter by env.scope.client_id (per §5.1.6).
+  - If include_legacy=true, ALSO include rows with client_id='_legacy'.
+  - Optionally filter by memory_type (IN list) and priority.
+
+Read-only: no INSERT/UPDATE; retrieval_count increments are NOT done here
+(would violate single-writer rule). A separate `memory::increment_retrieval`
+function on memory-store can be added later for usage tracking; v1 just
+returns the data.
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+import sqlite3
+from typing import Any, Dict, List, Optional
+
+from .._ipc.envelope import Envelope, ErrorCode
+from .._ipc.server import HandlerError
+
+
+logger = logging.getLogger(__name__)
+
+
+VALID_MODES = {"fts", "vector", "hybrid"}
+DEFAULT_LIMIT = 10
+MAX_LIMIT = 100
+
+
+class MemoryRecallWorker:
+    """memory::recall handler. Read-only connection (or pool of)."""
+
+    def __init__(self, memory_db_path: str):
+        self.memory_db_path = memory_db_path
+        self._conn: Optional[sqlite3.Connection] = None
+        self._lock = asyncio.Lock()
+
+    def open(self) -> None:
+        # Read-only WAL connection. We use immutable=0 + mode=ro for safety;
+        # writers (memory-store) commit via separate connection in WAL mode,
+        # so this connection sees their snapshot.
+        self._conn = sqlite3.connect(
+            f"file:{self.memory_db_path}?mode=ro",
+            uri=True,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        # busy_timeout still useful for the rare case of WAL checkpoint contention.
+        self._conn.execute("PRAGMA busy_timeout=5000")
+
+    def close(self) -> None:
+        if self._conn is not None:
+            self._conn.close()
+            self._conn = None
+
+    async def handle_recall(self, env: Envelope) -> Dict[str, Any]:
+        args = env.args
+        query = args.get("query")
+        types_filter = args.get("types")
+        priority_filter = args.get("priority")
+        limit = args.get("limit", DEFAULT_LIMIT)
+        mode = str(args.get("retrieval_mode", "fts"))
+        include_legacy = bool(args.get("include_legacy", False))
+
+        # Validation
+        if not isinstance(query, str) or not query.strip():
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                "args.query is required (non-empty string)",
+                retryable=False,
+            )
+        if mode not in VALID_MODES:
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                f"args.retrieval_mode must be one of {sorted(VALID_MODES)}; got {mode!r}",
+                retryable=False,
+            )
+        try:
+            limit = int(limit)
+        except (TypeError, ValueError):
+            raise HandlerError(ErrorCode.INVALID_INPUT, "args.limit must be int", retryable=False)
+        limit = max(1, min(MAX_LIMIT, limit))
+
+        if types_filter is not None:
+            if not isinstance(types_filter, list) or not all(isinstance(t, str) for t in types_filter):
+                raise HandlerError(
+                    ErrorCode.INVALID_INPUT,
+                    "args.types must be a list of strings",
+                    retryable=False,
+                )
+        if priority_filter is not None and not isinstance(priority_filter, str):
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                "args.priority must be a string",
+                retryable=False,
+            )
+
+        client_id = env.scope.client_id
+
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None,
+                self._do_recall_sync,
+                query, mode, limit, types_filter, priority_filter,
+                client_id, include_legacy,
+            )
+
+    def _do_recall_sync(
+        self,
+        query: str,
+        mode: str,
+        limit: int,
+        types_filter: Optional[List[str]],
+        priority_filter: Optional[str],
+        client_id: str,
+        include_legacy: bool,
+    ) -> Dict[str, Any]:
+        assert self._conn is not None, "worker not opened"
+
+        # v1 ships the FTS path. Vector + hybrid stub raises NotImplementedError
+        # for now; ENG-MEMCOMP-001 / vector worker comes later.
+        if mode != "fts":
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                f"retrieval_mode={mode!r} not yet implemented in v1; use 'fts'",
+                retryable=False,
+            )
+
+        # Build query
+        clauses = []
+        params: List[Any] = []
+
+        # Scope filter
+        if include_legacy:
+            clauses.append("(facts.client_id = ? OR facts.client_id = '_legacy')")
+            params.append(client_id)
+        else:
+            clauses.append("facts.client_id = ?")
+            params.append(client_id)
+
+        # Type filter
+        if types_filter:
+            placeholders = ",".join("?" * len(types_filter))
+            clauses.append(f"facts.memory_type IN ({placeholders})")
+            params.extend(types_filter)
+
+        # Priority filter
+        if priority_filter:
+            clauses.append("facts.priority = ?")
+            params.append(priority_filter)
+
+        where = " AND ".join(clauses)
+
+        # FTS5 MATCH against facts_fts
+        sql = f"""
+            SELECT
+                facts.fact_id, facts.content, facts.memory_type, facts.priority,
+                facts.category, facts.tags, facts.metadata_json, facts.client_id,
+                facts.trust_score, facts.created_at,
+                bm25(facts_fts) AS score
+            FROM facts_fts
+            JOIN facts ON facts.fact_id = facts_fts.rowid
+            WHERE facts_fts MATCH ? AND {where}
+            ORDER BY score
+            LIMIT ?
+        """
+
+        # FTS5 query needs to come first in params list
+        all_params = [query] + params + [limit]
+        try:
+            cur = self._conn.execute(sql, all_params)
+            rows = cur.fetchall()
+        except sqlite3.OperationalError as exc:
+            # FTS5 syntax errors land here (e.g. unbalanced quotes).
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                f"FTS5 query rejected: {exc}",
+                retryable=False,
+            )
+
+        hits: List[Dict[str, Any]] = []
+        for row in rows:
+            metadata = None
+            if row[6]:
+                try:
+                    import json as _json
+                    metadata = _json.loads(row[6])
+                except (ValueError, TypeError):
+                    metadata = None
+            hits.append({
+                "fact_id": row[0],
+                "content": row[1],
+                "memory_type": row[2],
+                "priority": row[3],
+                "category": row[4],
+                "tags": row[5],
+                "metadata": metadata,
+                "client_id": row[7],
+                "trust_score": row[8],
+                "created_at": row[9],
+                "score": row[10],
+            })
+
+        return {"ok": True, "data": {"hits": hits, "count": len(hits), "mode": mode}}
