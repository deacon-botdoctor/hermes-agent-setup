+++ b/workers/memory/anamnesis/vector_reindex.py
@@ -0,0 +1,449 @@
+"""workers/memory/anamnesis/vector_reindex.py — vector index reconciliation (v8).
+
+Per docs/specs/hermes-worker-decomposition-v8.md §5.9 + council pass 3 fixes.
+
+Reconciles `memories.vector_status != 'ready'` rows by embedding via Ollama
+and upserting to Qdrant. Critical correctness pieces:
+
+  1. Atomic row-claim (council pass 3 GPT consensus): worker MUST claim a
+     row via UPDATE WHERE vector_status IN ('pending','failed') and check
+     changes()==1 before processing. Prevents two reindex workers from
+     double-embedding the same memory.
+
+  2. Healthy-items-first ordering (council pass 2 Gemini): query orders by
+     vector_attempt_count ASC then vector_status_changed_at ASC, so poison
+     pills don't block fresh items.
+
+  3. Bounded backoff: per-row delay = min(2^attempt, 3600) seconds. Max
+     1 hour. Dead-letter at 100 attempts.
+
+  4. Circuit breaker (council pass 3 Gemini consensus): 90% failure rate
+     across 3 consecutive batches trips OPEN; 5min cooldown; log ONE
+     alert at trip; HALF_OPEN test after cooldown. Prevents alert storms
+     during systemic Ollama/Qdrant outages.
+
+  5. Stale-claim sweep: rows in 'processing' state with
+     vector_status_changed_at < now-300s reset to 'pending'. Recovers
+     from worker crashes mid-process.
+
+The worker takes injected Ollama and Qdrant clients (Protocol-based);
+real httpx-backed clients land in batch 5.3d alongside the MCP shim.
+Mock clients in tests cover all the failure modes deterministically.
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+import sqlite3
+import time
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Any, List, Optional, Protocol
+
+
+logger = logging.getLogger(__name__)
+
+
+# v8 §5.9 reindex tuning constants
+DEFAULT_BATCH_SIZE = 50
+DEFAULT_MAX_ATTEMPTS = 100
+DEFAULT_BACKOFF_CAP_SECONDS = 3600
+DEFAULT_STALE_CLAIM_SECONDS = 300
+
+# Circuit breaker (v8 §5.9)
+DEFAULT_FAILURE_THRESHOLD = 0.9
+DEFAULT_CONSECUTIVE_BAD_BATCHES = 3
+DEFAULT_COOLDOWN_SECONDS = 300
+
+
+class BreakerState(str, Enum):
+    CLOSED = "closed"
+    OPEN = "open"
+    HALF_OPEN = "half_open"
+
+
+# ─────────────────────────────────────────────────────────────────
+# Client Protocols (injected; real impls in batch 5.3d external.py)
+# ─────────────────────────────────────────────────────────────────
+
+class EmbedClient(Protocol):
+    async def embed(self, text: str) -> List[float]: ...
+
+
+class VectorStoreClient(Protocol):
+    async def upsert(
+        self,
+        *,
+        point_id: str,
+        embedding: List[float],
+        memory_id: str,
+        content: str,
+        container_id: str,
+    ) -> None: ...
+
+    async def health_check(self) -> bool: ...
+
+
+# ─────────────────────────────────────────────────────────────────
+# Circuit breaker
+# ─────────────────────────────────────────────────────────────────
+
+@dataclass
+class CircuitBreaker:
+    failure_threshold: float = DEFAULT_FAILURE_THRESHOLD
+    bad_batch_threshold: int = DEFAULT_CONSECUTIVE_BAD_BATCHES
+    cooldown_seconds: int = DEFAULT_COOLDOWN_SECONDS
+
+    state: BreakerState = BreakerState.CLOSED
+    consecutive_bad_batches: int = 0
+    opened_at: float = 0.0
+    alert_logged: bool = False
+
+    def record_batch(self, total: int, failures: int) -> None:
+        """Update breaker state based on a batch's results."""
+        if total == 0:
+            return  # empty batch — no signal either way
+
+        failure_rate = failures / total
+        if failure_rate >= self.failure_threshold:
+            self.consecutive_bad_batches += 1
+            if (self.consecutive_bad_batches >= self.bad_batch_threshold
+                    and self.state == BreakerState.CLOSED):
+                self._trip_open()
+        else:
+            # Healthy batch — reset counter
+            self.consecutive_bad_batches = 0
+            if self.state == BreakerState.HALF_OPEN:
+                # Test passed; close breaker
+                self.state = BreakerState.CLOSED
+                self.alert_logged = False
+                logger.warning("reindex circuit breaker CLOSED — healthy batch in HALF_OPEN")
+
+    def can_proceed(self) -> bool:
+        """Check if reindex worker may run a batch.
+
+        OPEN: refuses until cooldown expires.
+        HALF_OPEN: allows one batch (test); next record_batch decides.
+        CLOSED: always proceed.
+        """
+        if self.state == BreakerState.CLOSED:
+            return True
+        if self.state == BreakerState.OPEN:
+            if time.time() - self.opened_at >= self.cooldown_seconds:
+                self.state = BreakerState.HALF_OPEN
+                logger.warning("reindex circuit breaker HALF_OPEN — testing")
+                return True
+            return False
+        # HALF_OPEN: allow exactly one batch
+        return True
+
+    def _trip_open(self) -> None:
+        self.state = BreakerState.OPEN
+        self.opened_at = time.time()
+        if not self.alert_logged:
+            logger.critical(
+                "reindex circuit breaker OPEN: %.0f%% failure x %d batches; "
+                "cooldown %ds",
+                self.failure_threshold * 100,
+                self.bad_batch_threshold,
+                self.cooldown_seconds,
+            )
+            self.alert_logged = True
+
+
+# ─────────────────────────────────────────────────────────────────
+# Stats tracker (for tests + observability)
+# ─────────────────────────────────────────────────────────────────
+
+@dataclass
+class ReindexStats:
+    batches_run: int = 0
+    rows_processed: int = 0
+    rows_succeeded: int = 0
+    rows_failed: int = 0
+    rows_dead_lettered: int = 0
+    rows_stale_swept: int = 0
+    breaker_trips: int = 0
+
+
+# ─────────────────────────────────────────────────────────────────
+# Worker
+# ─────────────────────────────────────────────────────────────────
+
+class VectorReindexWorker:
+    """Reindex worker. Runs as cron-trigger AND state-trigger (per v8 §5.9).
+
+    Holds a writable connection to ~/.anamnesis/memory.db (since UPDATE
+    on vector_status is required). Concurrent reindex workers across the
+    fleet would coordinate via SQLite native locking + atomic row-claim;
+    duplicate-claim attempts are detected via changes()==0 and skip cleanly.
+    """
+
+    def __init__(
+        self,
+        memory_db_path: str,
+        *,
+        embed_client: EmbedClient,
+        vector_client: VectorStoreClient,
+        batch_size: int = DEFAULT_BATCH_SIZE,
+        max_attempts: int = DEFAULT_MAX_ATTEMPTS,
+        backoff_cap_seconds: int = DEFAULT_BACKOFF_CAP_SECONDS,
+        stale_claim_seconds: int = DEFAULT_STALE_CLAIM_SECONDS,
+        breaker: Optional[CircuitBreaker] = None,
+    ):
+        self.memory_db_path = memory_db_path
+        self._embed = embed_client
+        self._vec = vector_client
+        self.batch_size = batch_size
+        self.max_attempts = max_attempts
+        self.backoff_cap = backoff_cap_seconds
+        self.stale_claim_seconds = stale_claim_seconds
+        self.breaker = breaker or CircuitBreaker()
+        self.stats = ReindexStats()
+        self._conn: Optional[sqlite3.Connection] = None
+        self._lock = asyncio.Lock()
+
+    def open(self) -> None:
+        self._conn = sqlite3.connect(
+            self.memory_db_path,
+            isolation_level=None,
+            check_same_thread=False,
+        )
+        self._conn.execute("PRAGMA journal_mode=WAL")
+        self._conn.execute("PRAGMA busy_timeout=5000")
+        self._conn.execute("PRAGMA synchronous=NORMAL")
+
+    def close(self) -> None:
+        if self._conn is not None:
+            self._conn.close()
+            self._conn = None
+
+    async def run_one_batch(self) -> ReindexStats:
+        """Run a single batch. Honors circuit breaker. Returns batch stats."""
+        if not self.breaker.can_proceed():
+            logger.debug("reindex breaker OPEN; skipping batch")
+            return self.stats
+
+        async with self._lock:
+            # 1. Stale-claim sweep first
+            stale_swept = await asyncio.get_running_loop().run_in_executor(
+                None, self._sweep_stale_claims_sync,
+            )
+            self.stats.rows_stale_swept += stale_swept
+
+            # 2. Select healthy-items-first
+            candidates = await asyncio.get_running_loop().run_in_executor(
+                None, self._select_candidates_sync,
+            )
+
+        if not candidates:
+            self.stats.batches_run += 1
+            return self.stats
+
+        # 3. Process each candidate (claim → embed → upsert → mark)
+        batch_failures = 0
+        batch_total = 0
+        for row in candidates:
+            memory_id, qdrant_id, content, container_id, attempt = row
+
+            # Claim atomically (sync; runs in executor for sqlite call)
+            claimed = await asyncio.get_running_loop().run_in_executor(
+                None, self._claim_row_sync, memory_id,
+            )
+            if not claimed:
+                continue  # another worker got it
+
+            batch_total += 1
+            self.stats.rows_processed += 1
+
+            try:
+                embedding = await self._embed.embed(content)
+                await self._vec.upsert(
+                    point_id=qdrant_id,
+                    embedding=embedding,
+                    memory_id=memory_id,
+                    content=content,
+                    container_id=container_id,
+                )
+                # Success path
+                await asyncio.get_running_loop().run_in_executor(
+                    None, self._mark_ready_sync, memory_id,
+                )
+                self.stats.rows_succeeded += 1
+            except Exception as exc:
+                batch_failures += 1
+                self.stats.rows_failed += 1
+                next_attempt = attempt + 1
+                logger.warning(
+                    "reindex %s attempt %d failed: %s",
+                    memory_id, next_attempt, exc,
+                )
+                if next_attempt >= self.max_attempts:
+                    await asyncio.get_running_loop().run_in_executor(
+                        None, self._mark_dead_letter_sync, memory_id,
+                        next_attempt, str(exc)[:500],
+                    )
+                    self.stats.rows_dead_lettered += 1
+                    logger.critical(
+                        "reindex DEAD-LETTER %s after %d attempts: %s",
+                        memory_id, next_attempt, exc,
+                    )
+                else:
+                    await asyncio.get_running_loop().run_in_executor(
+                        None, self._mark_failed_sync, memory_id,
+                        next_attempt, str(exc)[:500],
+                    )
+
+        # 4. Update breaker state
+        was_open = self.breaker.state == BreakerState.OPEN
+        self.breaker.record_batch(batch_total, batch_failures)
+        if (not was_open) and self.breaker.state == BreakerState.OPEN:
+            self.stats.breaker_trips += 1
+
+        self.stats.batches_run += 1
+        return self.stats
+
+    # ─── sync helpers (run in executor) ──────────────────────────────
+
+    def _select_candidates_sync(self) -> List[tuple]:
+        assert self._conn is not None
+        rows = self._conn.execute(
+            f"""
+            SELECT id, qdrant_id, content, container_id, vector_attempt_count
+              FROM memories
+             WHERE vector_status IN ('pending','failed')
+               AND vector_attempt_count < ?
+               AND superseded_by IS NULL AND forgotten_at IS NULL
+             ORDER BY vector_attempt_count ASC,
+                      vector_status_changed_at ASC
+             LIMIT ?
+            """,
+            (self.max_attempts, self.batch_size),
+        ).fetchall()
+        return rows
+
+    def _claim_row_sync(self, memory_id: str) -> bool:
+        """Atomic claim. Returns True if this worker claimed the row."""
+        assert self._conn is not None
+        try:
+            self._conn.execute("BEGIN IMMEDIATE")
+            cur = self._conn.execute(
+                """
+                UPDATE memories
+                   SET vector_status = 'processing',
+                       vector_status_changed_at = strftime('%s','now')
+                 WHERE id = ?
+                   AND vector_status IN ('pending','failed')
+                   AND vector_attempt_count < ?
+                """,
+                (memory_id, self.max_attempts),
+            )
+            claimed = cur.rowcount == 1
+            self._conn.execute("COMMIT")
+            return claimed
+        except sqlite3.OperationalError:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            return False
+
+    def _mark_ready_sync(self, memory_id: str) -> None:
+        assert self._conn is not None
+        self._conn.execute("BEGIN IMMEDIATE")
+        try:
+            self._conn.execute(
+                """
+                UPDATE memories
+                   SET vector_status = 'ready',
+                       vector_status_changed_at = strftime('%s','now'),
+                       last_vector_error = NULL
+                 WHERE id = ? AND vector_status = 'processing'
+                """,
+                (memory_id,),
+            )
+            self._conn.execute("COMMIT")
+        except sqlite3.Error:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            raise
+
+    def _mark_failed_sync(
+        self, memory_id: str, new_attempt_count: int, error: str,
+    ) -> None:
+        assert self._conn is not None
+        self._conn.execute("BEGIN IMMEDIATE")
+        try:
+            self._conn.execute(
+                """
+                UPDATE memories
+                   SET vector_status = 'failed',
+                       vector_status_changed_at = strftime('%s','now'),
+                       vector_attempt_count = ?,
+                       last_vector_error = ?
+                 WHERE id = ? AND vector_status = 'processing'
+                """,
+                (new_attempt_count, error, memory_id),
+            )
+            self._conn.execute("COMMIT")
+        except sqlite3.Error:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            raise
+
+    def _mark_dead_letter_sync(
+        self, memory_id: str, attempt_count: int, error: str,
+    ) -> None:
+        assert self._conn is not None
+        self._conn.execute("BEGIN IMMEDIATE")
+        try:
+            self._conn.execute(
+                """
+                UPDATE memories
+                   SET vector_status = 'dead-letter',
+                       vector_status_changed_at = strftime('%s','now'),
+                       vector_attempt_count = ?,
+                       last_vector_error = ?
+                 WHERE id = ? AND vector_status = 'processing'
+                """,
+                (attempt_count, error, memory_id),
+            )
+            self._conn.execute("COMMIT")
+        except sqlite3.Error:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            raise
+
+    def _sweep_stale_claims_sync(self) -> int:
+        """Reset rows stuck in 'processing' state past stale threshold."""
+        assert self._conn is not None
+        threshold = int(time.time()) - self.stale_claim_seconds
+        try:
+            self._conn.execute("BEGIN IMMEDIATE")
+            cur = self._conn.execute(
+                """
+                UPDATE memories
+                   SET vector_status = 'pending',
+                       vector_status_changed_at = strftime('%s','now')
+                 WHERE vector_status = 'processing'
+                   AND vector_status_changed_at < ?
+                """,
+                (threshold,),
+            )
+            swept = cur.rowcount
+            self._conn.execute("COMMIT")
+            if swept > 0:
+                logger.warning("reindex stale-claim sweep reset %d rows", swept)
+            return swept
+        except sqlite3.OperationalError:
+            try:
+                self._conn.execute("ROLLBACK")
+            except sqlite3.Error:
+                pass
+            return 0
