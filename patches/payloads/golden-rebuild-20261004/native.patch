@@ -0,0 +1,405 @@
+"""workers/memory/anamnesis_compat_mcp.py — anamnesis-compat MCP shim (v8).
+
+Per docs/specs/hermes-worker-decomposition-v8.md §5.2 Phase 4a sequencing:
+  Native: anamnesis_store, anamnesis_temporal_add (writes)
+  Future: anamnesis_search, anamnesis_recall, anamnesis_transcript_search,
+          anamnesis_temporal_query, anamnesis_timeline, anamnesis_profile,
+          anamnesis_stats — wired in batch 5.3e
+  External: vault_search (filesystem; separate concern)
+
+Phase 5.3d ships the SHIM FRAMEWORK with:
+  - Scope env-var fallback (§5.1.9 tier 2)
+  - Trace generation at the MCP boundary
+  - 2 of 10 tools wired natively (anamnesis_store, anamnesis_search)
+  - Other 8 tools registered with stub handlers returning INVALID_INPUT
+    "tool not yet wired in v8 batch 5.3d"
+
+Phase 5.3e completes the remaining 7 read tools + temporal_add native +
+adds the migration tooling.
+
+Phase 4a config.yaml swap can happen once 5.3e ships; until then this
+shim is a Phase 5.3d artifact for testing the framework.
+
+Usage:
+    python -m hermes_agent.workers.memory.anamnesis_compat_mcp \\
+        --memory-db ~/.anamnesis/memory.db \\
+        --capability-db ~/.hermes/state/capability-router-usage.db
+
+    Plus env vars:
+        HERMES_CLIENT_ID=<client-id>
+        HERMES_PROFILE_ID=<profile-id>
+        HERMES_OLLAMA_URL=http://localhost:11434  (optional)
+        HERMES_QDRANT_URL=http://localhost:6333   (optional)
+"""
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import logging
+import os
+import sys
+from pathlib import Path
+from typing import Any, Dict, Optional
+
+from .._mcp.dispatch import McpStdioDispatcher
+from .._ipc.envelope import (
+    Envelope, ErrorCode, Scope, new_trace_id, new_span_id,
+)
+from .._ipc.server import HandlerError
+from .anamnesis.store import AnamnesisStoreWorker
+from .anamnesis.recall import AnamnesisRecallWorker
+from .anamnesis.vector_reindex import VectorReindexWorker
+from .memory_router import gate_write_handler
+from .thread_preferences import ThreadPreferenceStore
+from .anamnesis.external import (
+    make_embed_client_from_env,
+    make_vector_client_from_env,
+    NullEmbedClient,
+    NullVectorClient,
+)
+
+
+logger = logging.getLogger(__name__)
+
+
+async def _reindex_loop(worker: VectorReindexWorker, interval_s: float) -> None:
+    """Background task: drain the vector_status='pending' queue periodically.
+
+    Runs inside the shim subprocess so a v8 deployment is self-contained.
+    Survives transient batch failures (worker emits CRITICAL on dead-letter,
+    breaker opens on sustained failure). Cancelled cleanly on shim shutdown.
+    """
+    while True:
+        try:
+            await worker.run_one_batch()
+        except Exception as exc:  # noqa: BLE001 — log and keep looping
+            logger.warning("reindex batch raised: %s", exc)
+        await asyncio.sleep(interval_s)
+
+
+# v8 §5.1.9 reserved sentinel — never appears in production writes
+LEGACY_SENTINEL = "_legacy"
+
+
+# ─────────────────────────────────────────────────────────────────
+# Scope-injection wrapper around McpStdioDispatcher
+# ─────────────────────────────────────────────────────────────────
+
+class AnamnesisCompatDispatcher(McpStdioDispatcher):
+    """McpStdioDispatcher with v8 §5.1.9 env-var scope fallback.
+
+    When an MCP tools/call request lacks `_meta.scope`, inject from process
+    env (HERMES_CLIENT_ID + HERMES_PROFILE_ID). When `_meta.trace` lacks
+    trace_id/span_id, generate fresh ones at the boundary. This makes
+    anamnesis-compat MCP usable by agents that don't know about Hermes
+    envelopes — they call anamnesis_search like always; the shim handles
+    scope injection transparently.
+
+    If env vars are unset AND `_meta.scope` is absent, the underlying
+    dispatcher rejects with SCOPE_REQUIRED — v8 §5.1.9 tier-3 hard reject.
+    """
+
+    def __init__(
+        self,
+        *,
+        env_client_id: str,
+        env_profile_id: str,
+        **kwargs,
+    ):
+        super().__init__(**kwargs)
+        self._env_client_id = env_client_id.strip()
+        self._env_profile_id = env_profile_id.strip()
+
+    async def _handle_request(self, raw: str) -> Optional[str]:
+        # Parse JSON; on failure pass through to base for proper error envelope
+        try:
+            obj = json.loads(raw)
+        except json.JSONDecodeError:
+            return await super()._handle_request(raw)
+
+        # Inject scope + trace into tools/call if missing
+        if isinstance(obj, dict) and obj.get("method") == "tools/call":
+            params = obj.setdefault("params", {})
+            if not isinstance(params, dict):
+                params = {}
+                obj["params"] = params
+            meta = params.setdefault("_meta", {})
+            if not isinstance(meta, dict):
+                meta = {}
+                params["_meta"] = meta
+
+            # Tier 1: _meta.scope provided — use as-is
+            # Tier 2: env vars — inject if scope missing
+            if "scope" not in meta:
+                if self._env_client_id and self._env_profile_id:
+                    if self._env_client_id == LEGACY_SENTINEL:
+                        # Tier 3: hard reject — env points at reserved sentinel
+                        return self._encode_error(
+                            obj.get("id"), -32602,
+                            f"HERMES_CLIENT_ID is reserved sentinel {LEGACY_SENTINEL!r}",
+                        )
+                    meta["scope"] = {
+                        "client_id": self._env_client_id,
+                        "profile_id": self._env_profile_id,
+                    }
+                # else: tier 3 — leave scope absent; dispatcher returns SCOPE_REQUIRED
+
+            # Generate trace if missing (one trace per MCP call boundary)
+            if "trace" not in meta:
+                meta["trace"] = {
+                    "trace_id": new_trace_id(),
+                    "span_id": new_span_id(),
+                    "parent_span_id": None,
+                }
+
+            return await super()._handle_request(json.dumps(obj))
+
+        # Other methods: pass through unchanged
+        return await super()._handle_request(raw)
+
+
+# ─────────────────────────────────────────────────────────────────
+# Phase 5.3e-1: ALL 10 anamnesis tools wired native; no stubs.
+# ─────────────────────────────────────────────────────────────────
+
+# Empty for backwards compatibility with tests that imported PENDING_TOOLS.
+# Phase 5.3e-1 retired all stubs; the constant is kept as () so existing
+# tests don't break.
+PENDING_TOOLS: tuple = ()
+
+
+def make_pending_handler(tool_name: str):
+    """Backwards-compat shim. Returns the same INVALID_INPUT handler from
+    5.3d. Kept so tests importing this name still pass; no production
+    handler routes through here in Phase 5.3e-1+.
+    """
+    async def handler(env: Envelope) -> Dict[str, Any]:
+        raise HandlerError(
+            ErrorCode.INVALID_INPUT,
+            f"tool {tool_name!r} now wired natively (v8 batch 5.3e-1); "
+            f"this stub exists only for 5.3d backwards compat",
+            retryable=False,
+        )
+    return handler
+
+
+# Schemas matching old anamnesis server.py (preserve agent-visible surface)
+
+SCHEMA_STORE = {
+    "type": "object",
+    "properties": {
+        "content": {"type": "string", "description": "The fact to remember"},
+        "container": {"type": "string", "description": "default/work/personal/research/clients/archive",
+                      "default": "default"},
+        "confidence": {"type": "number", "default": 0.9},
+        "event_date": {"type": "string", "description": "ISO date when event occurred"},
+        # v8 extensions:
+        "memory_type": {"type": "string", "enum": [
+            "decision", "person", "lesson", "project",
+            "commitment", "preference", "handoff", "general",
+        ], "default": "general"},
+        "priority": {"type": "string", "enum": ["critical", "notable", "background", "normal"],
+                     "default": "normal"},
+        "metadata": {"type": "object"},
+        "request_id": {"type": "string", "description": "v8 idempotency key"},
+    },
+    "required": ["content"],
+}
+
+SCHEMA_SEARCH = {
+    "type": "object",
+    "properties": {
+        "query": {"type": "string", "description": "Natural language query"},
+        "container": {"type": "string", "description": "default/work/personal/research/clients/archive"},
+        "limit": {"type": "integer", "default": 10},
+        # v8 extensions:
+        "include_legacy": {"type": "boolean", "default": False},
+        "retrieval_mode": {"type": "string", "enum": ["fts", "vector", "hybrid"], "default": "fts"},
+        "types": {"type": "array", "items": {"type": "string"}},
+        "priority": {"type": "string"},
+    },
+    "required": ["query"],
+}
+
+
+# ─────────────────────────────────────────────────────────────────
+# CLI entry point
+# ─────────────────────────────────────────────────────────────────
+
+async def run(args: argparse.Namespace) -> int:
+    # Workers
+    # Phase 5.3e-1: use ExtendedAnamnesisRecallWorker (subclass adds 6 read methods + vault)
+    from .anamnesis.read_tools import ExtendedAnamnesisRecallWorker
+
+    store_worker = AnamnesisStoreWorker(str(args.memory_db), str(args.capability_db))
+    store_worker.open()
+
+    recall_worker = ExtendedAnamnesisRecallWorker(
+        str(args.memory_db),
+        vault_root=os.environ.get("BRAIN_VAULT", os.path.expanduser("~/Documents/Brain")),
+    )
+    recall_worker.open()
+
+    dispatcher = AnamnesisCompatDispatcher(
+        env_client_id=os.environ.get("HERMES_CLIENT_ID", ""),
+        env_profile_id=os.environ.get("HERMES_PROFILE_ID", ""),
+        server_name="anamnesis",
+        server_version="v8-compat-1.0.0",
+    )
+
+    # Memory-write routing gate (hardening): the model may propose a memory;
+    # the harness owns placement. Default-denies hot-profile promotion and
+    # auto-routes thread-scoped facts to the scoped preference store. Override
+    # with HERMES_MEMORY_GATE_ENFORCE=0 (advisory) or HERMES_MEMORY_GATE_BYPASS=1.
+    thread_pref_db = os.environ.get(
+        "HERMES_THREAD_PREF_DB",
+        str(Path.home() / ".hermes" / "state" / "thread_preferences.db"),
+    )
+    thread_pref_store = ThreadPreferenceStore(thread_pref_db)
+    thread_pref_store.open()
+
+    # All 10 anamnesis tools wired native (Phase 5.3e-1):
+
+    # Writes — wrapped by the memory routing gate
+    dispatcher.register(
+        "anamnesis_store",
+        gate_write_handler(store_worker.handle_store, "anamnesis_store",
+                           thread_store=thread_pref_store),
+        version="1.0.0", compatible_callers=">=1.0 <2.0",
+        input_schema=SCHEMA_STORE,
+        description="Store a memory fact in the anamnesis knowledge base",
+    )
+    dispatcher.register(
+        "anamnesis_temporal_add",
+        gate_write_handler(store_worker.handle_temporal_add, "anamnesis_temporal_add",
+                           thread_store=thread_pref_store),
+        version="1.0.0", compatible_callers=">=1.0 <2.0",
+        description="Store a temporal relationship triple with validity dates",
+    )
+
+    # Reads (memories)
+    dispatcher.register(
+        "anamnesis_search", recall_worker.handle_recall,
+        version="1.0.0", compatible_callers=">=1.0 <2.0",
+        input_schema=SCHEMA_SEARCH,
+        description="Hybrid vector + FTS search over anamnesis memories",
+    )
+    # Note: read_tools.handle_recall is the recent-N tool; recall.handle_recall
+    # is the search-with-query tool. They have the same name on different
+    # classes (Python MRO resolves to the subclass). Register under different
+    # tool names below.
+    dispatcher.register(
+        "anamnesis_recall", recall_worker.handle_recall_recent,
+        version="1.0.0", compatible_callers=">=1.0 <2.0",
+        description="Recall recent memories from a container",
+    )
+
+    # Reads (chunks/temporal/profiles)
+    dispatcher.register(
+        "anamnesis_transcript_search", recall_worker.handle_transcript_search,
+        version="1.0.0", compatible_callers=">=1.0 <2.0",
+        description="FTS5 search over raw conversation chunks",
+    )
+    dispatcher.register(
+        "anamnesis_temporal_query", recall_worker.handle_temporal_query,
+        version="1.0.0", compatible_callers=">=1.0 <2.0",
+        description="Query temporal facts for an entity",
+    )
+    dispatcher.register(
+        "anamnesis_timeline", recall_worker.handle_timeline,
+        version="1.0.0", compatible_callers=">=1.0 <2.0",
+        description="Chronological timeline of temporal facts",
+    )
+    dispatcher.register(
+        "anamnesis_profile", recall_worker.handle_profile,
+        version="1.0.0", compatible_callers=">=1.0 <2.0",
+        description="Query user profile attributes",
+    )
+    dispatcher.register(
+        "anamnesis_stats", recall_worker.handle_stats,
+        version="1.0.0", compatible_callers=">=1.0 <2.0",
+        description="Memory system statistics: counts, containers, vector pipeline health",
+    )
+
+    # Filesystem
+    dispatcher.register(
+        "vault_search", recall_worker.handle_vault_search,
+        version="1.0.0", compatible_callers=">=1.0 <2.0",
+        description="Search the Obsidian Brain vault for files matching a query",
+    )
+
+    # Phase 5.7e: env-driven embed + vector clients + background reindex loop.
+    # Until this lands, store-side anamnesis_store calls would queue rows at
+    # vector_status='pending' forever (no client wired = no drain).
+    embed_client = make_embed_client_from_env()
+    vector_client = make_vector_client_from_env()
+
+    reindex_task: Optional[asyncio.Task] = None
+    reindex_worker: Optional[VectorReindexWorker] = None
+    interval = float(getattr(args, "reindex_interval", 15.0))
+    enable_reindex = (
+        not getattr(args, "no_reindex", False)
+        and interval > 0
+        and not isinstance(embed_client, NullEmbedClient)
+        and not isinstance(vector_client, NullVectorClient)
+    )
+    if enable_reindex:
+        reindex_worker = VectorReindexWorker(
+            str(args.memory_db),
+            embed_client=embed_client,
+            vector_client=vector_client,
+        )
+        reindex_worker.open()
+        reindex_task = asyncio.create_task(_reindex_loop(reindex_worker, interval))
+        logger.info("reindex loop spawned (interval=%.1fs)", interval)
+    else:
+        if isinstance(embed_client, NullEmbedClient) or isinstance(vector_client, NullVectorClient):
+            logger.warning(
+                "reindex skipped: embed=%s vector=%s — vector_status='pending' rows will accumulate",
+                type(embed_client).__name__, type(vector_client).__name__,
+            )
+        else:
+            logger.info("reindex disabled (--no-reindex or interval<=0)")
+
+    try:
+        return await dispatcher.run_stdio()
+    finally:
+        if reindex_task is not None:
+            reindex_task.cancel()
+            try:
+                await reindex_task
+            except asyncio.CancelledError:
+                pass
+        if reindex_worker is not None:
+            reindex_worker.close()
+        thread_pref_store.close()
+        store_worker.close()
+        recall_worker.close()
+
+
+def main() -> int:
+    p = argparse.ArgumentParser(
+        description="Anamnesis-compat MCP shim (v8 §5.2 cutover target)"
+    )
+    p.add_argument("--memory-db", required=True, type=Path)
+    p.add_argument("--capability-db", required=True, type=Path)
+    p.add_argument("--log-level", default="WARNING")
+    p.add_argument("--reindex-interval", type=float, default=15.0,
+                   help="Seconds between reindex batches. <=0 disables.")
+    p.add_argument("--no-reindex", action="store_true",
+                   help="Disable in-shim reindex loop (use when running "
+                        "the reindex worker as a separate process).")
+    args = p.parse_args()
+
+    # Logs to stderr ONLY — stdout is the MCP wire
+    logging.basicConfig(
+        level=args.log_level,
+        stream=sys.stderr,
+        format="%(asctime)s %(levelname)s %(name)s %(message)s",
+    )
+    return asyncio.run(run(args))
+
+
+if __name__ == "__main__":
+    sys.exit(main())
