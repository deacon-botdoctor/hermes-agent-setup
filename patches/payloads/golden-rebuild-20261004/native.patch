@@ -0,0 +1,208 @@
+"""workers/memory/summarize.py — memory-summarize worker.
+
+Per docs/specs/hermes-worker-decomposition-v4.md §5.2:
+  Function: memory::summarize
+  Read-only on memory_store.db AND state.db.
+  Reads message history (state.db.messages joined via session_id),
+  produces summary, returns to caller. Caller decides whether to
+  memory::store the summary.
+
+Function: memory::summarize
+Args:
+    thread_id: str — Hermes thread identifier
+    target_tokens: int — desired summary length budget
+    max_messages: int — max messages to consider (default 50, max 500)
+Returns:
+    {"ok": True, "data": {
+        "summary": str,
+        "thread_id": str,
+        "messages_considered": int,
+        "tokens_in_estimate": int,
+        "tokens_out_estimate": int,
+        "provider": "heuristic-v1",
+    }}
+
+Phase 1 batch 2: heuristic placeholder (head + tail slice).
+Phase 1 batch 3: real LLM provider chain integration.
+
+Closes the bug class from `Lessons/context-compression-causes-agent-amnesia.md`
+by giving callers explicit control: `memory::summarize` returns text, the
+caller decides whether to store it. The old protectLastN=4 plugin's amnesia
+bug — where the gateway internally and silently summarized — becomes
+impossible because summarization is now a deliberate worker call, not
+implicit gateway behavior.
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+import sqlite3
+from pathlib import Path
+from typing import Any, Dict, List, Optional, Tuple
+
+from .._ipc.envelope import Envelope, ErrorCode
+from .._ipc.server import HandlerError
+
+
+logger = logging.getLogger(__name__)
+
+
+DEFAULT_MAX_MESSAGES = 50
+HARD_MAX_MESSAGES = 500
+
+
+class MemorySummarizeWorker:
+    """memory::summarize handler. Read-only over state.db + durable-threads.db."""
+
+    def __init__(self, state_db_path: str, durable_db_path: str):
+        self.state_db_path = state_db_path
+        self.durable_db_path = durable_db_path
+        self._state_conn: Optional[sqlite3.Connection] = None
+        self._durable_conn: Optional[sqlite3.Connection] = None
+        self._lock = asyncio.Lock()
+
+    def open(self) -> None:
+        # Read-only WAL connections.
+        self._state_conn = sqlite3.connect(
+            f"file:{self.state_db_path}?mode=ro",
+            uri=True, isolation_level=None, check_same_thread=False,
+        )
+        self._state_conn.execute("PRAGMA busy_timeout=5000")
+        self._durable_conn = sqlite3.connect(
+            f"file:{self.durable_db_path}?mode=ro",
+            uri=True, isolation_level=None, check_same_thread=False,
+        )
+        self._durable_conn.execute("PRAGMA busy_timeout=5000")
+
+    def close(self) -> None:
+        for c in (self._state_conn, self._durable_conn):
+            if c is not None:
+                try:
+                    c.close()
+                except sqlite3.Error:
+                    pass
+        self._state_conn = None
+        self._durable_conn = None
+
+    async def handle_summarize(self, env: Envelope) -> Dict[str, Any]:
+        thread_id = env.args.get("thread_id")
+        target_tokens = env.args.get("target_tokens", 1000)
+        max_messages = env.args.get("max_messages", DEFAULT_MAX_MESSAGES)
+
+        if not isinstance(thread_id, str) or not thread_id:
+            raise HandlerError(
+                ErrorCode.INVALID_INPUT,
+                "args.thread_id is required (non-empty string)",
+                retryable=False,
+            )
+        try:
+            target_tokens = int(target_tokens)
+            max_messages = int(max_messages)
+        except (TypeError, ValueError):
+            raise HandlerError(ErrorCode.INVALID_INPUT,
+                               "args.target_tokens and args.max_messages must be int",
+                               retryable=False)
+        max_messages = max(1, min(HARD_MAX_MESSAGES, max_messages))
+
+        async with self._lock:
+            return await asyncio.get_running_loop().run_in_executor(
+                None, self._do_summarize_sync, thread_id, target_tokens, max_messages,
+            )
+
+    def _do_summarize_sync(self, thread_id: str, target_tokens: int, max_messages: int) -> Dict[str, Any]:
+        assert self._durable_conn is not None and self._state_conn is not None
+
+        # Find session_id(s) for this thread_id (durable-threads.db)
+        # agent_threads schema has thread_id; session_key sometimes equals session_id,
+        # sometimes is a Telegram-style key. Best-effort: try session_key as session_id.
+        rows = self._durable_conn.execute(
+            """
+            SELECT DISTINCT session_key, run_id, started_at
+              FROM agent_threads
+             WHERE thread_id = ?
+             ORDER BY started_at DESC
+             LIMIT 50
+            """,
+            (thread_id,),
+        ).fetchall()
+        candidate_session_keys = [r[0] for r in rows if r[0]]
+
+        if not candidate_session_keys:
+            return {"ok": True, "data": {
+                "summary": f"(no messages found for thread_id={thread_id!r})",
+                "thread_id": thread_id,
+                "messages_considered": 0,
+                "tokens_in_estimate": 0,
+                "tokens_out_estimate": 0,
+                "provider": "heuristic-v1",
+            }}
+
+        # Read messages from state.db
+        # Order ascending so head/tail slicing is chronological.
+        placeholders = ",".join("?" * len(candidate_session_keys))
+        try:
+            msg_rows = self._state_conn.execute(
+                f"""
+                SELECT role, content, timestamp
+                  FROM messages
+                 WHERE session_id IN ({placeholders})
+                   AND content IS NOT NULL AND content != ''
+                 ORDER BY timestamp ASC
+                 LIMIT ?
+                """,
+                (*candidate_session_keys, max_messages),
+            ).fetchall()
+        except sqlite3.OperationalError as exc:
+            # Schema drift safety
+            raise HandlerError(
+                ErrorCode.INTERNAL_FAILURE,
+                f"messages query failed: {exc}",
+                retryable=False,
+            )
+
+        if not msg_rows:
+            return {"ok": True, "data": {
+                "summary": f"(no message content for thread_id={thread_id!r})",
+                "thread_id": thread_id,
+                "messages_considered": 0,
+                "tokens_in_estimate": 0,
+                "tokens_out_estimate": 0,
+                "provider": "heuristic-v1",
+            }}
+
+        # Heuristic placeholder: head + tail slice with separator.
+        # Real LLM summarization lands in batch 3.
+        chars_budget = target_tokens * 4  # rough est: 1 token = 4 chars
+        head_n, tail_n = 5, 5
+
+        def _fmt(rows):
+            return "\n".join(f"  [{r[0]}] {(r[1] or '')[:200]}" for r in rows)
+
+        parts = [f"Thread {thread_id} — {len(msg_rows)} messages"]
+        if len(msg_rows) <= head_n + tail_n:
+            # Small enough to show every message in chronological order.
+            parts.append(_fmt(msg_rows))
+        else:
+            head = msg_rows[:head_n]
+            tail = msg_rows[-tail_n:]
+            parts.append(f"\nFirst {head_n}:")
+            parts.append(_fmt(head))
+            parts.append(f"\n... ({len(msg_rows) - head_n - tail_n} omitted) ...")
+            parts.append(f"\nLast {tail_n}:")
+            parts.append(_fmt(tail))
+
+        summary = "\n".join(parts)
+        if len(summary) > chars_budget:
+            summary = summary[:chars_budget - 4] + " ..."
+
+        tokens_in = sum(len(r[1] or "") for r in msg_rows) // 4
+        tokens_out = len(summary) // 4
+
+        return {"ok": True, "data": {
+            "summary": summary,
+            "thread_id": thread_id,
+            "messages_considered": len(msg_rows),
+            "tokens_in_estimate": tokens_in,
+            "tokens_out_estimate": tokens_out,
+            "provider": "heuristic-v1",
+        }}
