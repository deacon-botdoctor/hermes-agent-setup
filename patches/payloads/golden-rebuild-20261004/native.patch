+"""
+workers/memory/memory_router.py — Memory-write routing gate (hardening).
+
+The model may PROPOSE a memory; the harness owns PLACEMENT. This module is
+the gate that sits in front of every anamnesis write (anamnesis_store,
+anamnesis_temporal_add). It:
+
+  1. classifies the candidate (deterministic, rule-based — no per-write LLM
+     call, which would be too slow/flaky in the hot path and can deadlock),
+  2. enforces a HARD default-deny on hot-profile promotion: only hot_user
+     facts that pass the hot rules may reach the store; thread/project/skill/
+     ephemeral/stale facts are rejected at the anamnesis boundary,
+  3. auto-routes thread-scoped facts to the thread_preferences store and
+     returns a routing directive (Point 8: outcome-level result) for the
+     classes owned by other systems (gbrain / skills / session),
+  4. attaches provenance to every decision (Point 9),
+  5. honors an operator kill-switch so a bad gate can never brick fleet
+     memory (mirrors the OPENROUTER_ALLOWED provenance from 2026-06-09).
+
+Enforcement posture is controlled by env vars, read ONCE at gate construction:
+  HERMES_MEMORY_GATE_ENFORCE  default "1". "0"/"false" => advisory mode
+                              (classify + log, writes still pass through).
+  HERMES_MEMORY_GATE_BYPASS   default "". "1"/"true" => skip the gate
+                              entirely (emergency operator override).
+
+Golden-neutral: no client names / host aliases / Telegram IDs. Routing
+targets are logical keys resolved by the declarations table.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import re
+from dataclasses import asdict, dataclass
+from typing import Any, Awaitable, Callable, Dict, Optional
+
+# Declarations live in hermes_agent.tools; import both ways so the module is
+# usable under the installed package AND from direct path (tests).
+try:  # pragma: no cover - import path depends on how the module is loaded
+    from ...tools.memory_routing_declarations import (
+        REJECT_AMBIGUOUS,
+        REJECT_EMPTY,
+        REJECT_LOW_FREQUENCY,
+        REJECT_STALE,
+        REJECT_THREAD_SCOPED,
+        may_write_to_anamnesis,
+        target_store_for,
+    )
+except ImportError:  # pragma: no cover
+    from tools.memory_routing_declarations import (  # type: ignore[no-redef]
+        REJECT_AMBIGUOUS,
+        REJECT_EMPTY,
+        REJECT_LOW_FREQUENCY,
+        REJECT_STALE,
+        REJECT_THREAD_SCOPED,
+        may_write_to_anamnesis,
+        target_store_for,
+    )
+
+logger = logging.getLogger(__name__)
+
+# A memory-write handler has the same shape as any Hermes MCP worker handler.
+MemoryHandler = Callable[[Any], Awaitable[Dict[str, Any]]]
+
+# How long a hot-profile candidate may be before it is "too verbose".
+HOT_MAX_CHARS = 600
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Classification result — fills the mandatory pre-write schema (Point 2).
+# ─────────────────────────────────────────────────────────────────────────────
+
+
+@dataclass
+class Classification:
+    candidate: str
+    scope: str  # hot_user | agent_memory | thread | project | skill | ephemeral | reject
+    lifespan: str  # minutes | session | weeks | durable
+    applies_to: str  # global | thread | project | client | machine | workflow
+    frequency: str  # rare | occasional | frequent
+    source: str  # explicit_user_instruction | inferred | observed_tool_output
+    confidence: str  # low | medium | high
+    target_store: Optional[str]
+    write_allowed: bool  # may this candidate reach the anamnesis store?
+    hot_memory_allowed: bool  # may it promote to the hot USER profile?
+    reason: Optional[str] = None  # reject code when write_allowed is False
+
+    def to_dict(self) -> Dict[str, Any]:
+        return asdict(self)
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Rule signals. Ordered most-specific-first in classify(). Lowercase matching.
+# ─────────────────────────────────────────────────────────────────────────────
+
+_RE_STALE_ID = re.compile(r"\b(?:pr|issue|mr|cl|commit)\s*#?\s*\d+\b", re.IGNORECASE)
+_RE_BARE_ID = re.compile(r"(?<![\w/])#\d{2,}\b")
+_STALE_PHRASES = (
+    "fixed it",
+    "merged in",
+    "closed in",
+    "resolved by",
+    "shipped in",
+    "done in",
+    "landed in",
+    "reverted in",
+    "hotfix for",
+)
+_PROC_PHRASES = (
+    "when doing",
+    "when i ",
+    "when you ",
+    "when we ",
+    "checklist",
+    "procedure",
+    "step 1",
+    "run this report",
+    "run the report",
+    "every monday",
+    "every tuesday",
+    "every wednesday",
+    "every friday",
+    "weekly report",
+    "workflow for",
+    "how to generate",
+    "how to run",
+    "on Mondays".lower(),
+    "on a schedule",
+    "the procedure is",
+    "the workflow is",
+    "runbook",
+)
+_PROJECT_PHRASES = (
+    "this repo",
+    "this client",
+    "this project",
+    "the codebase",
+    "the repo uses",
+    "convention is",
+    "conventions are",
+    "editorial",
+    "billing email",
+    "billing address",
+    "roster",
+    "the company is",
+    "positioning",
+    "is written in",
+    "uses pnpm",
+    "uses npm",
+    "uses cargo",
+    "uses pipenv",
+)
+_THREAD_PHRASES = (
+    "in this thread",
+    "in this chat",
+    "in this channel",
+    "in this topic",
+    "for these",
+    "on these",
+    "for this thread",
+    "in here",
+    "this topic",
+    "this channel",
+)
+# Catches scoped thread references like "this politics thread", "the news thread",
+# "in this research thread" without matching "multithread" / "threaded".
+_RE_THREAD_REF = re.compile(
+    r"\b(?:this|that|the|a|politics|news|research|family|client)\s+"
+    r"(?:\w+\s+){0,2}thread\b",
+    re.IGNORECASE,
+)
+_EPH_PHRASES = (
+    "currently",
+    "right now",
+    "this session",
+    "in progress",
+    "working on",
+    "just did",
+    "next step is",
+    "status:",
+    "todo:",
+    "the current task",
+    "for now i",
+    "at the moment",
+)
+_AGENT_PHRASES = (
+    "uses ssh",
+    "steering uses",
+    "on this machine",
+    "the harness",
+    "the runtime",
+    "lives at",
+    "runs on",
+    "is configured to",
+    "the path is",
+    "the agent uses",
+    "the gateway uses",
+    "is deployed on",
+)
+# Explicit durability / global-personal markers that justify hot-profile promotion.
+_HOT_DURABILITY_PHRASES = (
+    "always",
+    "everywhere",
+    "from now on",
+    "from now",
+    "i hate",
+    "i prefer",
+    "i love",
+    "i like",
+    "i cannot stand",
+    "i can't stand",
+    "my name is",
+    "my timezone",
+    "my time zone",
+    "i live in",
+    "i am in",
+    "i'm in",
+    "i work in",
+    "my role is",
+    "i am a",
+    "i'm a",
+)
+
+
+def _norm(text: str) -> str:
+    return re.sub(r"\s+", " ", (text or "").strip()).lower()
+
+
+def _source_from_context(context: Dict[str, Any]) -> str:
+    s = (context.get("source") or "").strip()
+    if s in ("explicit_user_instruction", "inferred", "observed_tool_output"):
+        return s
+    return "inferred"
+
+
+def _thread_key(context: Dict[str, Any]) -> Optional[str]:
+    return (context.get("thread_key") or "").strip() or None
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Hot-profile rules (Point 3). Default-deny: must clear every gate.
+# ─────────────────────────────────────────────────────────────────────────────
+
+
+def classify_hot_allowed(candidate: str, cls: Classification) -> tuple:
+    """Return (allowed, reject_reason). Hot profile is scarce L1 cache."""
+    if len(candidate) > HOT_MAX_CHARS:
+        return False, "REJECT_TOO_VERBOSE"
+    # An inferred/observed single utterance never promotes; behavior must prove
+    # recurring (an explicit durability marker counts as declared recurring intent).
+    if cls.source == "inferred" and not _has_hot_durability(candidate):
+        return False, REJECT_LOW_FREQUENCY
+    if cls.source == "observed_tool_output":
+        return False, REJECT_LOW_FREQUENCY
+    if not _has_hot_durability(candidate):
+        return False, REJECT_LOW_FREQUENCY
+    return True, None
+
+
+def _has_hot_durability(candidate: str) -> bool:
+    n = _norm(candidate)
+    return any(p in n for p in _HOT_DURABILITY_PHRASES)
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# classify — deterministic, rule-based, first-match-wins.
+# ─────────────────────────────────────────────────────────────────────────────
+
+
+def classify(candidate: str, context: Optional[Dict[str, Any]] = None) -> Classification:
+    context = context or {}
+    source = _source_from_context(context)
+    text = candidate or ""
+    n = _norm(text)
+
+    base = dict(
+        candidate=text,
+        source=source,
+        confidence="medium" if source == "explicit_user_instruction" else "low",
+    )
+
+    # 1. empty
+    if not n:
+        return Classification(
+            scope="reject",
+            lifespan="minutes",
+            applies_to="global",
+            frequency="rare",
+            target_store=None,
+            write_allowed=False,
+            hot_memory_allowed=False,
+            reason=REJECT_EMPTY,
+            **base,
+        )
+
+    # 2. stale / one-time
+    if _RE_STALE_ID.search(text) or _RE_BARE_ID.search(text) or any(p in n for p in _STALE_PHRASES):
+        return Classification(
+            scope="reject",
+            lifespan="minutes",
+            applies_to="global",
+            frequency="rare",
+            target_store=None,
+            write_allowed=False,
+            hot_memory_allowed=False,
+            reason=REJECT_STALE,
+            **base,
+        )
+
+    # 3. procedural / skill
+    if any(p in n for p in _PROC_PHRASES):
+        return Classification(
+            scope="skill",
+            lifespan="weeks",
+            applies_to="workflow",
+            frequency="occasional",
+            target_store=target_store_for("skill"),
+            write_allowed=False,
+            hot_memory_allowed=False,
+            reason="REJECT_PROCEDURAL",
+            **base,
+        )
+
+    # 4. project / client / editorial knowledge
+    if any(p in n for p in _PROJECT_PHRASES):
+        return Classification(
+            scope="project",
+            lifespan="weeks",
+            applies_to="project",
+            frequency="occasional",
+            target_store=target_store_for("project"),
+            write_allowed=False,
+            hot_memory_allowed=False,
+            reason="REJECT_PROJECT_SCOPED",
+            **base,
+        )
+
+    # 5. thread-scoped
+    if any(p in n for p in _THREAD_PHRASES) or _RE_THREAD_REF.search(text):
+        # thread_key presence sharpens confidence but is not required to reject
+        # from hot; without it the fact still does not belong in the global profile.
+        thread_base = {**base, "confidence": "high" if _thread_key(context) else "medium"}
+        return Classification(
+            scope="thread",
+            lifespan="weeks",
+            applies_to="thread",
+            frequency="occasional",
+            target_store=target_store_for("thread"),
+            write_allowed=False,
+            hot_memory_allowed=False,
+            reason=REJECT_THREAD_SCOPED,
+            **thread_base,
+        )
+
+    # 6. ephemeral / current task state
+    if any(p in n for p in _EPH_PHRASES):
+        return Classification(
+            scope="ephemeral",
+            lifespan="session",
+            applies_to="global",
+            frequency="rare",
+            target_store=target_store_for("ephemeral"),
+            write_allowed=False,
+            hot_memory_allowed=False,
+            reason=REJECT_AMBIGUOUS,
+            **base,
+        )
+
+    # 7. agent / operator memory (env / tool convention)
+    if any(p in n for p in _AGENT_PHRASES):
+        return Classification(
+            scope="agent_memory",
+            lifespan="weeks",
+            applies_to="machine",
+            frequency="occasional",
+            target_store=target_store_for("agent_memory"),
+            write_allowed=True,
+            hot_memory_allowed=False,
+            **base,
+        )
+
+    # 8. hot user profile CANDIDATE — still subject to the hot rules below
+    if _has_hot_durability(text):
+        cls = Classification(
+            scope="hot_user",
+            lifespan="durable",
+            applies_to="global",
+            frequency="frequent",
+            target_store=target_store_for("hot_user"),
+            write_allowed=True,
+            hot_memory_allowed=True,
+            **base,
+        )
+        allowed, reason = classify_hot_allowed(text, cls)
+        if not allowed:
+            # demote: never pollute global memory from a weak/ambiguous signal
+            return Classification(
+                scope="ephemeral",
+                lifespan="session",
+                applies_to="global",
+                frequency="rare",
+                target_store=target_store_for("ephemeral"),
+                write_allowed=False,
+                hot_memory_allowed=False,
+                reason=reason,
+                candidate=text,
+                source=source,
+                confidence="low",
+            )
+        return cls
+
+    # 9. default — ambiguous. Hard-deny hot; route to session. Never global.
+    return Classification(
+        scope="ephemeral",
+        lifespan="session",
+        applies_to="global",
+        frequency="rare",
+        target_store=target_store_for("ephemeral"),
+        write_allowed=False,
+        hot_memory_allowed=False,
+        reason=REJECT_AMBIGUOUS,
+        **base,
+    )
+
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Gate wrapper — sits in front of anamnesis write handlers.
+# ─────────────────────────────────────────────────────────────────────────────
+
+
+def _extract_candidate(tool_name: str, args: Dict[str, Any]) -> str:
+    """Pull the human-meaningful text out of a write call's arguments."""
+    if tool_name == "anamnesis_store":
+        return str(args.get("content") or "")
+    if tool_name == "anamnesis_temporal_add":
+        parts = [args.get(k) for k in ("subject", "predicate", "object") if args.get(k)]
+        return " ".join(str(p) for p in parts)
+    # Fallback: best-effort join of string-valued args.
+    return " ".join(str(v) for v in args.values() if isinstance(v, str))
+
+
+def _context_from_env(env: Any, args: Dict[str, Any]) -> Dict[str, Any]:
+    scope = getattr(env, "scope", None)
+    client_id = getattr(scope, "client_id", "") or "" if scope else ""
+    profile_id = getattr(scope, "profile_id", "") or "" if scope else ""
+    meta = args.get("metadata") if isinstance(args.get("metadata"), dict) else {}
+    thread_key = meta.get("thread_id") or meta.get("chat_id") or meta.get("topic_id") or ""
+    return {
+        "client_id": client_id,
+        "profile_id": profile_id,
+        "thread_key": str(thread_key) if thread_key else None,
+        "trace_id": getattr(env, "trace_id", "") or "",
+        "span_id": getattr(env, "span_id", "") or "",
+    }
+
+
+def _tag_args(args: Dict[str, Any], scope: str) -> None:
+    """Stamp the memory class onto the call so the dream-cycle can honor it."""
+    meta = args.setdefault("metadata", {})
+    if not isinstance(meta, dict):
+        meta = {}
+        args["metadata"] = meta
+    meta["memory_class"] = scope
+
+
+def _log_decision(tool_name: str, decision: str, cls: Classification, context: Dict[str, Any]) -> None:
+    logger.info(
+        "memory_router decision=%s tool=%s scope=%s reason=%s target=%s hot=%s client=%s profile=%s thread=%s trace=%s",
+        decision,
+        tool_name,
+        cls.scope,
+        cls.reason,
+        cls.target_store,
+        cls.hot_memory_allowed,
+        context.get("client_id"),
+        context.get("profile_id"),
+        context.get("thread_key"),
+        context.get("trace_id"),
+    )
+
+
+def _route_result(cls: Classification, *, stored: bool, thread_key: Optional[str] = None) -> Dict[str, Any]:
+    """Outcome-level result returned INSTEAD of a hot write (Point 8)."""
+    out: Dict[str, Any] = {
+        "stored": stored,
+        "routed": True,
+        "scope": cls.scope,
+        "target_store": cls.target_store,
+        "reason": cls.reason,
+        "hot_memory": False,
+    }
+    if thread_key is not None:
+        out["thread_key"] = thread_key
+    return out
+
+
+def _env_truthy(name: str, default: str = "") -> bool:
+    return os.environ.get(name, default).strip().lower() in ("1", "true", "yes", "on")
+
+
+def gate_write_handler(
+    handler: MemoryHandler,
+    tool_name: str,
+    *,
+    thread_store: Any = None,
+    enforce: Optional[bool] = None,
+    bypass: Optional[bool] = None,
+) -> MemoryHandler:
+    """Wrap a memory-write handler with the routing gate.
+
+    enforce / bypass default to env-var reads so a process restart picks up
+    operator overrides without code changes.
+    """
+    do_enforce = _env_truthy("HERMES_MEMORY_GATE_ENFORCE", "1") if enforce is None else bool(enforce)
+    do_bypass = _env_truthy("HERMES_MEMORY_GATE_BYPASS", "") if bypass is None else bool(bypass)
+
+    async def _gated(env: Any) -> Dict[str, Any]:
+        args = getattr(env, "args", None) or {}
+        if not isinstance(args, dict):
+            args = {}
+        candidate = _extract_candidate(tool_name, args)
+        context = _context_from_env(env, args)
+        cls = classify(candidate, context)
+
+        # Emergency operator override: skip the gate entirely.
+        if do_bypass:
+            _log_decision(tool_name, "bypass", cls, context)
+            return await handler(env)
+
+        # Advisory mode: classify + log, but let the write through unchanged.
+        if not do_enforce:
+            _log_decision(tool_name, "advisory_allow", cls, context)
+            return await handler(env)
+
+        # Enforce mode.
+        if may_write_to_anamnesis(cls.scope):
+            _tag_args(args, cls.scope)
+            _log_decision(tool_name, f"allow:{cls.scope}", cls, context)
+            return await handler(env)
+
+        # Rejected from anamnesis. Auto-route where a same-system store exists.
+        if cls.scope == "thread" and thread_store is not None:
+            try:
+                thread_store.put(
+                    context.get("client_id", ""),
+                    context.get("profile_id", ""),
+                    context.get("thread_key"),
+                    candidate,
+                    cls,
+                )
+                _log_decision(tool_name, "route:thread", cls, context)
+                return _route_result(cls, stored=True, thread_key=context.get("thread_key"))
+            except Exception:  # noqa: BLE001 — never let the store brick the gate
+                logger.exception("thread_preferences put failed; rejecting from anamnesis only")
+        _log_decision(tool_name, f"reject:{cls.scope}", cls, context)
+        return _route_result(cls, stored=False)
+
+    _gated.__wrapped__ = handler  # type: ignore[attr-defined]
+    _gated.__name__ = f"memory_gated_{tool_name}"
+    return _gated
