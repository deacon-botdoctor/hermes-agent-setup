+"""Host ownership at the native local spawn boundary; no external steward is invoked."""
+import json
+from types import SimpleNamespace
+from unittest.mock import MagicMock
+
+import pytest
+import tools.process_registry as pr
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setattr(pr, 'get_hermes_home', lambda: tmp_path)
+    monkeypatch.setattr(pr, 'CHECKPOINT_PATH', tmp_path / 'processes.json')
+    monkeypatch.setattr(pr, '_is_supervised_gateway_process', lambda: True)
+    (tmp_path / 'bin').mkdir()
+    (tmp_path / 'bin/hermes-host-steward.py').write_text('# test fixture')
+    return tmp_path
+
+
+def session(**kw):
+    return pr.ProcessSession(id='proc_test', command='echo test', task_id='task', pid=1234, **kw)
+
+
+def test_registration_requires_valid_lease_before_exposure(home, monkeypatch):
+    run = MagicMock(return_value=SimpleNamespace(stdout=json.dumps(dict(
+        schema='hermes-host-steward/v1', kind='process', task_id='task', lease_id='a'*32)), returncode=0))
+    monkeypatch.setattr(pr.subprocess, 'run', run)
+    item=session(systemd_unit='hermes-worker-test.scope')
+    assert pr._register_with_host_steward(item) == 'a'*32
+    assert item.host_steward_scope == 'managed'
+    assert item.host_steward_renewed_at > 0
+    argv=run.call_args.args[0]
+    assert argv[-2:] == ['--systemd-unit', 'hermes-worker-test.scope']
+    assert argv[argv.index('--pid')+1] == '1234'
+
+
+@pytest.mark.parametrize('payload', [{}, [], {'schema':'wrong'}, {'schema':'hermes-host-steward/v1','kind':'process','task_id':'other','lease_id':'a'*32}])
+def test_invalid_receipt_fails_closed(home, monkeypatch, payload):
+    monkeypatch.setattr(pr.subprocess,'run',lambda *a,**k:SimpleNamespace(stdout=json.dumps(payload),returncode=0))
+    with pytest.raises(pr._HostStewardRegistrationError):
+        pr._register_with_host_steward(session())
+
+
+def test_missing_or_symlink_steward_rejected(home):
+    path=home/'bin/hermes-host-steward.py';path.unlink()
+    with pytest.raises(pr._HostStewardRegistrationError): pr._register_with_host_steward(session())
+    (home/'fixture').write_text('fixture');path.symlink_to(home/'fixture')
+    with pytest.raises(pr._HostStewardRegistrationError): pr._register_with_host_steward(session())
+
+
+def test_interactive_process_is_user_owned(home,monkeypatch):
+    monkeypatch.setattr(pr,'_is_supervised_gateway_process',lambda:False)
+    run=MagicMock();monkeypatch.setattr(pr.subprocess,'run',run)
+    item=session();assert pr._register_with_host_steward(item)==''
+    assert item.host_steward_scope=='user';run.assert_not_called()
+
+
+def test_pipe_registration_failure_reaps_before_exposure(home,monkeypatch):
+    registry=pr.ProcessRegistry();proc=MagicMock(pid=1234)
+    monkeypatch.setattr(pr.subprocess,'Popen',lambda *a,**k:proc)
+    monkeypatch.setattr(registry,'_scope_argv',lambda *a: ['test'])
+    monkeypatch.setattr(registry,'_safe_host_start_time',lambda p:987)
+    monkeypatch.setattr(pr,'_register_with_host_steward',MagicMock(side_effect=pr._HostStewardRegistrationError('no lease')))
+    reap=MagicMock();track=MagicMock()
+    monkeypatch.setattr(registry,'_reap_untracked',reap);monkeypatch.setattr(registry,'_track_started',track)
+    with pytest.raises(pr._HostStewardRegistrationError): registry.spawn_local('echo test')
+    track.assert_not_called();reap.assert_called_once()
+    assert reap.call_args.args[0].host_start_time==987
+    assert registry._running=={}
+
+
+def test_pty_registration_failure_reaps_without_pipe_fallback(home,monkeypatch):
+    import ptyprocess
+    registry=pr.ProcessRegistry();pty=MagicMock(pid=1234)
+    monkeypatch.setattr(ptyprocess.PtyProcess,'spawn',lambda *a,**k:pty)
+    monkeypatch.setattr(registry,'_scope_argv',lambda *a:['test'])
+    monkeypatch.setattr(registry,'_safe_host_start_time',lambda p:987)
+    monkeypatch.setattr(pr,'_register_with_host_steward',MagicMock(side_effect=pr._HostStewardRegistrationError('no lease')))
+    kill=MagicMock();popen=MagicMock();track=MagicMock()
+    monkeypatch.setattr(registry,'_terminate_host_pid',kill)
+    monkeypatch.setattr(pr.subprocess,'Popen',popen);monkeypatch.setattr(registry,'_track_started',track)
+    with pytest.raises(pr._HostStewardRegistrationError): registry.spawn_local('echo test',use_pty=True)
+    kill.assert_called_once_with(1234,987);pty.terminate.assert_called_once_with(force=True)
+    track.assert_not_called();popen.assert_not_called()
+
+
+def test_checkpoint_recovery_fields_and_release_once(home,monkeypatch):
+    registry=pr.ProcessRegistry();item=session(host_start_time=987,host_steward_lease_id='a'*32,host_steward_scope='managed')
+    registry._running[item.id]=item;registry._write_checkpoint()
+    row=json.loads(pr.CHECKPOINT_PATH.read_text())[0]
+    assert row['host_steward_lease_id']=='a'*32 and row['host_steward_scope']=='managed'
+    # Native checkpoint decoder uses the same field table/defaults on recovery.
+    assert pr._CHECKPOINT_DEFAULTS['host_steward_lease_id']==''
+    recovered=pr.ProcessRegistry()
+    monkeypatch.setattr(recovered,'_host_pid_is_ours',lambda pid,birth:pid==1234 and birth==987)
+    assert recovered.recover_from_checkpoint()==1
+    restored=recovered._running[item.id]
+    assert restored.host_steward_lease_id==item.host_steward_lease_id
+    assert restored.host_steward_scope=='managed' and restored.detached
+
+    release=MagicMock();monkeypatch.setattr(pr,'_release_with_host_steward',release)
+    registry._move_to_finished(item);registry._move_to_finished(item)
+    release.assert_called_once_with(item)
+
+
+def test_renewal_throttle_and_release(home,monkeypatch):
+    item=session(host_steward_lease_id='a'*32)
+    run=MagicMock(return_value=SimpleNamespace(stdout='{"renewed":1}',returncode=0))
+    monkeypatch.setattr(pr.subprocess,'run',run)
+    pr._renew_with_host_steward(item);pr._renew_with_host_steward(item)
+    run.assert_called_once()
+    run.return_value=SimpleNamespace(stdout='{"outcome":"released"}',returncode=0)
+    pr._release_with_host_steward(item);assert item.host_steward_lease_id==''
