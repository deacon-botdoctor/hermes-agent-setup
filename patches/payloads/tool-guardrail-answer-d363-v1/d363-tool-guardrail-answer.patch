diff --git a/agent/turn_guardrail_recovery.py b/agent/turn_guardrail_recovery.py
new file mode 100644
index 0000000..b1da024
--- /dev/null
+++ b/agent/turn_guardrail_recovery.py
@@ -0,0 +1,35 @@
+"""One-shot answer-only recovery helpers for a latched tool guardrail halt."""
+from __future__ import annotations
+from typing import Any
+
+def shape_answer_only_request(agent: Any, api_kwargs: Any) -> dict:
+    """Return a request that keeps provider-required tool schemas but cannot authorize a call.
+
+    Call before observability hooks and again inside the execution-middleware callback: plugins
+    may observe the normal schema, but cannot restore auto tool selection or streaming.
+    """
+    payload = dict(api_kwargs)
+    if agent.api_mode == "bedrock_converse":
+        # Converse has no no-tool choice. Preserve history-required toolConfig;
+        # the existing recovery latch refuses any returned call before dispatch.
+        # Nonstreaming is selected by perform_api_call, not a Converse wire key.
+        for key in ("tool_choice", "parallel_tool_calls", "stream", "functions", "function_call"):
+            payload.pop(key, None)
+        return payload
+    if agent.api_mode == "anthropic_messages":
+        # Native Anthropic requires the schema to accompany ``tool_choice: none``. Compatible
+        # Messages endpoints retain their established omission behavior because many reject it.
+        from utils import base_url_hostname
+        if base_url_hostname(getattr(agent, "base_url", "") or "https://api.anthropic.com") == "api.anthropic.com":
+            payload["tool_choice"] = {"type": "none"}
+        else:
+            payload.pop("tools", None)
+            payload.pop("tool_choice", None)
+    else:
+        payload["tool_choice"] = "none"
+    payload["parallel_tool_calls"] = False
+    payload["stream"] = False
+    return payload
+
+def controlled_halt_text(agent: Any) -> str:
+    return agent._toolguard_controlled_halt_response(agent._tool_guardrail_halt_decision)
