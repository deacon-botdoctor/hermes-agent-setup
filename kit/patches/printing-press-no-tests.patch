@@ -40,6 +40,23 @@ var templateFS embed.FS
 // templates against already-published CLIs).
 var TemplateFS = templateFS
 
+// GeneratedTests is fixed by the distribution build. Existing source tests keep
+// their normal output; managed distributions can prohibit new test artifacts.
+var GeneratedTests = "enabled"
+
+func omitGeneratedTest(outPath string) bool {
+	if GeneratedTests != "disabled" {
+		return false
+	}
+	path := "/" + filepath.ToSlash(outPath) + "/"
+	if !strings.HasSuffix(outPath, "_test.go") &&
+		!strings.Contains(path, "/testdata/") && !strings.Contains(path, "/testenv/") {
+		return false
+	}
+	fmt.Fprintf(os.Stderr, "Omitted generated test material under distribution policy: %s\n", outPath)
+	return true
+}
+
