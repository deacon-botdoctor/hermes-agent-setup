#!/usr/bin/env python3
"""CLI for the read-only Refero DESIGN.md library."""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve()
candidates = [
    Path(os.environ.get("HERMES_HOME", str(Path.home() / ".hermes"))) / "mcp-servers" / "refero-styles" / "src",
    ROOT.parents[1] / "mcp-servers" / "refero-styles" / "src",
    ROOT.parents[2] / "mcp-servers" / "refero-styles" / "src",
]
for path in candidates:
    if (path / "refero_styles_mcp").is_dir():
        sys.path.insert(0, str(path))
        break

from refero_styles_mcp import client as refero  # noqa: E402


def emit(payload: dict) -> int:
    print(json.dumps(payload, indent=2, ensure_ascii=False))
    return 0 if payload.get("ok") else 1


def main() -> int:
    parser = argparse.ArgumentParser(description="Search and render Refero DESIGN.md files. Read-only.")
    sub = parser.add_subparsers(dest="cmd", required=True)

    search = sub.add_parser("search")
    search.add_argument("query")
    search.add_argument("--limit", type=int, default=8)

    getp = sub.add_parser("get")
    getp.add_argument("spec")

    sim = sub.add_parser("similar")
    sim.add_argument("spec")
    sim.add_argument("--limit", type=int, default=5)

    listp = sub.add_parser("list")
    listp.add_argument("--limit", type=int, default=20)

    md = sub.add_parser("design-md")
    md.add_argument("spec")

    sub.add_parser("refresh")
    sub.add_parser("status")

    args = parser.parse_args()
    if args.cmd == "search":
        return emit(refero.search_styles(args.query, limit=args.limit))
    if args.cmd == "get":
        return emit(refero.get_style(args.spec))
    if args.cmd == "similar":
        return emit(refero.similar_styles(args.spec, limit=args.limit))
    if args.cmd == "list":
        catalog = refero.list_catalog()
        cards = [refero._card(item) for item in catalog[: max(1, min(args.limit, 40))]]
        return emit({"ok": True, "count": len(cards), "total": len(catalog), "styles": cards})
    if args.cmd == "design-md":
        payload = refero.render_design_md(args.spec)
        if payload.get("ok") and payload.get("markdown"):
            print(payload["markdown"])
            return 0
        return emit(payload)
    if args.cmd == "refresh":
        return emit(refero.refresh_catalog())
    if args.cmd == "status":
        return emit(refero.status())
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
