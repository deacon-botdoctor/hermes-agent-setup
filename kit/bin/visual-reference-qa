#!/usr/bin/env python3
"""Smoke tests for golden visual-reference lookup."""
from __future__ import annotations
import json, subprocess, sys
from pathlib import Path
ROOT = Path(__file__).resolve().parents[1]
LOOKUP = ROOT/'bin'/'visual-reference-lookup'
REGISTRY = ROOT/'skills'/'curated'/'visual-reference-library'/'registry.jsonl'
CASES = [
  ('report','client-pdf','premium diagnostic'),
  ('landing-section','web','editorial high trust'),
  ('social','linkedin','restrained owner-led'),
  ('diagram','internal','clear workflow'),
  ('logo','web','clean editable vector'),
]
def main() -> int:
    for artifact, channel, style in CASES:
        cp = subprocess.run([str(LOOKUP),'--registry',str(REGISTRY),'--artifact-type',artifact,'--channel',channel,'--style-goal',style,'--json'], check=True, text=True, stdout=subprocess.PIPE)
        d=json.loads(cp.stdout)
        assert d['patterns'], f'{artifact}: no patterns'
        assert d['recommended_production_lanes'], f'{artifact}: no lanes'
        assert d['combined_qa_gates'], f'{artifact}: no qa gates'
        assert all(r['boundary']=='golden-safe' for r in d['patterns']), f'{artifact}: non-golden record returned'
        if artifact == 'logo':
            assert 'VDR-006' in [r['id'] for r in d['patterns']], 'logo: editable SVG rule not primary'
        print(f'{artifact}: ok {[r["id"] for r in d["patterns"]]}')
    return 0
if __name__ == '__main__':
    raise SystemExit(main())
