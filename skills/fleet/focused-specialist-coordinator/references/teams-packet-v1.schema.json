{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "teams.packet/v1",
  "title": "Client Teams Work Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "packet_id", "tenant_id", "decision_id", "decision_version",
    "decision_fingerprint", "lane", "assigned_role", "execution_kind", "scope",
    "bounded_inputs", "allowed_actions", "prohibited_actions", "acceptance_criteria",
    "required_receipts", "idempotency_key", "retry_limit", "max_runtime_seconds",
    "rollback_handle", "status"
  ],
  "properties": {
    "schema": {"const": "teams.packet/v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_version": {"type": "integer", "minimum": 1},
    "decision_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lane": {"type": "string", "minLength": 1},
    "assigned_role": {"type": "string", "minLength": 1},
    "execution_kind": {"enum": ["worker", "deterministic"]},
    "scope": {"type": "string", "minLength": 1},
    "bounded_inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "allowed_actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "prohibited_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "required_receipts": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "idempotency_key": {"type": "string", "minLength": 1},
    "retry_limit": {"type": "integer", "minimum": 0, "maximum": 1},
    "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "rollback_handle": {"type": ["string", "null"]},
    "status": {"enum": ["queued", "running", "terminal", "superseded"]}
  }
}
